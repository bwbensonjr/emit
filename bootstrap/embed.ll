e with zero\0A;;; arguments, so `(current-output-port)` reads identically to the plain accessor\0A;;; the earlier design would have shipped.\0A;;;\0A;;; The two reserved handles (0 stdout, 1 stderr) need no runtime table slot, so\0A;;; these three cost one record each and no file descriptor.  The stdin port's text\0A;;; is pulled in on first read, never here (see %port-buf).\0A;;; These three are hand-written rather than `make-parameter` calls for two\0A;;; reasons.  First, their initial port must be built LAZILY (see %port-rtd above),\0A;;; so there is no value to hand `make-parameter` at load time.  Second,\0A;;; current-output-port has to reach the RUNTIME as well as Scheme: `(display x)`\0A;;; with no port compiles to a bare primcall whose destination is a runtime cell\0A;;; (rt_current_out in src/runtime/runtime.c), which is how a port-less display\0A;;; follows `with-output-to-file` while its emitted code stays byte-identical.\0A;;; Every set must push the new port's handle into that cell -- INCLUDING the\0A;;; restore leg, which arrives as the two-argument form `(p v #f)` that a\0A;;; make-parameter converter would never see.\0A;;;\0A;;; The protocol is make-parameter's exactly -- zero arguments reads, one or two\0A;;; set -- so `parameterize` drives these, and a call site cannot tell them from\0A;;; plain accessor procedures.\0A(define %stdout-port #f)\0A(define %stderr-port #f)\0A(define %stdin-port  #f)\0A\0A(define (current-output-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stdout-port)\0A            (begin (set! %stdout-port (%make-port 0 #f #f 0 #f #f))\0A                   (%set-current-output! 0)))\0A        %stdout-port)\0A      (let ((p (car args)))\0A        (set! %stdout-port p)\0A        (%set-current-output! (%record-ref p 0))\0A        (if #f #f))))\0A\0A(define (current-error-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stderr-port) (set! %stderr-port (%make-port 1 #f #f 0 #f #f)))\0A        %stderr-port)\0A      (begin (set! %stderr-port (car args)) (if #f #f))))\0A\0A;;; The stdin port's TEXT is pulled in on the first read, never here (see\0A;;; %port-buf) -- slurping at startup would block every program on a stdin nobody\0A;;; reads.\0A(define (current-input-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stdin-port) (set! %stdin-port (%make-port #f #t #f 0 #f #f)))\0A        %stdin-port)\0A      (begin (set! %stdin-port (car args)) (if #f #f))))\0A\0A;;; call-with-port: hand the port to PROC and close it on EVERY exit -- a normal\0A;;; return, an escape via a continuation, or a raise.  dynamic-wind is what makes\0A;;; the escaping cases work; a version that just closed after the call would leak\0A;;; the port exactly when it matters most.\0A(define (call-with-port p proc)\0A  (dynamic-wind\0A    (lambda () (if #f #f))\0A    (lambda () (proc p))\0A    (lambda () (close-port p))))\0A\0A;;; with-output-to-file / with-input-from-file: rebind the corresponding parameter\0A;;; for the dynamic extent of THUNK, then close the port and restore the parameter.\0A;;; Both ride dynamic-wind for the same reason call-with-port does.\0A(define (with-output-to-file path thunk)\0A  (let ((p (open-output-file path))\0A        (saved (current-output-port)))\0A    (dynamic-wind\0A      (lambda () (current-output-port p))\0A      thunk\0A      (lambda () (current-output-port saved #f) (close-port p)))))\0A\0A(define (with-input-from-file path thunk)\0A  (let ((p (open-input-file path))\0A        (saved (current-input-port)))\0A    (dynamic-wind\0A      (lambda () (current-input-port p))\0A      thunk\0A      (lambda () (current-input-port saved #f) (close-port p)))))\0A\0A(define (call-with-output-file path proc)\0A  (call-with-port (open-output-file path) proc))\0A(define (call-with-input-file path proc)\0A  (call-with-port (open-input-file path) proc))\0A\00"
