 (cons (rd-append-reverse acc (car r))\0A                                  (+ j2 1))]))))] ; past )\0A          [else (let ([r (rd-datum s n j st)])\0A                  (if (rd-fail? (cdr r))\0A                      r\0A                      (rd-list s n (cdr r) (cons (car r) acc) st open)))])]\0A      ;; NOT end of input: closing the list here fabricates a datum the source does not\0A      ;; contain, so a truncated file compiled as though complete (issue #66).\0A      [else (rd-fail (quote rd-unterminated-list) open)])))\0A\0A(define (rd-datum s n i st) ; i at a non-ws char -> (datum . next)\0A  (if (and (<= 0 i) (< i n))\0A      (let ([k (char->integer (string-ref s i))])\0A        (cond\0A          [(= k 40) (rd-list s n (+ i 1) (quote ()) st i)] ; (\0A          [(= k 91) (rd-list s n (+ i 1) (quote ()) st i)] ; [ (brackets = parens)\0A          [(= k 39) (rd-quote s n (+ i 1) st)]             ; '\0A          [(= k 96) (rd-quasi s n (+ i 1) st)]             ; `\0A          [(= k 44) (rd-unquote s n (+ i 1) st)]           ; ,\0A          [(= k 34) (rd-string s n (+ i 1) i)]             ; \22\0A          [(= k 35) (rd-hash s n (+ i 1) st)]              ; #\0A          ;; NOT given ci: R7RS 7.1.1 makes the characters between the bars the symbol's\0A          ;; name literally, so a bar-quoted identifier is never folded (issue #61).\0A          [(= k 124) (rd-bar s n (+ i 1) i)] ; |bar quoted identifier|\0A          [(or (= k 41) (= k 93)) (rd-fail (quote rd-unexpected)\0A                                           i)] ; a close with no open\0A          [else (rd-atom s n i st)]))\0A      ;; A sentinel travelling outward (an unterminated block comment upstream), or a\0A      ;; datum the input ended before -- `#;` with nothing after it, say.  Neither is\0A      ;; raised here (design D2); the entry point reports.\0A      (if (< i 0) (cons (quote rd-block-comment) i) (rd-fail (quote rd-eof) i))))\0A\0A;;; --- where the reader's reports become errors (design D2) -------------------\0A;;; The lexeme layer answers a sentinel because it cannot raise; here `error` is in\0A;;; scope, so here is where the sentinel is turned into a diagnostic.  The position it\0A;;; carries is what lets the message name both WHERE and, by re-reading the token at\0A;;; that position, WHAT.  (`read` in (scheme read) needs this too and cannot import a\0A;;; private name, so it keeps its own copy -- the arrangement %check-input-port already\0A;;; has, for the same reason: this is the reader code that raises.)\0A(define (rd-report s n r)\0A  (let ([why (car r)] [p (rd-fail-pos (cdr r))])\0A    (cond\0A      [(eq? why (quote rd-block-comment))\0A        (%read-error (quote read) \22unterminated block comment #| opened at index\22 p)]\0A      [(eq? why (quote rd-bar))\0A        (%read-error (quote read) \22unterminated |identifier| opened at index\22 p)]\0A      ;; ONE reason covers (, [, #( and #u8(: the source at p still says which delimiter it\0A      ;; was, so the message names the construct the author actually opened without four\0A      ;; reasons carrying identical handling.  Decoded INLINE rather than through a helper\0A      ;; because rd-report is duplicated into (scheme read) -- a helper would have to join\0A      ;; *reader-report-shared-with-read* (src/prelude-surface.scm) to travel with it.\0A      [(eq? why (quote rd-unterminated-list))\0A        (%read-error (quote read)\0A                     (string-append\0A                       \22unterminated \22\0A                       (let ([k (char->integer (string-ref s p))])\0A                         (cond\0A                           [(= k 91) \22list [\22]\0A                           [(and (= k 35)\0A                                 (< (+ p 1) n)\0A                                 (= (char->integer (string-ref s (+ p 1))) 117)) ; #u8(\0A                             \22bytevector #u8(\22]\0A                           [(= k 35) \22vector #(\22]\0A                           [else \22list (\22]))\0A                       \22 opened at index\22)\0A                     p)]\0A      [(eq? why (quote rd-unterminated-string))\0A        (%read-error (quote read) \22unterminated string \5C\22 opened at index\22 p)]\0A      ;; The name is NAMED.  This arm exists because the alternative -- answering the first\0A      ;; character of the name -- made #\5Calarm read as #\5Ca with nothing to notice (design D1).\0A      [(eq? why (quote rd-char-name))\0A        (%read-error (quote read) \22unknown character name\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-hash-token))\0A        (%read-error (quote read)\0A                     \22not a boolean; write #t, #true, #f or #false\22\0A                     (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-duplicate))\0A        (%read-error (quote read) \22duplicate datum label\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-unresolved))\0A        (%read-error (quote read)\0A                     \22datum label reference has no earlier definition\22\0A                     (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-self))\0A        (%read-error (quote read)\0A                     \22datum label cannot be defined as only its own reference\22\0A                     (rd-token-at s n p))]\0A      [(eq? why (quote rd-label))\0A        (%read-error (quote read) \22malformed datum label\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-eof))\0A        (%read-error (quote read)\0A                     \22end of input where a datum was expected, at index\22\0A                     p)]\0A      [(eq? why (quote rd-unexpected))\0A        (%read-error (quote read) \22no datum here, at index\22 p)]\0A      [(eq? why (quote rd-rational))\0A        (%read-error\0A          (quote read)\0A          (string-append \22rational literal syntax is not supported -- Emit has no \22\0A                         \22exact rationals; write 0.5, or (/ 1 2)\22)\0A          (rd-token-at s n p))]\0A      [else (%read-error (quote read) \22unrecognized syntax\22 (rd-token-at s n p))])))\0A\0A(define (read-from-string s)\0A  (let ([n (string-length s)] [st (rd-state #f)])\0A    (let ([r (rd-finish st (rd-datum s n (rd-skip-ws s n 0 st) st))])\0A      (if (rd-fail? (cdr r)) (rd-report s n r) (car r)))))\0A\0A;;; --- whole-program read (stdin-source-reader) -----------------------------\0A;;; Loop the single-datum reader across the whole source: skip inter-form\0A;;; whitespace/; comments, read a datum, continue from the next position, and\0A;;; stop at end of input.  Returns the top-level forms in source order (the empty\0A;;; list for empty or whitespace/comment-only input).  This is what a self-hosted\0A;;; core uses to turn its input text into the form list it compiles.\0A;;; TWO entry points over ONE worker, rather than one entry point with an optional\0A;;; argument (change: reader-token-path, design D1/D2).  P9 originally made an optional\0A;;; argument cost every call site its cross-unit direct call; change\0A;;; cross-unit-variadic-direct-calls removed that call-shape cost, but the variadic\0A;;; prologue would still build an empty rest list on every ordinary read.  This is the\0A;;; compiler's own hot path, so making it pay for the rare folding read is backwards.\0A;;; `-ci` is R7RS's spelling for case-insensitivity (string-ci=?, char-ci=?, and\0A;;; `include-ci`, which is what this exists for).\0A(define (read-all-from-string s) (rd-all s #f))\0A(define (read-all-from-string-ci s) (rd-all s #t))\0A\0A(define (rd-all s ci)\0A  (let ([n (string-length s)] [base (rd-state ci)])\0A    (let loop ([i (rd-skip-ws s n 0 base)] [acc (quote ())])\0A      (cond\0A        ;; NOT end of input: an unterminated block comment here used to make every form\0A        ;; after the opening delimiter vanish with no diagnostic (issue #59).\0A        [(rd-fail? i) (rd-report s n (cons (quote rd-block-comment) i))]\0A        [(< i n)\0A          (let* ([st (rd-state-child base)] [r (rd-finish st (rd-datum s n i st))])\0A            (if (rd-fail? (cdr r))\0A                (rd-report s n r)\0A                (loop (rd-skip-ws s n (cdr r) base) (cons (car r) acc))))]\0A        [else (reverse acc)]))))\0A\0A;;; --- ports (change: scheme-io-library, design D1/D2) -----------------------\0A;;; A port is a RECORD over the existing record layer, so `port?` is\0A;;; `%record-of-type?` and a port is an ordinary first-class value -- no new heap\0A;;; header code, no printer/GC/equality teaching (design D1).\0A;;;\0A;;; FIELD LAYOUT.  Field 0 is a CONTRACT SHARED WITH THE RUNTIME: the\0A;;; port-directed output primitives (%display-port and friends) are handed the\0A;;; port record and read slot 0 as their handle, so the two-argument output forms\0A;;; stay bare primcalls with no Scheme wrapper on the path.  If this layout moves,\0A;;; `port_arg_stream` in src/runtime/runtime.c moves with it.\0A;;;\0A;;;   0 handle    OUTPUT: fixnum handle into the runtime's FILE * table\0A;;;                       (0 = stdout, 1 = stderr, 2+ = opened by this program)\0A;;;               INPUT:  #f -- so a port-directed WRITE to an input port finds no\0A;;;                       fixnum in slot 0 and reports an error instead of writing\0A;;;   1 input?    #t input, #f output\0A;;;   2 buf       INPUT: the whole source text, slurped (D2); #f = not yet slurped\0A;;;               (the stdin port only -- see %port-buf), OUTPUT: #f\0A;;;   3 pos       INPUT: cursor, a byte index into buf; OUTPUT: unused\0A;;;   4 string?   #t for a string port (get-output-string is legal on it)\0A;;;   5 closed?   #t once closed\0A;;;   6 fold-cell INPUT: mutable one-element vector holding the persistent\0A;;;                       #!fold-case mode; OUTPUT: unused\0A;;; The port type descriptor is made ON FIRST USE, not at load time.  Two reasons,\0A;;; both load-bearing: this file is also `load`ed into the Chez bootstrap host by\0A;;; the reader unit tests, where a `%`-primitive is unbound until Emit compiles it\0A;;; -- so no top-level INITIALIZER here may call one (every other `%`-use in this\0A;;; file is likewise inside a procedure body) -- and a program that never mentions\0A;;; a port then runs no port initialization at all.\0A(define %port-rtd-cell #f)\0A(define (%port-rtd)\0A  (if %port-rtd-cell\0A      %port-rtd-cell\0A      (begin (set! %port-rtd-cell (%make-record-type \22port\22)) %port-rtd-cell)))\0A\0A(define (%make-port handle input? buf pos string? closed?)\0A  (%make-record (%port-rtd)\0A                (list handle input? buf pos string? closed? (list->vector (list #f)))))\0A\0A(define (port? p) (%record-of-type? p (%port-rtd)))\0A(define (input-port? p) (and (port? p) (%record-ref p 1)))\0A(define (output-port? p) (and (port? p) (not (%record-ref p 1))))\0A;;; Every port this implementation makes is textual; binary ports are out of scope\0A;;; (design non-goal), so textual-port? is port? until they exist.\0A(define (textual-port? p) (port? p))\0A(define (port-closed? p) (%record-ref p 5))\0A(define (input-port-open? p) (and (input-port? p) (not (%record-ref p 5))))\0A(define (output-port-open? p) (and (output-port? p) (not (%record-ref p 5))))\0A\0A;;; Guard every operation behind \22is this the right kind of live port?\22, so a\0A;;; wrong-type or use-after-close argument becomes a catchable R7RS error naming\0A;;; the operation rather than a wrong tag walk (spec: an operation on a closed port\0A;;; reports an error).\0A(define (%check-input-port p who)\0A  (if (not (input-port? p))\0A      (error who \22not an input port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A(define (%check-output-port p who)\0A  (if (not (output-port? p))\0A      (error who \22not an output port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A\0A;;; The source text of an input port, slurped on first use.  Every port EXCEPT the\0A;;; stdin one arrives with its text already in hand (open-input-file slurps at open,\0A;;; open-input-string is handed it).  current-input-port must NOT slurp when it is\0A;;; created -- that would block every program at startup on a stdin nobody reads --\0A;;; so it starts with #f here and pulls the stream in on the first actual read.\0A(define (%port-buf p)\0A  (let ((b (%record-ref p 2)))\0A    (if b b (let ((s (%read-all-stdin))) (%record-set! p 2 s) s))))\0A\0A;;; --- input ports ----------------------------------------------------------\0A;;; open-input-file SLURPS (design D2), which is precisely what makes a file port\0A;;; and a string port the same object: both are a string plus a cursor, so every\0A;;; input operation below is pure Scheme over data already in hand and `read` is\0A;;; the reader this file already defines. The cost -- a source larger than memory\0A;;; cannot be read, and input written after the open is not seen -- is documented\0A;;; in the spec and docs/PRIMITIVES.md, not just here.\0A(define (open-input-string s) (%make-port #f #t s 0 #t #f))\0A(define (open-input-file path)\0A  (let ((s (%read-file path)))\0A    (if s\0A        (%make-port #f #t s 0 #f #f)\0A        (%file-error 'open-input-file \22cannot open file for input\22 path))))\0A\0A(define (%port-at-eof? p) (>= (%record-ref p 3) (string-length (%port-buf p))))\0A\0A(define (read-char p)\0A  (%check-input-port p 'read-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let ((i (%record-ref p 3)))\0A        (%record-set! p 3 (+ i 1))\0A        (string-ref (%port-buf p) i))))\0A\0A(define (peek-char p)\0A  (%check-input-port p 'peek-char)\0A  (if (%port-at-eof? p) (eof-object) (string-ref (%port-buf p) (%record-ref p 3))))\0A\0A;;; read-line: up to but NOT including the next line feed, which is consumed; a\0A;;; final line with no terminator is returned as-is.\0A(define (read-line p)\0A  (%check-input-port p 'read-line)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p)) (n (string-length s)))\0A        (let loop ((i (%record-ref p 3