120) ; x\0A      (let ([len (string-length tok)])\0A        (let loop ([i 1] [acc 0])\0A          (if (< i len)\0A              (let ([c (string-ref tok i)])\0A                (if (rd-hex-digit? c)\0A                    (loop (+ i 1) (+ (* acc 16) (rd-hex-digit c)))\0A                    #f)) ; not hex: a name, not a codepoint\0A              acc)))\0A      #f))\0A\0A(define (rd-char s n i st) ; i at '\5C' of #\5C ; content at i+1\0A  (let* ([cs (+ i 1)]\0A         [end (rd-token-end s n (+ cs 1))] ; force the first content char in\0A         [tok (substring s cs end)])\0A    (if\0A      (= (string-length tok) 1)\0A      (cons (string-ref s cs) end) ; single-character literal\0A      (let* ([name (if (rd-fold? st) (rd-fold-token tok) tok)] [hx (rd-char-hex name)])\0A        (if hx\0A            (cons (integer->char hx) end) ; #\5CxHH\0A            ;; `(- i 1)` is the `#`, so the report names the whole `#\5Cname` token.\0A            (let ([c (rd-char-name name)])\0A              (if c\0A                  (cons c end) ; named character\0A                  (rd-fail (quote rd-char-name) (- i 1)))))))))\0A\0A;;; R7RS 7.1.1 bar-quoted identifier: | opens a name that runs to the matching |, with\0A;;; the \5C| and \5CxHH; escapes the standard gives it.  The result is an ORDINARY interned\0A;;; symbol -- R7RS says there is no distinct type, so (eq? '|foo| 'foo) is #t -- which\0A;;; makes this a new LEXEME, not a new value.  ( `|` is deliberately NOT added to\0A;;; rd-delim?: only a LEADING bar opens one, so a symbol like `a|b` still reads whole.)\0A(define (rd-bar s n i p) ; i just past the opening |, which was at p\0A  (let loop ([i i] [acc (quote ())])\0A    (if (< i n)\0A        (let ([c (string-ref s i)])\0A          (let ([k (char->integer c)])\0A            (cond\0A              [(= k 124) (cons (string->symbol (list->string (reverse acc))) (+ i 1))]\0A              [(and (= k 92) (< (+ i 1) n)) ; backslash escape\0A                (let ([e (string-ref s (+ i 1))])\0