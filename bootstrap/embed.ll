@.str.lit.1049 = private unnamed_addr constant [65587 x i8] c";;; prelude.scm -- standard library procedures prepended to every program.\0A;;;\0A;;; Pure Scheme over the core primitives + variadic lambda; the driver\0A;;; (src/compile.ss) prepends these top-level defines to each program, with\0A;;; user-wins shadowing (a user define of the same name drops the prelude's).\0A;;; See openspec prelude-mechanism.  memq/assq compare with eq?; member/assoc\0A;;; are their structural analogues over equal? (see openspec\0A;;; equality-and-list-library).  not/eq?/eqv?/equal? are primitives (see\0A;;; prim-table), so they are not defined here.\0A\0A;;; --- derived syntactic forms (syntax-rules macros) ------------------------\0A;;; cond/and/or/when/unless/let* are macros expanded by src/passes/expand.ss.\0A;;; Named `let` is still hand-written there (it overloads the core `let`\0A;;; keyword).  `t` in `or`/`cond` is a macro-introduced temporary and is renamed\0A;;; hygienically per expansion, so it cannot capture user identifiers.\0A\0A(define-syntax and\0A  (syntax-rules ()\0A    ((_) #t)\0A    ((_ e) e)\0A    ((_ e1 e2 ...) (if e1 (and e2 ...) #f))))\0A\0A(define-syntax or\0A  (syntax-rules ()\0A    ((_) #f)\0A    ((_ e) e)\0A    ((_ e1 e2 ...) (let ((t e1)) (if t t (or e2 ...))))))\0A\0A;; when/unless: the UNTAKEN branch is the unspecified value, not #f (change:\0A;; unspecified-value).  `when` gets it from the two-armed `if` -- the parser supplies the\0A;; missing alternative -- and `unless`, which needs the else arm for its body, spells it\0A;; with the `(if #f #f)` idiom.  (R7RS leaves the result unspecified even when the branch\0A;; IS taken; Emit returns the body value there, as most implementations do.)\0A;; `unless`'s nested `(if #f #f)` emits a dead branch diamond (+8 IR lines per use), the\0A;; same cost `case`/`do` already pay for the idiom.  It costs nothing in the binary:\0A;; `icmp ne i64 1, 1` is constant-folded, and clang -O2 collapses the whole diamond\0A;; (verified against the emitted IR), so the standalone-executable size goal is unaffected.\0A(define-syntax when\0A  (syntax-rules ()\0A    ((_ test e ...) (if test (begin e ...)))))\0A\0A(define-syntax unless\0A  (syntax-rules ()\0A    ((_ test e ...) (if test (if #f #f) (begin e ...)))))\0A\0A(define-syntax let*\0A  (syntax-rules ()\0A    ((_ () body ...) (begin body ...))\0A    ((_ ((x v) rest ...) body ...) (let ((x v)) (let* (rest ...) body ...)))))\0A\0A;; cond: falling off the end with no clause matched yields the unspecified value, not #f\0A;; (change: unspecified-value) -- matching `case`'s no-match rule below.\0A(define-syntax cond\0A  (syntax-rules (else =>)\0A    ((_) (if #f #f))\0A    ((_ (else e ...)) (begin e ...))\0A    ((_ (test => proc) rest ...) (let ((t test)) (if t (proc t) (cond rest ...))))\0A    ((_ (test) rest ...) (let ((t test)) (if t t (cond rest ...))))\0A    ((_ (test e ...) rest ...) (if test (begin e ...) (cond rest ...)))))\0A\0A;; `case`: evaluate KEY once, then run the first clause whose datum list contains\0A;; it (eqv?), else the `else` clause.  A parenthesized KEY is bound to a hygienic\0A;; temp `k` first (so it is not re-evaluated per clause); the recursive calls pass\0A;; the bound identifier, which no longer matches the compound-KEY rule.  Expands\0A;; to `cond` over `(memv k '(d ...))`.\0A(define-syntax case\0A  (syntax-rules (else)\0A    ((_ (key ...) clause ...) (let ((k (key ...))) (case k clause ...)))\0A    ((_ k) (if #f #f))\0A    ((_ k (else e ...)) (begin e ...))\0A    ((_ k ((d ...) e ...) clause ...)\0A     (if (memv k (quote (d ...))) (begin e ...) (case k clause ...)))))\0A\0A;; R7RS `do`: iterate with parallel-updated bindings.  Each binding is\0A;; (var init step) or (var init) [step defaults to var, i.e. unchanged].  On each\0A;; pass: if `test` holds, the result exprs run (unspecified value if none);\0A;; otherwise the commands run and every var is rebound to its step -- all steps\0A;; are evaluated before any rebind because they are the arguments of the loop\0A;; call.  %do-step supplies the default step.  (change: inexact-numbers)\0A(define-syntax %do-step\0A  (syntax-rules ()\0A    ((_ x) x)\0A    ((_ x s) s)))\0A(define-syntax do\0A  (syntax-rules ()\0A    ((_ ((var init step ...) ...)\0A        (test result ...)\0A        command ...)\0A     (letrec ((loop (lambda (var ...)\0A                      (if test\0A                          (begin (if #f #f) result ...)\0A                          (begin command ...\0A                                 (loop (%do-step var step ...) ...))))))\0A       (loop init ...)))))\0A\0A(define (list . xs) xs)\0A\0A;;; --- compositional car/cdr accessors (cxr combinators) --------------------\0A;;; caar..cddr and the depth-3 forms caaar..cdddr, each the named composition of\0A;;; the primitive car/cdr (letters read right-to-left = innermost-first).\0A(define (caar x) (car (car x)))\0A(define (cadr x) (car (cdr x)))\0A(define (cdar x) (cdr (car x)))\0A(define (cddr x) (cdr (cdr x)))\0A(define (caaar x) (car (caar x)))\0A(define (caadr x) (car (cadr x)))\0A(define (cadar x) (car (cdar x)))\0A(define (caddr x) (car (cddr x)))\0A(define (cdaar x) (cdr (caar x)))\0A(define (cdadr x) (cdr (cadr x)))\0A(define (cddar x) (cdr (cdar x)))\0A(define (cdddr x) (cdr (cddr x)))\0A\0A(define (length xs)\0A  (let loop ([xs xs] [n 0])\0A    (if (null? xs) n (loop (cdr xs) (+ n 1)))))\0A\0A(define (reverse xs)\0A  (let loop ([xs xs] [acc (quote ())])\0A    (if (null? xs) acc (loop (cdr xs) (cons (car xs) acc)))))\0A\0A;; append is variadic (R7RS): zero or more lists.  The compiler core uses 3-arg\0A;; append (e.g. emit-code-def's argdecls), and Chez's append is variadic, so\0A;; this must be too for the core to self-compile (fix-closure-self-compilation).\0A(define (%append2 a b)\0A  (if (null? a) b (cons (car a) (%append2 (cdr a) b))))\0A(define (append . lists)\0A  (if (null? lists)\0A      (quote ())\0A      (if (null? (cdr lists))\0A          (car lists)\0A          (%append2 (car lists) (apply append (cdr lists))))))\0A\0A;; map/for-each are variadic (R7RS): one or more lists, walked in lockstep,\0A;; stopping at the shortest.  The single-list case is the fast path; the\0A;; multi-list case (used pervasively by the compiler core -- e.g. rename's\0A;; (map cons names new) and emit's (for-each ... slots (iota k))) applies f to\0A;; the i-th element of every list.  Chez's map/for-each are variadic, so these\0A;; match and the core self-compiles (fix-closure-self-compilation).\0A(define (%map1 f xs)\0A  (if (null? xs) (quote ()) (cons (f (car xs)) (%map1 f (cdr xs)))))\0A(define (%any-null? ls)\0A  (if (null? ls) #f (if (null? (car ls)) #t (%any-null? (cdr ls)))))\0A(define (%mapn f ls)\0A  (if (%any-null? ls)\0A      (quote ())\0A      (cons (apply f (%map1 car ls)) (%mapn f (%map1 cdr ls)))))\0A(define (map f xs . more)\0A  (if (null? more) (%map1 f xs) (%mapn f (cons xs more))))\0A\0A(define (memq x xs)\0A  (if (null? xs) #f (if (eq? x (car xs)) xs (memq x (cdr xs)))))\0A\0A;; memv: like memq but compares with eqv? (used by the `case` macro).\0A(define (memv x xs)\0A  (if (null? xs) #f (if (eqv? x (car xs)) xs (memv x (cdr xs)))))\0A\0A(define (assq k xs)\0A  (if (null? xs) #f (if (eq? k (car (car xs))) (car xs) (assq k (cdr xs)))))\0A\0A;;; --- structural list library (equality-and-list-library) ------------------\0A;;; member/assoc mirror memq/assq but compare with equal? (structural).\0A(define (member x xs)\0A  (if (null? xs) #f (if (equal? x (car xs)) xs (member x (cdr xs)))))\0A\0A(define (assoc k xs)\0A  (if (null? xs) #f (if (equal? k (car (car xs))) (car xs) (assoc k (cdr xs)))))\0A\0A(define (filter p xs)\0A  (if (null? xs)\0A      (quote ())\0A      (if (p (car xs))\0A          (cons (car xs) (filter p (cdr xs)))\0A          (filter p (cdr xs)))))\0A\0A;; fold-left: tail-recursive, f receives (acc elem), left-to-right (R6RS order).\0A(define (fold-left f acc xs)\0A  (if (null? xs) acc (fold-left f (f acc (car xs)) (cdr xs))))\0A\0A;; fold-right: non-tail, f receives (elem acc), right-to-left (R6RS order).\0A(define (fold-right f acc xs)\0A  (if (null? xs) acc (f (car xs) (fold-right f acc (cdr xs)))))\0A\0A;;; --- additional list/utility procedures (self-host-gap-sweep G10) ----------\0A;;; The compiler core assumes these; all are pure Scheme over existing prims.\0A;;; (predicate-taking procs take the predicate first, per R6RS.)\0A\0A;; apply a procedure to each element for effect; returns the unspecified value.\0A(define (%for-each1 f xs)\0A  (if (null? xs) (if #f #f) (begin (f (car xs)) (%for-each1 f (cdr xs)))))\0A(define (%for-eachn f ls)\0A  (if (%any-null? ls)\0A      (if #f #f)\0A      (begin (apply f (%map1 car ls)) (%for-eachn f (%map1 cdr ls)))))\0A(define (for-each f xs . more)\0A  (if (null? more) (%for-each1 f xs) (%for-eachn f (cons xs more))))\0A\0A;; #t iff the predicate holds for every element (short-circuits on #f).\0A(define (andmap p xs)\0A  (if (null? xs) #t (if (p (car xs)) (andmap p (cdr xs)) #f)))\0A\0A;; first tail whose head satisfies the predicate, else #f.\0A(define (memp p xs)\0A  (if (null? xs) #f (if (p (car xs)) xs (memp p (cdr xs)))))\0A\0A;; fourth-element accessor (extends the cxr set one deeper).\0A(define (cadddr x) (car (cdddr x)))\0A\0A;; #t iff a proper list (walks to null; a dotted tail yields #f).\0A(define (list? x)\0A  (if (null? x) #t (if (pair? x) (list? (cdr x)) #f)))\0A\0A(define (zero? n) (= n 0))\0A\0A;; the sublist after n elements, the nth element, and the first n elements.\0A(define (list-tail xs n) (if (zero? n) xs (list-tail (cdr xs) (- n 1))))\0A(define (list-ref xs n) (car (list-tail xs n)))\0A(define (list-head xs n)\0A  (if (zero? n) (quote ()) (cons (car xs) (list-head (cdr xs) (- n 1)))))\0A\0A;; a list of n copies of x.\0A(define (make-list n x) (if (zero? n) (quote ()) (cons x (make-list (- n 1) x))))\0A\0A;; the list (0 1 ... n-1).\0A(define (iota n)\0A  (let loop ([i 0] [acc (quote ())])\0A    (if (= i n) (reverse acc) (loop (+ i 1) (cons i acc)))))\0A\0A;;; --- max / min (R7RS 6.2.6) -----------------------------------------------\0A;;; Variadic over one or more numbers (change: numeric-conformance, design D6 /\0A;;; GitHub issue #26 -- `max` used to be strictly binary and `min` did not exist).\0A;;;\0A;;; R7RS requires INEXACTNESS CONTAGION: if any argument is inexact the result is\0A;;; inexact, even when the argument that WON the comparison is exact.  That second\0A;;; half is the one a naive implementation gets wrong -- `(max 3.0 4)` is 4.0, not 4\0A;;; -- so the winner and the exactness are tracked separately: the fold carries a\0A;;; flag for \22some argument was inexact\22 and the conversion happens once, at the end.\0A;;; Comparison itself is by numeric value across the exactness boundary, which `<`\0A;;; already does.\0A;;; The flag is `inex`, NOT `inexact?`: naming it after the predicate would shadow\0A;;; the predicate this very fold calls, and the shadowed call would ask a boolean.\0A(define (%minmax-fold pick xs best inex)\0A  (if (null? xs)\0A      (if inex (exact->inexact best) best)\0A      (%minmax-fold pick (cdr xs) (pick best (car xs))\0A                    (if inex #t (inexact? (car xs))))))\0A(define (%minmax pick a rest)\0A  (%minmax-fold pick rest a (inexact? a)))\0A(define (max a . rest) (%minmax (lambda (x y) (if (< x y) y x)) a rest))\0A(define (min a . rest) (%minmax (lambda (x y) (if (< y x) y x)) a rest))\0A\0A;;; --- the R7RS 6.2 numeric inventory (change: numeric-conformance) -----------\0A;;; Emit's tower is two types -- a 61-bit exact integer and a double -- which R7RS\0A;;; 6.2.3 explicitly permits (\22an implementation in which exact numbers are always\0A;;; integer\22).  Everything below is Scheme over the existing primitives; only what\0A;;; genuinely needs C (the flonum arm of the rounding family, classification, libm)\0A;;; is a `%`-op, which is what kept the staged-bootstrap cost proportional.\0A;;;\0A;;; The 6.2.3 exact-for-exact guarantee is honored throughout: abs, ceiling, floor,\0A;;; gcd, lcm, max, min, round, square, truncate and the division family all return\0A;;; exact results for exact arguments.  A result that leaves the fixnum range traps\0A;;; through the existing overflow diagnostic -- (abs FIXNUM_MIN) among them, whose\0A;;; magnitude is one past the range -- inherited from `+ - *`, not re-implemented.\0A\0A;;; Type predicates apply to ANY object and answer #f for a non-number (R7RS 6.2.6),\0A;;; unlike the arithmetic predicates below them, which require a number.\0A(define (complex? n) (number? n))\0A(define (exact-integer? n) (if (exact? n) (integer? n) #f))\0A;;; `rational?` is the finite reals: every exact integer, and a flonum that is\0A;;; neither an infinity nor a NaN.  %finite? is the runtime's isfinite, so there is\0A;;; one definition of finiteness shared with (scheme inexact)'s `finite?`.\0A(define (rational? n) (if (number? n) (%finite? n) #f))\0A\0A;;; Sign and parity require a number; `<` and `remainder` supply the trap, and\0A;;; remainder's integrality guard is what makes (odd? 7.5) an error rather than an\0A;;; answer.\0A(define (positive? n) (< 0 n))\0A(define (negative? n) (< n 0))\0A(define (even? n) (= 0 (remainder n 2)))\0A(define (odd? n) (if (= 0 (remainder n 2)) #f #t))\0A\0A(define (abs n) (if (< n 0) (- 0 n) n))\0A(define (square n) (* n n))\0A\0A;;; gcd/lcm: variadic, non-negative, exact for exact.  Identities are 0 and 1, so\0A;;; the no-argument cases fall out of the fold rather than being special-cased.\0A(define (%gcd2 a b) (if (= b 0) a (%gcd2 b (remainder a b))))\0A(define (%gcd-fold ns acc)\0A  (if (null? ns) acc (%gcd-fold (cdr ns) (%gcd2 (abs (car ns)) (abs acc)))))\0A(define (%lcm-fold ns acc)\0A  (if (null? ns)\0A      acc\0A      (let ([a (abs (car ns))])\0A        (if (= a 0) 0 (%lcm-fold (cdr ns) (quotient (* acc a) (%gcd2 acc a)))))))\0A(define (gcd . ns) (%gcd-fold ns 0))\0A(define (lcm . ns) (%lcm-fold ns 1))\0A\0A;;; expt.  An exact base with a non-negative exact integer exponent stays EXACT, by\0A;;; repeated squaring -- so (expt 2 60) is exact and (expt 2 61) traps on overflow\0A;;; rather than silently going inexact.  A negative exponent has no exact value\0A;;; here (no rationals), so it returns the inexact one, which is the same 6.2.3\0A;;; licence `/` already uses for a non-integral exact quotient.  Any inexact\0A;;; operand routes to %pow (libm).  (expt 0 0) is 1, per 6.2.6.\0A(define (%expt-exact b e acc)\0A  (if (= e 0)\0A      acc\0A      (%expt-exact (* b b) (quotient e 2) (if (odd? e) (* acc b) acc))))\0A(define (expt b e)\0A  (if (exact? e)\0A      (if (< e 0)\0A          (%pow b e)\0A          (if (exact? b) (%expt-exact b e 1) (%expt-exact b e 1.0)))\0A      (%pow b e)))\0A\0A;;; exact-integer-sqrt: Newton's method on exact integers, returning TWO values --\0A;;; the root and the remainder -- through the same `values` the rest of the library\0A;;; uses.  Stays exact end to end, which is the point of it existing alongside\0A;;; (scheme inexact)'s `sqrt`.\0A(define (%isqrt-loop n g)\0A  (let ([g2 (quotient (+ g (quotient n g)) 2)])\0A    (if (< g2 g) (%isqrt-loop n g2) g)))\0A(define (%isqrt n) (if (= n 0) 0 (%isqrt-loop n n)))\0A(define (exact-integer-sqrt n)\0A  (let ([s (%isqrt n)]) (values s (- n (* s s)))))\0A\0A;;; Rounding.  An exact integer is already rounded, so it is returned UNCHANGED --\0A;;; which is both the R7RS exactness rule and the reason a large-magnitude flonum\0A;;; never routes through the fixnum range: the inexact arm stays in double.\0A;;; `round` is round-half-to-EVEN (%flo-round is rint), so 2.5 -> 2.0 and 3.5 -> 4.0.\0A(define (floor n)    (if (exact? n) n (%flo-floor n)))\0A(define (ceiling n)  (if (exact? n) n (%flo-ceiling n)))\0A(define (truncate n) (if (exact? n) n (%flo-truncate n)))\0A(define (round n)    (if (exact? n) n (%flo-round n)))\0A\0A;;; The R7RS 6.2.6 division operators, over the truncating and flooring primitives\0A;;; that already exist -- so all six inherit their argument-domain rules (an\0A;;; integral flonum is accepted with contagion, anything else non-integer traps)\0A;;; and their division-by-zero trap, with no second implementation to keep in step.\0A;;; floor-quotient is derived rather than branched on signs: subtracting the\0A;;; flooring remainder makes the division exact, so the truncating quotient of the\0A;;; difference IS the flooring quotient.\0A(define (truncate-quotient n d) (quotient n d))\0A(define (truncate-remainder n d) (remainder n d))\0A(define (floor-remainder n d) (modulo n d))\0A(define (floor-quotient n d) (quotient (- n (modulo n d)) d))\0A(define (truncate/ n d) (values (quotient n d) (remainder n d)))\0A(define (floor/ n d) (values (floor-quotient n d) (modulo n d)))\0A\0A;;; numerator/denominator, restricted to integer-VALUED arguments: n/1 for an exact\0A;;; integer and n/1.0 for an integral flonum.  R7RS defines them over rationals,\0A;;; which Emit does not represent, and 6.2.3 sanctions restricting the domain -- a\0A;;; best-effort rational reconstruction of a double would be misleading, not useful.\0A(define (numerator n)\0A  (if (integer? n) n (error \22numerator: not an integer\22 n)))\0A(define (denominator n)\0A  (if (integer? n) (if (exact? n) 1 1.0) (error \22denominator: not an integer\22 n)))\0A\0A;;; The R7RS spellings of the exactness conversions.  The R5RS names remain, so\0A;;; both are available and neither is deprecated here.\0A(define (inexact n) (exact->inexact n))\0A(define (exact n) (inexact->exact n))\0A\0A;; THE unspecified value -- one distinguished immediate, distinct from #f and '() and\0A;; truthy (change: unspecified-value).  `(if #f #f)` is the two-armed form, so the parser\0A;; supplies the missing alternative as `(primcall %unspec)`; this needs no special case.\0A;; The GENERATOR is exposed so a program can declare \22no interesting result\22; there is\0A;; deliberately no `unspecified?` predicate to test for it (R7RS-WG1 ballot #49).  What\0A;; Emit returns here is not a promise -- portable programs must not rely on it.\0A(define (void) (if #f #f))\0A\0A;; construct a string from character arguments (via the list->string primitive).\0A(define (string . cs) (list->string cs))\0A\0A;;; --- string-append over a list (self-host-gap-sweep G8) --------------------\0A;;; Compiler support for `string-append` in value position: the parser eta-expands\0A;;; a bare `string-append` to `(lambda gs (%str-concat gs))`, so `(apply\0A;;; string-append xs)` works for any arity.  Written in the common subset -- each\0A;;; `(string-append a b)` here is 2-arg, i.e. native under Chez and the binary\0A;;; primcall under Emit -- so the prelude still loads and runs under Chez.\0A(define (%str-concat xs)\0A  (if (null? xs) \22\22 (string-append (car xs) (%str-concat (cdr xs)))))\0A\0A;;; --- character / string library (string-char-library) ---------------------\0A;;; char comparisons are n-ary and chained, reducing through char->integer and\0A;;; the numeric comparisons.  `op` is a lambda wrapper (primitives are not\0A;;; first-class, so we cannot pass = / < directly); chr-cmp recurses over the\0A;;; user-defined comparison chain.\0A(define (chr-cmp op a b rest)\0A  (if (op (char->integer a) (char->integer b))\0A      (if (null? rest) #t (chr-cmp op b (car rest) (cdr rest)))\0A      #f))\0A(define (char=?  a b . rest) (chr-cmp (lambda (x y) (=  x y)) a b rest))\0A(define (char<?  a b . rest) (chr-cmp (lambda (x y) (<  x y)) a b rest))\0A(define (char>?  a b . rest) (chr-cmp (lambda (x y) (>  x y)) a b rest))\0A(define (char<=? a b . rest) (chr-cmp (lambda (x y) (<= x y)) a b rest))\0A(define (char>=? a b . rest) (chr-cmp (lambda (x y) (>= x y)) a b rest))\0A\0A;; string->list: codepoint-indexed, built from the end so the list is in order.\0A(define (string->list s)\0A  (let loop ([i (- (string-length s) 1)] [acc (quote ())])\0A    (if (< i 0) acc (loop (- i 1) (cons (string-ref s i) acc)))))\0A\0A;;; --- number->string (base-10 signed integers) -----------------------------\0A;;; Inverse of the reader's integer parsing (rd-parse-int), so it round-trips.\0A;;; Digits are peeled from the NON-POSITIVE magnitude of n via quotient/remainder\0A;;; by 10: for m <= 0, (remainder m 10) is in -9..0 so (- 0 (remainder m 10)) is\0A;;; the 0..9 digit, and (quotient m 10) truncates toward zero.  Working on the\0A;;; negative side (never negating the whole value) means the full fixnum range is\0A;;; handled exactly, INCLUDING the most-negative fixnum -- whose magnitude has no\0A;;; positive fixnum representation, so a negate-first approach would overflow.\0A(define (ns-digits m acc)                ; m <= 0 -> chars of |m|, prepended to acc\0A  (ns-digits-radix m 10 acc))\0A;;; The same peel, in any supported radix (change: numeric-conformance).  Digits\0A;;; above 9 are lowercase, which is what the reader's rd-hex-digit accepts, so the\0A;;; radix forms round-trip too.\0A(define (%ns-digit-char d)\0A  (if (< d 10) (integer->char (+ 48 d)) (integer->char (+ 87 d))))   ; 87 + 10 = #\5Ca\0A(define (ns-digits-radix m r acc)        ; m <= 0 -> chars of |m| in radix r\0A  (let ([ch (%ns-digit-char (- 0 (remainder m r)))]\0A        [rest (quotient m r)])\0A    (if (= rest 0)\0A        (cons ch acc)\0A        (ns-digits-radix rest r (cons ch acc)))))\0A;;; Flonums route to the runtime formatter (%flonum->string: shortest round-\0A;;; trippable decimal, always with a '.').  `exact?` gates it -- exact? is true\0A;;; only for fixnums, so the integer path is unchanged; the flonum branch is\0A;;; never reached with a fixnum (and so is dead during the bootstrap regen, where\0A;;; %flonum->string is not yet a known primcall).  (change: inexact-numbers)\0A;;; The optional radix argument (change: numeric-conformance) takes 2, 8, 10, or 16\0A;;; for an exact integer.  An inexact number requires radix 10: R7RS 6.2.6 permits\0A;;; an error for the other radices, which is better than inventing a rendering the\0A;;; reader could not read back.\0A(define (%radix-ok? r)\0A  (if (= r 10) #t (if (= r 16) #t (if (= r 8) #t (= r 2)))))\0A(define (number->string n . rest)\0A  (let ([r (if (null? rest) 10 (car rest))])\0A    (if (%radix-ok? r)\0A        (if (exact? n)\0A            (cond\0A              [(= n 0) \220\22]\0A              [(< n 0) (list->string (cons #\5C- (ns-digits-radix n r (quote ()))))]\0A              [else    (list->string (ns-digits-radix (- 0 n) r (quote ())))])\0A            (if (= r 10)\0A                (%flonum->string n)\0A                (error \22number->string: radix must be 10 for an inexact number\22 r)))\0A        (error \22number->string: unsupported radix\22 r))))\0A\0A;;; string->number: the INVERSE, and deliberately built from the reader's own\0A;;; classifiers (rd-numeric?/rd-flonum?/rd-parse-int) rather than a second numeric\0A;;; grammar that could drift from the one the reader accepts.  Returns #f -- not an\0A;;; error -- for text that is not a number, per R7RS 6.2.6.  When the radix\0A;;; prefixes (#x/#b/#o/#e/#i) land in the reader, this inherits them for free.\0A(define (%digit-in-radix c r)            ; digit value, or #f if not a digit in r\0A  (let ([v (let ([k (char->integer c)])\0A             (cond\0A               [(and (< 47 k) (< k 58)) (- k 48)]      ; 0-9\0A               [(and (< 96 k) (< k 123)) (- k 87)]     ; a-z\0A               [(and (< 64 k) (< k 91)) (- k 55)]      ; A-Z\0A               [else 99]))])\0A    (if (< v r) v #f)))\0A(define (%radix-digits s i m r acc)      ; accumulate DOWNWARD (see rd-digits-neg)\0A  (if (< i m)\0A      (let ([d (%digit-in-radix (string-ref s i) r)])\0A        (if d (%radix-digits s (+ i 1) m r (- (* acc r) d)) #f))\0A      acc))\0A(define (%string->int s r)               ; signed integer in radix r, or #f\0A  (let ([m (string-length s)])\0A    (if (= m 0)\0A        #f\0A        (let ([c0 (char->integer (string-ref s 0))])\0A          (if (= c0 45)                                  ; leading '-'\0A              (if (< 1 m) (%radix-digits s 1 m r 0) #f)\0A              (let ([start (if (= c0 43) 1 0)])           ; optional leading '+'\0A                (if (< start m)\0A                    (let ([neg (%radix-digits s start m r 0)])\0A                      (if neg (- 0 neg) #f))\0A                    #f)))))))\0A(define (string->number s . rest)\0A  (let ([r (if (null? rest) 10 (car rest))])\0A    (if (%radix-ok? r)\0A        (if (= r 10)\0A            ;; radix 10 goes through the reader's own classifiers, so anything the\0A            ;; reader calls a number is a number here, with the same value.\0A            (cond\0A              [(rd-numeric? s) (rd-parse-int s)]\0A              [(rd-nonfinite s)]              ; +inf.0 / -inf.0 / +nan.0, as the reader does\0A              [(rd-flonum? s) (%string->flonum s)]\0A              [else #f])\0A            (%string->int s r))\0A        (error \22string->number: unsupported radix\22 r))))\0A\0A;;; --- exceptions: error objects, raise, guard (r7rs-exceptions-subset) ------\0A;;; R7RS `(error message irritant ...)` builds a CATCHABLE error object and raises\0A;;; it.  As a compatible superset we also accept a leading SYMBOL `who` (the\0A;;; compiler's internal call style, and how this prelude is written so it stays\0A;;; valid under the Chez bootstrap too), folding \22who: message\22 into the message.\0A;;; Uncaught, an error renders and aborts as before (REPL host survives; a\0A;;; standalone executable exits non-zero).  %error-abort builds the error object\0A;;; in the runtime (rt_error) and raises it through the guard escape stack.\0A(define (error a . rest)\0A  (if (string? a)\0A      (raise (%make-error-object a rest))            ; R7RS: (error message irritant ...)\0A      (raise (%make-error-object\0A               (string-append (symbol->string a) (string-append \22: \22 (car rest)))\0A               (cdr rest)))))                         ; superset: (error who message ...)\0A\0A;;; --- dynamic extent: winds, escape continuations, handlers (dynamic-extent) --\0A;;; Rung 3 of the call/cc staircase (openspec/explorations/continuations-and-control.md).\0A;;; THREE structures, each with one job (design D4):\0A;;;   escape frames  -- in the runtime; setjmp targets, each with a generation id\0A;;;   *winds*        -- here; active dynamic-wind (before . after) pairs, innermost first\0A;;;   *handlers*     -- here; the R7RS current-exception-handler chain\0A;;; `raise` CALLS the current handler (it does not transfer); `guard` is a handler\0A;;; that escapes.  So there is one transfer mechanism, not two.\0A(define *winds* (quote ()))\0A(define *handlers* (quote ()))\0A\0A;;; Pop entries off the wind list until it is the captured TARGET, running each\0A;;; `after`.  The entry is popped BEFORE its `after` runs, so a raise or escape from\0A;;; inside an `after` cannot re-enter it and unwinding cannot loop; the new transfer\0A;;; then unwinds the rest on its own way out.\0A(define (%unwind-to target)\0A  (if (eq? *winds* target)\0A      #t\0A      (if (null? *winds*)\0A          #t                                  ; target is not on this chain\0A          (let ((entry (car *winds*)))\0A            (set! *winds* (cdr *winds*))\0A            ((cdr entry))\0A            (%unwind-to target)))))\0A\0A;;; dynamic-wind: before, body, after -- with `after` on EVERY exit.  The normal\0A;;; path pops and runs it here; an escape or a raise runs it through %unwind-to.\0A(define (dynamic-wind before thunk after)\0A  (before)\0A  (set! *winds* (cons (cons before after) *winds*))\0A  (let ((r (thunk)))\0A    (set! *winds* (cdr *winds*))\0A    (after)\0A    r))\0A\0A;;; call/cc, restricted to ESCAPE continuations (design D1).  %run-guarded pushes a\0A;;; runtime escape frame and runs the thunk; %escape-frame reads that frame's id\0A;;; (innermost = ours, since nothing has been pushed since); %escape-to delivers a\0A;;; value to it.  %escape-to returns #f ONLY when no live frame carries the id --\0A;;; the capturing call has returned -- which is a diagnostic, not a jump into a dead\0A;;; frame.  Re-entrant continuations are rung 4 and are not supported.\0A(define (call-with-current-continuation f)\0A  (let ((saved-winds *winds*))\0A    (cdr (%run-guarded\0A          (lambda ()\0A            (let ((id (%escape-frame)))\0A              (f (lambda (v)\0A                   ;; Liveness FIRST.  Unwinding to a dead continuation's depth would\0A                   ;; run the `after` thunks -- including the one that pops the very\0A                   ;; handler meant to report this error -- for a transfer that cannot\0A                   ;; happen.  When live, %escape-to does not return.\0A                   (if (%escape-live? id)\0A                       (begin (%unwind-to saved-winds) (%escape-to id v))\0A                       #f)\0A                   (error 'call/cc\0A                          \22continuation invoked outside its extent\22)))))))))\0A\0A(define (call/cc f) (call-with-current-continuation f))\0A\0A;;; Install HANDLER for the dynamic extent of THUNK.  The push/pop rides\0A;;; dynamic-wind, so an escape out of the thunk restores the chain for free.\0A;;; (Rung 2 exposes this as `with-exception-handler`; it needs no new machinery.)\0A(define (%with-handler handler thunk)\0A  (let ((saved *handlers*))\0A    (dynamic-wind\0A      (lambda () (set! *handlers* (cons handler saved)))\0A      thunk\0A      (lambda () (set! *handlers* saved)))))\0A\0A;;; raise any object: call the current handler with the chain popped to the outer\0A;;; one, per R7RS.  A handler for `raise` must not return -- `guard`'s escapes -- so\0A;;; a normal return falls through to the unhandled path.  With no handler at all,\0A;;; %raise renders and aborts exactly as before.\0A(define (raise obj)\0A  (if (null? *handlers*)\0A      (%raise obj)\0A      (let ((h (car *handlers*)) (saved *handlers*))\0A        (set! *handlers* (cdr *handlers*))\0A        (h obj)\0A        (set! *handlers* saved)\0A        (%raise obj))))\0A\0A;;; R7RS error-object accessors over the runtime error-object representation.\0A(define (error-object? x) (%error-object? x))\0A(define (error-object-message x) (%error-object-message x))\0A(define (error-object-irritants x) (%error-object-irritants x))\0A\0A;;; guard: evaluate BODY; if it raises, bind the object to VAR and run the clauses\0A;;; as a `cond` in the guard's continuation.  No matching clause (and no else)\0A;;; re-raises outward.  This is R7RS's own shape (change: dynamic-extent, design\0A;;; D4): `guard` is not a mechanism of its own -- it installs a HANDLER that escapes\0A;;; to the guard's continuation, so the intervening dynamic-wind `after` thunks run\0A;;; on the ordinary escape path.\0A;;;\0A;;; DEVIATION (recorded): R7RS reraises a non-matching guard \22within the dynamic\0A;;; environment of the original call to raise\22.  That needs re-entering a\0A;;; continuation whose extent has ended (rung 4); here the reraise happens in the\0A;;; GUARD's dynamic environment, so `after` thunks between the raise point and the\0A;;; guard have already run and do not run again.\0A(define-syntax guard\0A  (syntax-rules ()\0A    ((_ (var clause ...) body ...)\0A     (let ((%gres\0A            (call-with-current-continuation\0A              (lambda (%gk)\0A                (%with-handler\0A                  (lambda (%gobj) (%gk (cons #t %gobj)))\0A                  (lambda () (cons #f (begin body ...))))))))\0A       (if (car %gres)\0A           (let ((var (cdr %gres))) (%guard-clauses var clause ...))\0A           (cdr %gres))))))\0A\0A(define-syntax %guard-clauses\0A  (syntax-rules (else =>)\0A    ((_ v) (raise v))                                              ; no clause matched\0A    ((_ v (else e ...)) (begin e ...))\0A    ((_ v (test => proc) rest ...) (let ((gt test)) (if gt (proc gt) (%guard-clauses v rest ...))))\0A    ((_ v (test) rest ...) (let ((gt test)) (if gt gt (%guard-clauses v rest ...))))\0A    ((_ v (test e ...) rest ...) (if test (begin e ...) (%guard-clauses v rest ...)))))\0A\0A;;; --- parameter objects (change: dynamic-extent, design D3) -----------------\0A;;; A parameter is a closure over a one-slot cell.  R7RS specifies the object as\0A;;; callable with ZERO arguments returning its value, which is what makes it\0A;;; substitutable for a plain accessor procedure at any call site.  The one- and\0A;;; two-argument forms are internal to `parameterize`: one argument converts and\0A;;; sets (a new binding), two restore a previously converted value unconverted.\0A(define (make-parameter init . conv)\0A  (let ((convert (if (null? conv) (lambda (x) x) (car conv)))\0A        (cell (%make-vector 1 0)))\0A    (%vector-set! cell 0 ((if (null? conv) (lambda (x) x) (car conv)) init))\0A    (lambda args\0A      (if (null? args)\0A          (%vector-ref cell 0)\0A          (if (null? (cdr args))\0A              (%vector-set! cell 0 (convert (car args)))\0A              (%vector-set! cell 0 (car args)))))))\0A\0A;;; parameterize rides dynamic-wind, so restoration on a normal exit, on an escape,\0A;;; and on a raise all come from one place (design D3).\0A(define (%with-parameters params vals thunk)\0A  (let ((olds (map (lambda (p) (p)) params)))\0A    (dynamic-wind\0A      (lambda () (for-each (lambda (p v) (p v)) params vals))\0A      thunk\0A      (lambda () (for-each (lambda (p v) (p v #f)) params olds)))))\0A\0A(define-syntax parameterize\0A  (syntax-rules ()\0A    ((_ ((p v) ...) body ...)\0A     (%with-parameters (list p ...) (list v ...) (lambda () body ...)))))\0A\0A;;; --- vector constructors (vectors change) ---------------------------------\0A;;; make-vector/vector-ref/vector-set!/vector-length/vector? are primitives;\0A;;; the variadic constructor and list conversion are prelude Scheme over them.\0A(define (list->vector xs)\0A  (let ([v (make-vector (length xs) 0)])\0A    (let loop ([xs xs] [i 0])\0A      (if (null? xs)\0A          v\0A          (begin (vector-set! v i (car xs)) (loop (cdr xs) (+ i 1)))))))\0A(define (vector . xs) (list->vector xs))\0A\0A(define (list->bytevector bs)\0A  (let ([bv (make-bytevector (length bs) 0)])\0A    (let loop ([bs bs] [i 0])\0A      (if (null? bs)\0A          bv\0A          (begin (bytevector-u8-set! bv i (car bs)) (loop (cdr bs) (+ i 1)))))))\0A(define (bytevector . bs) (list->bytevector bs))\0A\0A;; --- multiple values (openspec multiple-values): values / call-with-values ---\0A;; A distinguished bundle carries 0 or >=2 values; exactly one value is returned\0A;; as itself (identity), so ordinary single-value code is untouched.  The bundle\0A;; is a disjoint HDR_MV wrapper (%list->mv) that only call-with-values consumes,\0A;; spreading it into the consumer via the existing `apply` -- so `(map ...)` and\0A;; `(apply consumer ...)` both work with no calling-convention change.\0A(define (values . vs)\0A  (if (and (pair? vs) (null? (cdr vs)))\0A      (car vs)                 ; exactly one value -> identity\0A      (%list->mv vs)))         ; zero or >=2 values -> a bundle carrying the list\0A(define (call-with-values producer consumer)\0A  (let ([r (producer)])\0A    (if (%mv? r)\0A        (apply consumer (%mv->list r))\0A        (consumer r))))\0A\0A;; --- hash tables (openspec hash-tables): SRFI-69 subset, equal?-keyed --------\0A;; Built on vectors + the %hash primitive.  A table is an opaque HDR_HASHTABLE\0A;; wrapper (%make-hash-table) around a mutable spine vector #(count buckets _);\0A;; `buckets` is a vector of association lists ((key . val) ...).  Pairs are\0A;; immutable here, so an existing key is updated by rebuilding its bucket alist\0A;; (drop the old entry, prepend the new one).  The table grows (rehashes into\0A;; ~2x buckets) once count/nbuckets exceeds the load factor, keeping lookup\0A;; amortized O(1).  %hash need only be CONSISTENT with equal? (the bucket scan\0A;; below is the source of truth), so collisions are merely slow, never wrong.\0A(define %ht-initial-buckets 8)\0A(define %ht-load-factor 3)\0A\0A(define (make-hash-table)\0A  (%make-hash-table (vector 0 (make-vector %ht-initial-buckets (quote ())) #f)))\0A(define (hash-table? x) (%hash-table? x))\0A\0A(define (%ht-count ht)        (vector-ref (%hash-table-spine ht) 0))\0A(define (%ht-buckets ht)      (vector-ref (%hash-table-spine ht) 1))\0A(define (%ht-set-count! ht n) (vector-set! (%hash-table-spine ht) 0 n))\0A(define (%ht-set-buckets! ht b) (vector-set! (%hash-table-spine ht) 1 b))\0A\0A;; %hash is non-negative and nbuckets positive, so remainder == modulo here.\0A(define (%ht-index key nbuckets) (remainder (%hash key) nbuckets))\0A\0A;; the (key . val) pair for an equal? key in an alist, or #f\0A(define (%ht-assoc key al)\0A  (if (null? al) #f\0A      (if (equal? key (car (car al))) (car al) (%ht-assoc key (cdr al)))))\0A;; the alist with the (first) equal? key removed\0A(define (%ht-remove key al)\0A  (if (null? al) (quote ())\0A      (if (equal? key (car (car al)))\0A          (cdr al)\0A          (cons (car al) (%ht-remove key (cdr al))))))\0A\0A(define (hash-table-ref/default ht key default)\0A  (let* ((bs (%ht-buckets ht))\0A         (p (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs))))))\0A    (if p (cdr p) default)))\0A\0A(define (hash-table-contains? ht key)\0A  (let ((bs (%ht-buckets ht)))\0A    (if (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs)))) #t #f)))\0A\0A(define (hash-table-ref ht key)\0A  (let* ((bs (%ht-buckets ht))\0A         (p (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs))))))\0A    (if p (cdr p) (error \22hash-table-ref: key not found\22 key))))\0A\0A(define (hash-table-set! ht key val)\0A  (let* ((bs (%ht-buckets ht))\0A         (n (vector-length bs))\0A         (i (%ht-index key n))\0A         (al (vector-ref bs i))\0A         (existed (%ht-assoc key al)))\0A    (vector-set! bs i (cons (cons key val) (if existed (%ht-remove key al) al)))\0A    (if existed\0A        #f\0A        (begin\0A          (%ht-set-count! ht (+ (%ht-count ht) 1))\0A          (if (> (%ht-count ht) (* %ht-load-factor n)) (%ht-grow! ht) #f)))))\0A\0A(define (hash-table-delete! ht key)\0A  (let* ((bs (%ht-buckets ht))\0A         (i (%ht-index key (vector-length bs)))\0A         (al (vector-ref bs i)))\0A    (if (%ht-assoc key al)\0A        (begin (vector-set! bs i (%ht-remove key al))\0A               (%ht-set-count! ht (- (%ht-count ht) 1)))\0A        #f)))\0A\0A;; reinsert every entry into a ~2x bucket vector, recomputing each index\0A(define (%ht-grow! ht)\0A  (let* ((old (%ht-buckets ht))\0A         (newn (* 2 (vector-length old)))\0A         (newb (make-vector newn (quote ()))))\0A    (let loop ((i 0))\0A      (if (< i (vector-length old))\0A          (begin\0A            (let bloop ((al (vector-ref old i)))\0A              (if (null? al) #f\0A                  (let* ((kv (car al)) (j (%ht-index (car kv) newn)))\0A                    (vector-set! newb j (cons kv (vector-ref newb j)))\0A                    (bloop (cdr al)))))\0A            (loop (+ i 1)))\0A          #f))\0A    (%ht-set-buckets! ht newb)))\0A\0A(define (hash-table-size ht) (%ht-count ht))\0A\0A(define (%ht-fold-buckets al acc)\0A  (if (null? al) acc\0A      (cons (cons (car (car al)) (cdr (car al))) (%ht-fold-buckets (cdr al) acc))))\0A(define (hash-table->alist ht)\0A  (let ((bs (%ht-buckets ht)))\0A    (let loop ((i 0) (acc (quote ())))\0A      (if (< i (vector-length bs))\0A          (loop (+ i 1) (%ht-fold-buckets (vector-ref bs i) acc))\0A          acc))))\0A(define (hash-table-keys ht) (map car (hash-table->alist ht)))\0A(define (hash-table-values ht) (map cdr (hash-table->alist ht)))\0A\0A;;; --- reader (scheme-reader): read-from-string source text -> datum --------\0A;;; Recursive descent over a string; the scan position is threaded functionally\0A;;; as (datum . next-index) pairs.  Characters are classified by codepoint\0A;;; (char->integer) because char literals are not interned (so eq? on them does\0A;;; not hold).  v1 reads integers, symbols, lists, #t/#f, #\5Cchar, \22strings\22\0A;;; (no escapes), 'quote and `/,/,@ quasiquote sugar, skipping whitespace and\0A;;; ; line comments.\0A\0A(define (rd-ws? c)                       ; space, tab, newline, return\0A  (let ([k (char->integer c)])\0A    (or (= k 32) (or (= k 9) (or (= k 10) (= k 13))))))\0A(define (rd-digit? c)\0A  (let ([k (char->integer c)]) (and (< 47 k) (< k 58))))   ; '0'..'9'\0A(define (rd-delim? c)                    ; ends a token: ws or ( ) [ ] \22 ;\0A  (let ([k (char->integer c)])\0A    (or (rd-ws? c)\0A        (or (= k 40) (or (= k 41) (or (= k 91) (or (= k 93)\0A        (or (= k 34) (= k 59)))))))))\0A\0A(define (rd-skip-line s n i)             ; index just past the next newline (or n)\0A  (if (< i n)\0A      (if (= (char->integer (string-ref s i)) 10) (+ i 1) (rd-skip-line s n (+ i 1)))\0A      i))\0A(define (rd-skip-ws s n i)               ; next index that is not ws or a comment\0A  (if (< i n)\0A      (let ([c (string-ref s i)])\0A        (cond\0A          [(rd-ws? c) (rd-skip-ws s n (+ i 1))]\0A          [(= (char->integer c) 59) (rd-skip-ws s n (rd-skip-line s n (+ i 1)))]\0A          [else i]))\0A      i))\0A\0A(define (rd-token-end s n i)             ; first delimiter index >= i (or n)\0A  (if (< i n)\0A      (if (rd-delim? (string-ref s i)) i (rd-token-end s n (+ i 1)))\0A      i))\0A\0A(define (rd-all-digits? tok a m)\0A  (if (< a m) (if (rd-digit? (string-ref tok a)) (rd-all-digits? tok (+ a 1) m) #f) #t))\0A(define (rd-numeric? tok)                ; optional +/- then >=1 digits\0A  (let ([m (string-length tok)])\0A    (and (< 0 m)\0A         (let ([c0 (char->integer (string-ref tok 0))])\0A           (cond\0A             [(rd-digit? (string-ref tok 0)) (rd-all-digits? tok 0 m)]\0A             [(or (= c0 45) (= c0 43)) (and (< 1 m) (rd-all-digits? tok 1 m))]\0A             [else #f])))))\0A(define (rd-digits tok a m acc)\0A  (if (< a m)\0A      (rd-digits tok (+ a 1) m (+ (* acc 10) (- (char->integer (string-ref tok a)) 48)))\0A      acc))\0A;;; A negative literal accumulates DOWNWARD rather than being built positive and\0A;;; negated (change: fixnum-overflow-trap).  The fixnum range is asymmetric --\0A;;; -2^60 is representable but +2^60 is not -- so the old (- 0 (rd-digits ...))\0A;;; formed an out-of-range positive for the most negative fixnum and got the right\0A;;; answer only because it wrapped twice.  Now that overflow traps, that literal\0A;;; would be unreadable.  Accumulating negatively never leaves the range for any\0A;;; in-range literal, and an out-of-range one still traps in the same `*`/`-` the\0A;;; positive side traps in.  `ns-digits` (number->string) and `fixnum-word`\0A;;; (src/emit.ss) already avoid negating for exactly this reason.\0A(define (rd-digits-neg tok a m acc)\0A  (if (< a m)\0A      (rd-digits-neg tok (+ a 1) m (- (* acc 10) (- (char->integer (string-ref tok a)) 48)))\0A      acc))\0A(define (rd-parse-int tok)\0A  (let ([m (string-length tok)] [c0 (char->integer (string-ref tok 0))])\0A    (cond\0A      [(= c0 45) (rd-digits-neg tok 1 m 0)]\0A      [(= c0 43) (rd-digits tok 1 m 0)]\0A      [else (rd-digits tok 0 m 0)])))\0A\0A;;; --- inexact real (flonum) literal recognition (change: inexact-numbers) ----\0A;;; A flonum token is  [sign] ( digits [. digits] | . digits ) [exp]  with at\0A;;; least one digit AND at least one of a dot or an exponent (a pure-digit token\0A;;; is an integer, matched by rd-numeric?).  exp = (e|E) [sign] >=1 digits.  This\0A;;; only CLASSIFIES the token; the value parse is the runtime strtod (correctly\0A;;; rounded, so it round-trips with the flonum printer) via %string->flonum.\0A(define (rd-dotchar? c) (= (char->integer c) 46))                         ; the char .\0A(define (rd-exp-char? c) (let ([k (char->integer c)]) (or (= k 101) (= k 69))))  ; e E\0A(define (rd-sign-char? c) (let ([k (char->integer c)]) (or (= k 43) (= k 45))))  ; + -\0A(define (rd-scan-digits tok a m)         ; index just past a run of >=0 digits\0A  (if (and (< a m) (rd-digit? (string-ref tok a))) (rd-scan-digits tok (+ a 1) m) a))\0A(define (rd-flonum? tok)\0A  (let ([m (string-length tok)])\0A    (and (< 0 m)\0A      (let ([i0 (if (rd-sign-char? (string-ref tok 0)) 1 0)])\0A        (let ([i1 (rd-scan-digits tok i0 m)])            ; past integer digits\0A          (let ([i2 (if (and (< i1 m) (rd-dotchar? (string-ref tok i1))) (+ i1 1) i1)])\0A            (let ([had-dot (< i1 i2)])\0A              (let ([i3 (rd-scan-digits tok i2 m)])       ; past fraction digits\0A                (and (or (< i0 i1) (< i2 i3))             ; at least one digit\0A                     (let ([i4 (if (and (< i3 m) (rd-exp-char? (string-ref tok i3)))\0A                                   (let ([i5 (if (and (< (+ i3 1) m)\0A                                                      (rd-sign-char? (string-ref tok (+ i3 1))))\0A                                                 (+ i3 2) (+ i3 1))])\0A                                     (let ([i6 (rd-scan-digits tok i5 m)])\0A                                       (if (< i5 i6) i6 -1)))   ; exponent needs >=1 digit\0A                                   i3)])\0A                       (and (< -1 i4)                     ; valid (or no) exponent\0A                            (= i4 m)                      ; consumed the whole token\0A                            (or had-dot (< i3 i4)))))))))))))   ; a dot OR an exponent\0A\0A;;; The three non-finite tokens (change: numeric-conformance, design D8 / GitHub\0A;;; issue #25).  The PRINTER has always emitted these -- (/ 1.0 0.0) prints as\0A;;; +inf.0 -- but rd-flonum? requires at least one digit, so they fell through to\0A;;; string->symbol and a program could not read back its own output: write/read\0A;;; silently turned a number into an identifier.  They are exact literal strings, so\0A;;; recognizing them costs one comparison ahead of the classifier.  %string->flonum\0A;;; is strtod, which reads \22inf\22/\22nan\22 (and stops before the \22.0\22), so the VALUES\0A;;; come from the same converter as every other inexact literal rather than from\0A;;; arithmetic like (/ 1.0 0.0) that would depend on the host's division.\0A(define (rd-nonfinite tok)               ; the value, or #f if not one of the three\0A  (cond [(string=? tok \22+inf.0\22) (%string->flonum \22inf\22)]\0A        [(string=? tok \22-inf.0\22) (%string->flonum \22-inf\22)]\0A        [(string=? tok \22+nan.0\22) (%string->flonum \22nan\22)]\0A        [else #f]))\0A\0A(define (rd-atom s n i)                  ; token -> integer, flonum, or interned symbol\0A  (let ([j (rd-token-end s n i)])\0A    (let ([tok (substring s i j)])\0A      (cons (cond [(rd-numeric? tok) (rd-parse-int tok)]\0A                  [(rd-nonfinite tok)]              ; cond's test-only form: the value\0A                  [(rd-flonum? tok) (%string->flonum tok)]\0A                  [else (string->symbol tok)])\0A            j))))\0A\0A(define (rd-hex-digit c)                 ; hex char -> value (0 for non-hex)\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(and (< 47 k) (< k 58)) (- k 48)]      ; 0-9\0A      [(and (< 96 k) (< k 103)) (- k 87)]     ; a-f\0A      [(and (< 64 k) (< k 71)) (- k 55)]      ; A-F\0A      [else 0])))\0A(define (rd-hex s n i acc)               ; \5CxHH...; -> (codepoint . index-past-;)\0A  (if (< i n)\0A      (if (= (char->integer (string-ref s i)) 59)     ; ;\0A          (cons acc (+ i 1))\0A          (rd-hex s n (+ i 1) (+ (* acc 16) (rd-hex-digit (string-ref s i)))))\0A      (cons acc i)))\0A(define (rd-str-esc c)                   ; escape letter -> the character it denotes\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(= k 110) (integer->char 10)]     ; \5Cn\0A      [(= k 116) (integer->char 9)]      ; \5Ct\0A      [(= k 114) (integer->char 13)]     ; \5Cr\0A      [else c])))                        ; \5C\5C \5C\22 and any other: the char itself\0A(define (rd-string s n i)                ; i just past opening \22; decodes escapes\0A  (let loop ([i i] [acc (quote ())])\0A    (if (< i n)\0A        (let* ([c (string-ref s i)] [k (char->integer c)])\0A          (cond\0A            [(= k 34) (cons (list->string (reverse acc)) (+ i 1))]        ; closing \22\0A            [(= k 92)                                                     ; backslash escape\0A             (let ([e (string-ref s (+ i 1))])\0A               (if (= (char->integer e) 120)                             ; \5CxHH;\0A                   (let ([hx (rd-hex s n (+ i 2) 0)])\0A                     (loop (cdr hx) (cons (integer->char (car hx)) acc)))\0A                   (loop (+ i 2) (cons (rd-str-esc e) acc))))]            ; \5Cn \5Ct \5Cr \5C\5C \5C\22\0A            [else (loop (+ i 1) (cons c acc))]))\0A        (cons (list->string (reverse acc)) i))))\0A\0A(define (rd-hash s n i)                  ; i just past #\0A  (let ([k (char->integer (string-ref s i))])\0A    (cond\0A      [(= k 116) (cons #t (+ i 1))]                        ; #t\0A      [(= k 102) (cons #f (+ i 1))]                        ; #f\0A      [(= k 92) (rd-char s n i)]                           ; #\5C<char> or #\5C<name>\0A      [(= k 40) (let ([r (rd-list s n (+ i 1) (quote ()))])  ; #( ... ) -> vector\0A                  (cons (list->vector (car r)) (cdr r)))]\0A      [(and (= k 117)                                        ; #u8( ... ) -> bytevector\0A            (< (+ i 2) n)\0A            (= (char->integer (string-ref s (+ i 1))) 56)    ; 8\0A            (= (char->integer (string-ref s (+ i 2))) 40))   ; (\0A       (let ([r (rd-list s n (+ i 3) (quote ()))])\0A         (cons (list->bytevector (car r)) (cdr r)))]\0A      [else (let ([j (rd-token-end s n i)])\0A              (cons (string->symbol (substring s i j)) j))])))\0A\0A(define (rd-char-name tok)               ; multi-char #\5C name -> character\0A  (cond\0A    [(string=? tok \22space\22)   (integer->char 32)]\0A    [(string=? tok \22newline\22) (integer->char 10)]\0A    [(string=? tok \22tab\22)     (integer->char 9)]\0A    [(string=? tok \22return\22)  (integer->char 13)]\0A    [(string=? tok \22nul\22)     (integer->char 0)]\0A    [(string=? tok \22null\22)    (integer->char 0)]\0A    [(string=? tok \22delete\22)  (integer->char 127)]\0A    [(string=? tok \22altmode\22) (integer->char 27)]\0A    [(string=? tok \22esc\22)     (integer->char 27)]\0A    [else (string-ref tok 0)]))          ; unknown name: first char (undefined per spec)\0A(define (rd-char s n i)                  ; i at '\5C' of #\5C ; content at i+1\0A  (let* ([cs (+ i 1)]\0A         [end (rd-token-end s n (+ cs 1))]   ; force the first content char in\0A         [tok (substring s cs end)])\0A    (if (= (string-length tok) 1)\0A        (cons (string-ref s cs) end)         ; single-character literal\0A        (cons (rd-char-name tok) end))))     ; named character\0A\0A(define (rd-quote s n i)                 ; 'x -> (quote x)\0A  (let ([j (rd-skip-ws s n i)])\0A    (let ([r (rd-datum s n j)])\0A      (cons (list (quote quote) (car r)) (cdr r)))))\0A\0A(define (rd-quasi s n i)                 ; `x -> (quasiquote x)\0A  (let ([j (rd-skip-ws s n i)])\0A    (let ([r (rd-datum s n j)])\0A      (cons (list (quote quasiquote) (car r)) (cdr r)))))\0A\0A(define (rd-unquote s n i)               ; ,x -> (unquote x); ,@x -> (unquote-splicing x)\0A  (if (and (< i n) (= (char->integer (string-ref s i)) 64))     ; @  -> splicing\0A      (let ([j (rd-skip-ws s n (+ i 1))])\0A        (let ([r (rd-datum s n j)])\0A          (cons (list (quote unquote-splicing) (car r)) (cdr r))))\0A      (let ([j (rd-skip-ws s n i)])\0A        (let ([r (rd-datum s n j)])\0A          (cons (list (quote unquote) (car r)) (cdr r))))))\0A\0A(define (rd-dot? s n j)                  ; a standalone `.` token at j (dotted-pair marker)\0A  (and (= (char->integer (string-ref s j)) 46)      ; .\0A       (= (rd-token-end s n (+ j 1)) (+ j 1))))      ; next char is a delimiter -> lone .\0A(define (rd-append-reverse acc tail)     ; (reverse acc) terminated by tail (improper list)\0A  (if (null? acc) tail (rd-append-reverse (cdr acc) (cons (car acc) tail))))\0A(define (rd-list s n i acc)              ; i after (; read until ) (supports . tail)\0A  (let ([j (rd-skip-ws s n i)])\0A    (if (< j n)\0A        (cond\0A          [(let ([c (char->integer (string-ref s j))]) (or (= c 41) (= c 93)))\0A           (cons (reverse acc) (+ j 1))]                                           ; ) or ]\0A          [(rd-dot? s n j)                                                          ; . tail\0A           (let* ([r (rd-datum s n (rd-skip-ws s n (+ j 1)))]\0A                  [j2 (rd-skip-ws s n (cdr r))])\0A             (cons (rd-append-reverse acc (car r)) (+ j2 1)))]                      ; past )\0A          [else (let ([r (rd-datum s n j)])\0A                  (rd-list s n (cdr r) (cons (car r) acc)))])\0A        (cons (reverse acc) j))))\0A\0A(define (rd-datum s n i)                 ; i at a non-ws char -> (datum . next)\0A  (let ([k (char->integer (string-ref s i))])\0A    (cond\0A      [(= k 40) (rd-list s n (+ i 1) (quote ()))]          ; (\0A      [(= k 91) (rd-list s n (+ i 1) (quote ()))]          ; [ (brackets = parens)\0A      [(= k 39) (rd-quote s n (+ i 1))]                    ; '\0A      [(= k 96) (rd-quasi s n (+ i 1))]                    ; `\0A      [(= k 44) (rd-unquote s n (+ i 1))]                  ; ,\0A      [(= k 34) (rd-string s n (+ i 1))]                   ; \22\0A      [(= k 35) (rd-hash s n (+ i 1))]                     ; #\0A      [else (rd-atom s n i)])))\0A\0A(define (read-from-string s)\0A  (let ([n (string-length s)])\0A    (car (rd-datum s n (rd-skip-ws s n 0)))))\0A\0A;;; --- whole-program read (stdin-source-reader) -----------------------------\0A;;; Loop the single-datum reader across the whole source: skip inter-form\0A;;; whitespace/; comments, read a datum, continue from the next position, and\0A;;; stop at end of input.  Returns the top-level forms in source order (the empty\0A;;; list for empty or whitespace/comment-only input).  This is what a self-hosted\0A;;; core uses to turn its input text into the form list it compiles.\0A(define (read-all-from-string s)\0A  (let ([n (string-length s)])\0A    (let loop ([i (rd-skip-ws s n 0)] [acc (quote ())])\0A      (if (< i n)\0A          (let ([r (rd-datum s n i)])\0A            (loop (rd-skip-ws s n (cdr r)) (cons (car r) acc)))\0A          (reverse acc)))))\0A\0A;;; --- ports (change: scheme-io-library, design D1/D2) -----------------------\0A;;; A port is a RECORD over the existing record layer, so `port?` is\0A;;; `%record-of-type?` and a port is an ordinary first-class value -- no new heap\0A;;; header code, no printer/GC/equality teaching (design D1).\0A;;;\0A;;; FIELD LAYOUT.  Field 0 is a CONTRACT SHARED WITH THE RUNTIME: the\0A;;; port-directed output primitives (%display-port and friends) are handed the\0A;;; port record and read slot 0 as their handle, so the two-argument output forms\0A;;; stay bare primcalls with no Scheme wrapper on the path.  If this layout moves,\0A;;; `port_arg_stream` in src/runtime/runtime.c moves with it.\0A;;;\0A;;;   0 handle    OUTPUT: fixnum handle into the runtime's FILE * table\0A;;;                       (0 = stdout, 1 = stderr, 2+ = opened by this program)\0A;;;               INPUT:  #f -- so a port-directed WRITE to an input port finds no\0A;;;                       fixnum in slot 0 and reports an error instead of writing\0A;;;   1 input?    #t input, #f output\0A;;;   2 buf       INPUT: the whole source text, slurped (D2); #f = not yet slurped\0A;;;               (the stdin port only -- see %port-buf), OUTPUT: #f\0A;;;   3 pos       INPUT: cursor, a byte index into buf; OUTPUT: unused\0A;;;   4 string?   #t for a string port (get-output-string is legal on it)\0A;;;   5 closed?   #t once closed\0A;;; The port type descriptor is made ON FIRST USE, not at load time.  Two reasons,\0A;;; both load-bearing: this file is also `load`ed into the Chez bootstrap host by\0A;;; the reader unit tests, where a `%`-primitive is unbound until Emit compiles it\0A;;; -- so no top-level INITIALIZER here may call one (every other `%`-use in this\0A;;; file is likewise inside a procedure body) -- and a program that never mentions\0A;;; a port then runs no port initialization at all.\0A(define %port-rtd-cell #f)\0A(define (%port-rtd)\0A  (if %port-rtd-cell\0A      %port-rtd-cell\0A      (begin (set! %port-rtd-cell (%make-record-type \22port\22))\0A             %port-rtd-cell)))\0A\0A(define (%make-port handle input? buf pos string? closed?)\0A  (%make-record (%port-rtd) (list handle input? buf pos string? closed?)))\0A\0A(define (port? p) (%record-of-type? p (%port-rtd)))\0A(define (input-port? p) (and (port? p) (%record-ref p 1)))\0A(define (output-port? p) (and (port? p) (not (%record-ref p 1))))\0A;;; Every port this implementation makes is textual; binary ports are out of scope\0A;;; (design non-goal), so textual-port? is port? until they exist.\0A(define (textual-port? p) (port? p))\0A(define (port-closed? p) (%record-ref p 5))\0A(define (input-port-open? p) (and (input-port? p) (not (%record-ref p 5))))\0A(define (output-port-open? p) (and (output-port? p) (not (%record-ref p 5))))\0A\0A;;; Guard every operation behind \22is this the right kind of live port?\22, so a\0A;;; wrong-type or use-after-close argument becomes a catchable R7RS error naming\0A;;; the operation rather than a wrong tag walk (spec: an operation on a closed port\0A;;; reports an error).\0A(define (%check-input-port p who)\0A  (if (not (input-port? p))\0A      (error who \22not an input port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A(define (%check-output-port p who)\0A  (if (not (output-port? p))\0A      (error who \22not an output port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A\0A;;; The source text of an input port, slurped on first use.  Every port EXCEPT the\0A;;; stdin one arrives with its text already in hand (open-input-file slurps at open,\0A;;; open-input-string is handed it).  current-input-port must NOT slurp when it is\0A;;; created -- that would block every program at startup on a stdin nobody reads --\0A;;; so it starts with #f here and pulls the stream in on the first actual read.\0A(define (%port-buf p)\0A  (let ((b (%record-ref p 2)))\0A    (if b\0A        b\0A        (let ((s (%read-all-stdin)))\0A          (%record-set! p 2 s)\0A          s))))\0A\0A;;; --- input ports ----------------------------------------------------------\0A;;; open-input-file SLURPS (design D2), which is precisely what makes a file port\0A;;; and a string port the same object: both are a string plus a cursor, so every\0A;;; input operation below is pure Scheme over data already in hand and `read` is\0A;;; the reader this file already defines. The cost -- a source larger than memory\0A;;; cannot be read, and input written after the open is not seen -- is documented\0A;;; in the spec and docs/PRIMITIVES.md, not just here.\0A(define (open-input-string s) (%make-port #f #t s 0 #t #f))\0A(define (open-input-file path)\0A  (let ((s (%read-file path)))\0A    (if s\0A        (%make-port #f #t s 0 #f #f)\0A        (error 'open-input-file \22cannot open file for input\22 path))))\0A\0A(define (%port-at-eof? p) (>= (%record-ref p 3) (string-length (%port-buf p))))\0A\0A(define (read-char p)\0A  (%check-input-port p 'read-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let ((i (%record-ref p 3)))\0A        (%record-set! p 3 (+ i 1))\0A        (string-ref (%port-buf p) i))))\0A\0A(define (peek-char p)\0A  (%check-input-port p 'peek-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (string-ref (%port-buf p) (%record-ref p 3))))\0A\0A;;; read-line: up to but NOT including the next line feed, which is consumed; a\0A;;; final line with no terminator is returned as-is.\0A(define (read-line p)\0A  (%check-input-port p 'read-line)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s)))\0A        (let loop ((i (%record-ref p 3)))\0A          (if (>= i n)\0A              (let ((start (%record-ref p 3)))          ; unterminated final line\0A                (%record-set! p 3 n)\0A                (substring s start n))\0A              (if (char=? (string-ref s i) #\5Cnewline)\0A                  (let ((start (%record-ref p 3)))\0A                    (%record-set! p 3 (+ i 1))          ; consume the line feed\0A                    (substring s start i))\0A                  (loop (+ i 1))))))))\0A\0A;;; read-string: up to k characters, short ONLY at end of input.\0A(define (read-string k p)\0A  (%check-input-port p 'read-string)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s))\0A             (start (%record-ref p 3))\0A             (end (if (> (+ start k) n) n (+ start k))))\0A        (%record-set! p 3 end)\0A        (substring s start end))))\0A\0A;;; read: ONE datum at the cursor, leaving the port positioned after it.  This is\0A;;; a cursor discipline over the reader that already exists, NOT a second reader --\0A;;; rd-datum returns (datum . next-index), which is exactly one `read` step, and\0A;;; rd-skip-ws is what makes leading whitespace and ; comments disappear.  Sharing\0A;;; one reader means a user-visible `read` and the compiler's own front end accept\0A;;; the same external representations by construction.\0A(define (read p)\0A  (%check-input-port p 'read)\0A  (let* ((s (%port-buf p))\0A         (n (string-length s))\0A         (i (rd-skip-ws s n (%record-ref p 3))))\0A    (if (>= i n)\0A        (begin (%record-set! p 3 n) (eof-object))\0A        (let ((r (rd-datum s n i)))\0A          (%record-set! p 3 (cdr r))\0A          (car r)))))\0A\0A;;; --- output ports ---------------------------------------------------------\0A;;; An output port stream