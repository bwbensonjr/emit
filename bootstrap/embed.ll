c-wind for the same reason call-with-port does.\0A(define (with-output-to-file path thunk)\0A  (let ((p (open-output-file path))\0A        (saved (current-output-port)))\0A    (dynamic-wind\0A      (lambda () (current-output-port p))\0A      thunk\0A      (lambda () (current-output-port saved #f) (close-port p)))))\0A\0A(define (with-input-from-file path thunk)\0A  (let ((p (open-input-file path))\0A        (saved (current-input-port)))\0A    (dynamic-wind\0A      (lambda () (current-input-port p))\0A      thunk\0A      (lambda () (current-input-port saved #f) (close-port p)))))\0A\0A(define (call-with-output-file path proc)\0A  (call-with-port (open-output-file path) proc))\0A(define (call-with-input-file path proc)\0A  (call-with-port (open-input-file path) proc))\0A\0A;;; --- the file operations that are not port constructors (change:\0A;;; catchable-errors-with-kinds, design D8).  R7RS puts both in (scheme file), and they\0A;;; ship together because delete-file's only interesting failure is the one\0A;;; file-exists? answers.\0A;;;\0A;;; file-exists? NEVER raises: the absence of the file IS its answer, so a missing path\0A;;; is #f and not a condition.  delete-file is the other way round -- it raises a FILE\0A;;; error when it cannot remove the path, which is what lets a program tell it from an\0A;;; unrelated failure caught by the same `guard`.\0A(define (file-exists? path) (%file-exists? path))\0A(define (delete-file path)\0A  (if (%delete-file path)\0A      (if #f #f)\0A      (%file-error 'delete-file \22cannot delete file\22 path)))\0A\00"
