urce ending in a dangling backslash\0A             ;; used to read s[n] -- past the end of the input, and silently, because\0A             ;; indexed access is unchecked (issue #70).  A dangling \5CxHH needs no arm of\0A             ;; its own: rd-hex stops at n, so the loop re-enters and ends below.\0A             (if (<= n (+ i 1))\0A                 (rd-fail (quote rd-unterminated-string) open)\0A                 (let ([e (string-ref s (+ i 1))]\0A                       ;; Tested BEFORE \5CxHH; and before the escape table: a backslash that\0A                       ;; begins a continuation is not naming a character at all, so it must\0A                       ;; not reach rd-str-esc (which would answer the whitespace itself).\0A                       [cont (rd-line-continuation s n (+ i 1))])\0A                   (cond\0A                     [cont (loop cont acc)]                              ; contributes nothing\0A                     [(= (char->integer e) 120)                          ; \5CxHH;\0A                      (let ([hx (rd-hex s n (+ i 2) 0)])\0A                        (loop (cdr hx) (cons (integer->char (car hx)) acc)))]\0A                     [else (loop (+ i 2) (cons (rd-str-esc e) acc))])))] ; \5Ca \5Cb \5Cn \5Ct \5Cr \5C\5C \5C\22\0A            [else (loop (+ i 1) (cons c acc))]))\0A        ;; NOT end of input: closing the string here fabricates a datum the source does not\0A        ;; contain, so a truncated file compiled as though complete (issue #66).\0A        (rd-fail (quote rd-unterminated-string) open))))\0A\0A;;; Datum labels.  Each entry is (number . #(state value)); `state` is pending\0A;;; while the labelled datum is being parsed and done afterward.  A reference to\0A;;; a pending entry becomes a private placeholder which the outermost read fixes\0A;;; through mutable pair/vector edges once the whole graph exists.\0A(define (rd-label-find st label)\0A  (let loop ([xs (vector-ref st 1)])\0A    (if (null? xs)\0A        #f\0A        (if (= label (car (car xs))) (car xs) (loop (cdr xs))))))\0A(define (rd-label-add! st label)\0A  (let ([entry (cons label (list->vector (list (quote pending) #f)))])\0A    (vector-set! st 1 (cons entry (vector-ref st 1)))\0A    entry))\0A(define (rd-placeholder st entry)\0A  (list->vector (list (vector-ref st 2) entry)))\0A(define (rd-placeholder? st x)\0A  (and (vector? x)\0A       (= (vector-length x) 2)\0A       (eq? (vector-ref x 0) (vector-ref st 2))))\0A(define (rd-placeholder-entry x) (vector-ref x 1))\0A(define (rd-seen? x seen)\0A  (if (null? seen)\0A      #f\0A      (if (eq? x (car seen)) #t (rd-seen? x (cdr seen)))))\0A(define (rd-label-scan s n i)\0A  (if (and (< i n) (rd-digit? (string-ref s i)))\0A      (rd-label-scan s n (+ i 1))\0A      i))\0A\0A(define (rd-resolve st x seen)\0A  (cond\0A    [(rd-placeholder? st x)\0A     (let ([cell (cdr (rd-placeholder-entry x))])\0A       (rd-resolve st (vector-ref cell 1) seen))]\0A    [(pair? x)\0A     (if (rd-seen? x seen)\0A         x\0A         (let ([next (cons x seen)])\0A           (set-car! x (rd-resolve st (car x) next))\0A           (set-cdr! x (rd-resolve st (cdr x) next))\0A           x))]\0A    [(vector? x)\0A     (if (rd-seen? x seen)\0A         x\0A         (let ([next (cons x seen)] [m (vector-length x)])\0A           (let loop ([i 0])\0A             (if (< i m)\0A                 (begin\0A                   (vector-set! x i (rd-resolve st (vector-ref x i) next))\0A                   (loop (+ i 1)))\0A                 x))))]\0A    [else x]))\0A\0A(define (rd-finish st r)\0A  (if (rd-fail? (cdr r)) r (cons (rd-resolve st (car r) (quote ())) (cdr r))))\0A\0A(define (rd-label s n i st)              ; i at first digit after #\0A  (let ([j (rd-label-scan s n i)])\0A    (if (>= j n)\0A        (rd-fail (quote rd-label) (- i 1))\0A        (let* ([label (rd-digits s i j 0)]\0A               [kind (char->integer (string-ref s j))]\0A               [old (rd-label-find st label)])\0A          (cond\0A            [(=