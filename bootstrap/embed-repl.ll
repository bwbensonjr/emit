fine (rd-fold-token tok)\0A  (let ([m (string-length tok)])\0A    (let loop ([i 0] [acc (quote ())])\0A      (if (= i m)\0A          (list->string (reverse acc))\0A          (loop (+ i 1) (cons (rd-fold-char (string-ref tok i)) acc))))))\0A\0A(define (rd-atom s n i st) ; token -> number, interned symbol, or a report\0A  (let ([j (rd-token-end s n i)])\0A    (if (= i j)\0A        ;; An EMPTY token: the character here is a delimiter no datum arm claimed.  It\0A        ;; used to intern the empty symbol and return i unchanged, which spun rd-list\0A        ;; forever; reporting it is what makes `#;` before a closing paren terminate.\0A        (rd-fail (quote rd-unexpected) i)\0A        (let ([tok (substring s i j)])\0A          (let ([v (rd-number tok 10)])\0A            (cond\0A              [(eq? v (quote rd-not-a-number))\0A                (cons (string->symbol (if (rd-fold? st) (rd-fold-token tok) tok)) j)]\0A              [(rd-number-reason? v) (rd-fail v i)]\0A              [else (cons v j)]))))))\0A\0A;;; The token a sentinel position points at, so a report can name what it read.\0A(define (rd-token-at s n p)\0A  (if (and (<= 0 p) (< p n)) (substring s p (rd-token-end s n (+ p 1))) \22\22))\0A\0A(define (rd-hex-digit c) ; hex char -> value (0 for non-hex)\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(and (< 47 k) (< k 58)) (- k 48)]  ; 0-9\0A      [(and (< 96 k) (< k 103)) (- k 87)] ; a-f\0A      [(and (< 64 k) (< k 71)) (- k 55)]  ; A-F\0A      [else 0])))\0A;;; Whether C is a hex digit at all.  rd-hex-digit answers 0 for a non-digit, which the\0A;;; string escape can live with (it stops at the `;`) but #\5CxHH cannot: there the digits\0A;;; run to a DELIMITER, so `#\5Cxyz` must be told apart from a codepoint rather than folded\0A;;; into one silently (change: r7rs-lexical-conformance).\0A(define (rd-hex-digit? c)\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(and (< 47 k) (< k 58)) #t]  ; 0-9\0A      [(and (< 96 k) (< k 103)) #t] ; a-f\0A      [(and (< 64 k) (< k 71)) #t]  ; A-F\0A      [else #f])))\0A(define (rd-hex s n i acc) ; \5CxHH...; -> (codepoint . index-past-;)\0A  (if (< i n)\0A      (if (= (char->integer (string-ref s i)) 59) ; ;\0A          (cons acc (+ i 1))\0A          (rd-hex s n (+ i 1) (+ (* acc 16) (rd-hex-digit (string-ref s i)))))\0A      (cons acc i)))\0A(define (rd-str-esc c) ; escape letter -> the character it denotes\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(= k 97) (integer->char 7)]   ; \5Ca  alarm     (change: r7rs-lexical-conformance)\0A      [(= k 98) (integer->char 8)]   ; \5Cb  backspace (change: r7rs-lexical-conformance)\0A      [(= k 110) (integer->char 10)] ; \5Cn\0A      [(= k 116) (integer->char 9)]  ; \5Ct\0A      [(= k 114) (integer->char 13)] ; \5Cr\0A      [else c])))                    ; \5C\5C \5C\22 and any other: the char itself\0A;;; R7RS 6.7 <intraline whitespace>: space or tab, and nothing else -- a newline ENDS a\0A;;; run of it rather than belonging to one, which is what makes the line continuation\0A;;; below decomposable into \22whitespace, ending, whitespace\22.\0A(define (rd-intraline s n i) ; index just past a run of spaces/tabs\0A  (if (< i n)\0A      (let ([k (char->integer (string-ref s i))])\0A        (if (if (= k 32) #t (= k 9)) (rd-intraline s n (+ i 1)) i))\0A      i))\0A\0A;;; A `\5C` LINE CONTINUATION (R7RS 6.7): backslash, optional intraline whitespace, a line\0A;;; ending, optional intraline whitespace -- the whole run contributing NO characters, so a\0A;;; long literal can be broken across source lines without the break and the next line's\0A;;; indentation landing in its value.  `j` is the index just past the backslash; the answer\0A;;; is the index to resume at, or #f when this is an ordinary escape instead.\0A;;; All three line endings R7RS admits are accepted (LF, CR, CRLF), because a source file\0A;;; with CRLF endings would otherwise leave a stray return in every continued string.\0A(define (rd-line-continuation s n j)\0A  (let ([w (rd-intraline s n j)])\0A    (if (< w n)\0A        (let ([k (char->integer (string-ref s w))])\0A          (cond\0A            [(= k 10) (rd-intraline s n (+ w 1))]\0A            [(= k 13)\0A              (rd-intraline\0A                s\0A                n\0A                (if (< (+ w 1) n)\0A                    (if (= (char->integer (string-ref s (+ w 1))) 10) (+ w 2) (+ w 1))\0A                    (+ w 1)))]\0A            [else #f]))\0A        #f)))\0A\0A;; `open` is the index of the opening \22 -- carried so the report can name where the string\0A;; STARTED, which is where the missing delimiter belongs (change: reader-input-termination).\0A(define (rd-string s n i open) ; i just past opening \22; decodes escapes\0A  (let loop ([i i] [acc (quote ())])\0A    (if\0A      (< i n)\0A      (let* ([c (string-ref s i)] [k (char->integer c)])\0A        (cond\0A          [(= k 34) (cons (list->string (reverse acc)) (+ i 1))] ; closing \22\0A          [(= k 92)                                              ; backslash escape\0A            ;; The escaped character must EXIST.  A source ending in a dangling backslash\0A            ;; used to read s[n] -- past the end of the input, and silently, because\0A            ;; indexed access is unchecked (issue #70).  A dangling \5CxHH needs no arm of\0A            ;; its own: rd-hex stops at n, so the loop re-enters and ends below.\0A            (if\0A              (<= n (+ i 1))\0A              (rd-fail (quote rd-unterminated-string) open)\0A              (let ([e (string-ref s (+ i 1))]\0A                    ;; Tested BEFORE \5CxHH; and before the escape table: a backslash that\0A                    ;; begins a continuation is not naming a character at all, so it must\0A                    ;; not reach rd-str-esc (which would answer the whitespace itself).\0A                    [cont (rd-line-continuation s n (+ i 1))])\0A                (cond\0A                  [cont (loop cont acc)]     ; contributes nothing\0A    