et! %stderr-port (car args)) (if #f #f))))\0A\0A;;; The stdin port's TEXT is pulled in on the first read, never here (see\0A;;; %port-buf) -- slurping at startup would block every program on a stdin nobody\0A;;; reads.\0A(define (current-input-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stdin-port) (set! %stdin-port (%make-port #f #t #f 0 #f #f)))\0A        %stdin-port)\0A      (begin (set! %stdin-port (car args)) (if #f #f))))\0A\0A;;; call-with-port: hand the port to PROC and close it on EVERY exit -- a normal\0A;;; return, an escape via a continuation, or a raise.  dynamic-wind is what makes\0A;;; the escaping cases work; a version that just closed after the call would leak\0A;;; the port exactly when it matters most.\0A(define (call-with-port p proc)\0A  (dynamic-wind\0A    (lambda () (if #f #f))\0A    (lambda () (proc p))\0A    (lambda () (close-port p))))\0A\0A;;; with-output-to-file / with-input-from-file: rebind the corresponding parameter\0A;;; for the dynamic extent of THUNK, then close the port and restore the parameter.\0A;;; Both ride dynamic-wind for the same reason call-with-port does.\0A(define (with-output-to-file path thunk)\0A  (let ((p (open-output-file path))\0A        (saved (current-output-port)))\0A    (dynamic-wind\0A      (lambda () (current-output-port p))\0A      thunk\0A      (lambda () (current-output-port saved #f) (close-port p)))))\0A\0A(define (with-input-from-file path thunk)\0A  (let ((p (open-input-file path))\0A        (saved (current-input-port)))\0A    (dynamic-wind\0A      (lambda () (current-input-port p))\0A      thunk\0A      (lambda () (current-input-port saved #f) (close-port p)))))\0A\0A(define (call-with-output-file path proc)\0A  (call-with-port (open-output-file path) proc))\0A(define (call-with-input-file path proc)\0A  (call-with-port (open-input-file path) proc))\0A\0A;;; --- the file operations that are not port constructors (change:\0A;;; catchable-errors-with-kinds, design D8).  R7RS pu