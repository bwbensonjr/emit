@.str.lit.1339 = private unnamed_addr constant [87258 x i8] c";;; prelude.scm -- standard library procedures prepended to every program.\0A;;;\0A;;; Pure Scheme over the core primitives + variadic lambda; the driver\0A;;; (src/compile.ss) prepends these top-level defines to each program, with\0A;;; user-wins shadowing (a user define of the same name drops the prelude's).\0A;;; See openspec prelude-mechanism.  memq/assq compare with eq?; member/assoc\0A;;; are their structural analogues over equal? (see openspec\0A;;; equality-and-list-library).  not/eq?/eqv?/equal? are primitives (see\0A;;; prim-table), so they are not defined here.\0A\0A;;; --- derived syntactic forms (syntax-rules macros) ------------------------\0A;;; cond/and/or/when/unless/let* are macros expanded by src/passes/expand.ss.\0A;;; Named `let` is still hand-written there (it overloads the core `let`\0A;;; keyword).  `t` in `or`/`cond` is a macro-introduced temporary and is renamed\0A;;; hygienically per expansion, so it cannot capture user identifiers.\0A\0A(define-syntax and\0A  (syntax-rules ()\0A    ((_) #t)\0A    ((_ e) e)\0A    ((_ e1 e2 ...) (if e1 (and e2 ...) #f))))\0A\0A(define-syntax or\0A  (syntax-rules ()\0A    ((_) #f)\0A    ((_ e) e)\0A    ((_ e1 e2 ...) (let ((t e1)) (if t t (or e2 ...))))))\0A\0A;; when/unless: the UNTAKEN branch is the unspecified value, not #f (change:\0A;; unspecified-value).  `when` gets it from the two-armed `if` -- the parser supplies the\0A;; missing alternative -- and `unless`, which needs the else arm for its body, spells it\0A;; with the `(if #f #f)` idiom.  (R7RS leaves the result unspecified even when the branch\0A;; IS taken; Emit returns the body value there, as most implementations do.)\0A;; `unless`'s nested `(if #f #f)` emits a dead branch diamond (+8 IR lines per use), the\0A;; same cost `case`/`do` already pay for the idiom.  It costs nothing in the binary:\0A;; `icmp ne i64 1, 1` is constant-folded, and clang -O2 collapses the whole diamond\0A;; (verified against the emitted IR), so the standalone-executable size goal is unaffected.\0A(define-syntax when\0A  (syntax-rules ()\0A    ((_ test e ...) (if test (begin e ...)))))\0A\0A(define-syntax unless\0A  (syntax-rules ()\0A    ((_ test e ...) (if test (if #f #f) (begin e ...)))))\0A\0A(define-syntax let*\0A  (syntax-rules ()\0A    ((_ () body ...) (begin body ...))\0A    ((_ ((x v) rest ...) body ...) (let ((x v)) (let* (rest ...) body ...)))))\0A\0A;; cond: falling off the end with no clause matched yields the unspecified value, not #f\0A;; (change: unspecified-value) -- matching `case`'s no-match rule below.\0A(define-syntax cond\0A  (syntax-rules (else =>)\0A    ((_) (if #f #f))\0A    ((_ (else e ...)) (begin e ...))\0A    ((_ (test => proc) rest ...) (let ((t test)) (if t (proc t) (cond rest ...))))\0A    ((_ (test) rest ...) (let ((t test)) (if t t (cond rest ...))))\0A    ((_ (test e ...) rest ...) (if test (begin e ...) (cond rest ...)))))\0A\0A;; `case`: evaluate KEY once, then run the first clause whose datum list contains\0A;; it (eqv?), else the `else` clause.  A parenthesized KEY is bound to a hygienic\0A;; temp `k` first (so it is not re-evaluated per clause); the recursive calls pass\0A;; the bound identifier, which no longer matches the compound-KEY rule.  Expands\0A;; to `cond` over `(memv k '(d ...))`.\0A(define-syntax case\0A  (syntax-rules (else)\0A    ((_ (key ...) clause ...) (let ((k (key ...))) (case k clause ...)))\0A    ((_ k) (if #f #f))\0A    ((_ k (else e ...)) (begin e ...))\0A    ((_ k ((d ...) e ...) clause ...)\0A     (if (memv k (quote (d ...))) (begin e ...) (case k clause ...)))))\0A\0A;; R7RS `do`: iterate with parallel-updated bindings.  Each binding is\0A;; (var init step) or (var init) [step defaults to var, i.e. unchanged].  On each\0A;; pass: if `test` holds, the result exprs run (unspecified value if none);\0A;; otherwise the commands run and every var is rebound to its step -- all steps\0A;; are evaluated before any rebind because they are the arguments of the loop\0A;; call.  %do-step supplies the default step.  (change: inexact-numbers)\0A(define-syntax %do-step\0A  (syntax-rules ()\0A    ((_ x) x)\0A    ((_ x s) s)))\0A(define-syntax do\0A  (syntax-rules ()\0A    ((_ ((var init step ...) ...)\0A        (test result ...)\0A        command ...)\0A     (letrec ((loop (lambda (var ...)\0A                      (if test\0A                          (begin (if #f #f) result ...)\0A                          (begin command ...\0A                                 (loop (%do-step var step ...) ...))))))\0A       (loop init ...)))))\0A\0A(define (list . xs) xs)\0A\0A;;; --- compositional car/cdr accessors (cxr combinators) --------------------\0A;;; All twenty-eight: the four depth-2 forms, which R7RS-small puts in (scheme base),\0A;;; and the twenty-four depth-3 and depth-4 compositions, which it puts in\0A;;; (scheme cxr) -- see the partition in src/prelude-surface.scm for which library\0A;;; exports which.  Each is the named composition of the primitive car/cdr, the\0A;;; letters read right-to-left = innermost-first, so cXYZ = (cX (cYZ x)).\0A(define (caar x) (car (car x)))\0A(define (cadr x) (car (cdr x)))\0A(define (cdar x) (cdr (car x)))\0A(define (cddr x) (cdr (cdr x)))\0A(define (caaar x) (car (caar x)))\0A(define (caadr x) (car (cadr x)))\0A(define (cadar x) (car (cdar x)))\0A(define (caddr x) (car (cddr x)))\0A(define (cdaar x) (cdr (caar x)))\0A(define (cdadr x) (cdr (cadr x)))\0A(define (cddar x) (cdr (cdar x)))\0A(define (cdddr x) (cdr (cddr x)))\0A;;; The depth-4 forms.  Fifteen of the sixteen are new (change:\0A;;; scheme-base-partition, design D9): (scheme cxr) is specified to export\0A;;; twenty-four procedures, and shipping a library named after the standard in which\0A;;; (caddar x) is an unbound variable would be a worse conformance state than not\0A;;; having the library at all.  `cadddr` is the sixteenth and predates them -- the\0A;;; prelude grew as self-hosting needed names, which is why only it was here.  The\0A;;; compiler uses none of these, so they are homed in (scheme cxr) alone.\0A(define (caaaar x) (car (caaar x)))\0A(define (caaadr x) (car (caadr x)))\0A(define (caadar x) (car (cadar x)))\0A(define (caaddr x) (car (caddr x)))\0A(define (cadaar x) (car (cdaar x)))\0A(define (cadadr x) (car (cdadr x)))\0A(define (caddar x) (car (cddar x)))\0A(define (cdaaar x) (cdr (caaar x)))\0A(define (cdaadr x) (cdr (caadr x)))\0A(define (cdadar x) (cdr (cadar x)))\0A(define (cdaddr x) (cdr (caddr x)))\0A(define (cddaar x) (cdr (cdaar x)))\0A(define (cddadr x) (cdr (cdadr x)))\0A(define (cdddar x) (cdr (cddar x)))\0A(define (cddddr x) (cdr (cdddr x)))\0A\0A(define (length xs)\0A  (let loop ([xs xs] [n 0])\0A    (if (null? xs) n (loop (cdr xs) (+ n 1)))))\0A\0A(define (reverse xs)\0A  (let loop ([xs xs] [acc (quote ())])\0A    (if (null? xs) acc (loop (cdr xs) (cons (car xs) acc)))))\0A\0A;; append is variadic (R7RS): zero or more lists.  The compiler core uses 3-arg\0A;; append (e.g. emit-code-def's argdecls), and Chez's append is variadic, so\0A;; this must be too for the core to self-compile (fix-closure-self-compilation).\0A(define (%append2 a b)\0A  (if (null? a) b (cons (car a) (%append2 (cdr a) b))))\0A(define (append . lists)\0A  (if (null? lists)\0A      (quote ())\0A      (if (null? (cdr lists))\0A          (car lists)\0A          (%append2 (car lists) (apply append (cdr lists))))))\0A\0A;; map/for-each are variadic (R7RS): one or more lists, walked in lockstep,\0A;; stopping at the shortest.  The single-list case is the fast path; the\0A;; multi-list case (used pervasively by the compiler core -- e.g. rename's\0A;; (map cons names new) and emit's (for-each ... slots (iota k))) applies f to\0A;; the i-th element of every list.  Chez's map/for-each are variadic, so these\0A;; match and the core self-compiles (fix-closure-self-compilation).\0A(define (%map1 f xs)\0A  (if (null? xs) (quote ()) (cons (f (car xs)) (%map1 f (cdr xs)))))\0A(define (%any-null? ls)\0A  (if (null? ls) #f (if (null? (car ls)) #t (%any-null? (cdr ls)))))\0A(define (%mapn f ls)\0A  (if (%any-null? ls)\0A      (quote ())\0A      (cons (apply f (%map1 car ls)) (%mapn f (%map1 cdr ls)))))\0A(define (map f xs . more)\0A  (if (null? more) (%map1 f xs) (%mapn f (cons xs more))))\0A\0A(define (memq x xs)\0A  (if (null? xs) #f (if (eq? x (car xs)) xs (memq x (cdr xs)))))\0A\0A;; memv: like memq but compares with eqv? (used by the `case` macro).\0A(define (memv x xs)\0A  (if (null? xs) #f (if (eqv? x (car xs)) xs (memv x (cdr xs)))))\0A\0A(define (assq k xs)\0A  (if (null? xs) #f (if (eq? k (car (car xs))) (car xs) (assq k (cdr xs)))))\0A\0A;;; --- structural list library (equality-and-list-library) ------------------\0A;;; member/assoc mirror memq/assq but compare with equal? (structural).\0A(define (member x xs)\0A  (if (null? xs) #f (if (equal? x (car xs)) xs (member x (cdr xs)))))\0A\0A(define (assoc k xs)\0A  (if (null? xs) #f (if (equal? k (car (car xs))) (car xs) (assoc k (cdr xs)))))\0A\0A(define (filter p xs)\0A  (if (null? xs)\0A      (quote ())\0A      (if (p (car xs))\0A          (cons (car xs) (filter p (cdr xs)))\0A          (filter p (cdr xs)))))\0A\0A;; fold-left: tail-recursive, f receives (acc elem), left-to-right (R6RS order).\0A(define (fold-left f acc xs)\0A  (if (null? xs) acc (fold-left f (f acc (car xs)) (cdr xs))))\0A\0A;; fold-right: non-tail, f receives (elem acc), right-to-left (R6RS order).\0A(define (fold-right f acc xs)\0A  (if (null? xs) acc (f (car xs) (fold-right f acc (cdr xs)))))\0A\0A;;; --- additional list/utility procedures (self-host-gap-sweep G10) ----------\0A;;; The compiler core assumes these; all are pure Scheme over existing prims.\0A;;; (predicate-taking procs take the predicate first, per R6RS.)\0A\0A;; apply a procedure to each element for effect; returns the unspecified value.\0A(define (%for-each1 f xs)\0A  (if (null? xs) (if #f #f) (begin (f (car xs)) (%for-each1 f (cdr xs)))))\0A(define (%for-eachn f ls)\0A  (if (%any-null? ls)\0A      (if #f #f)\0A      (begin (apply f (%map1 car ls)) (%for-eachn f (%map1 cdr ls)))))\0A(define (for-each f xs . more)\0A  (if (null? more) (%for-each1 f xs) (%for-eachn f (cons xs more))))\0A\0A;; #t iff the predicate holds for every element (short-circuits on #f).\0A(define (andmap p xs)\0A  (if (null? xs) #t (if (p (car xs)) (andmap p (cdr xs)) #f)))\0A\0A;; first tail whose head satisfies the predicate, else #f.\0A(define (memp p xs)\0A  (if (null? xs) #f (if (p (car xs)) xs (memp p (cdr xs)))))\0A\0A;; fourth-element accessor (extends the cxr set one deeper).\0A(define (cadddr x) (car (cdddr x)))\0A\0A;; #t iff a proper list (walks to null; a dotted tail yields #f).\0A(define (list? x)\0A  (if (null? x) #t (if (pair? x) (list? (cdr x)) #f)))\0A\0A(define (zero? n) (= n 0))\0A\0A;; the sublist after n elements, the nth element, and the first n elements.\0A(define (list-tail xs n) (if (zero? n) xs (list-tail (cdr xs) (- n 1))))\0A(define (list-ref xs n) (car (list-tail xs n)))\0A(define (list-head xs n)\0A  (if (zero? n) (quote ()) (cons (car xs) (list-head (cdr xs) (- n 1)))))\0A\0A;; a list of n copies of x.\0A(define (make-list n x) (if (zero? n) (quote ()) (cons x (make-list (- n 1) x))))\0A\0A;; the list (0 1 ... n-1).\0A(define (iota n)\0A  (let loop ([i 0] [acc (quote ())])\0A    (if (= i n) (reverse acc) (loop (+ i 1) (cons i acc)))))\0A\0A;;; --- max / min (R7RS 6.2.6) -----------------------------------------------\0A;;; Variadic over one or more numbers (change: numeric-conformance, design D6 /\0A;;; GitHub issue #26 -- `max` used to be strictly binary and `min` did not exist).\0A;;;\0A;;; R7RS requires INEXACTNESS CONTAGION: if any argument is inexact the result is\0A;;; inexact, even when the argument that WON the comparison is exact.  That second\0A;;; half is the one a naive implementation gets wrong -- `(max 3.0 4)` is 4.0, not 4\0A;;; -- so the winner and the exactness are tracked separately: the fold carries a\0A;;; flag for \22some argument was inexact\22 and the conversion happens once, at the end.\0A;;; Comparison itself is by numeric value across the exactness boundary, which `<`\0A;;; already does.\0A;;; The flag is `inex`, NOT `inexact?`: naming it after the predicate would shadow\0A;;; the predicate this very fold calls, and the shadowed call would ask a boolean.\0A(define (%minmax-fold pick xs best inex)\0A  (if (null? xs)\0A      (if inex (exact->inexact best) best)\0A      (%minmax-fold pick (cdr xs) (pick best (car xs))\0A                    (if inex #t (inexact? (car xs))))))\0A(define (%minmax pick a rest)\0A  (%minmax-fold pick rest a (inexact? a)))\0A(define (max a . rest) (%minmax (lambda (x y) (if (< x y) y x)) a rest))\0A(define (min a . rest) (%minmax (lambda (x y) (if (< y x) y x)) a rest))\0A\0A;;; --- the R7RS 6.2 numeric inventory (change: numeric-conformance) -----------\0A;;; Emit's tower is two types -- a 61-bit exact integer and a double -- which R7RS\0A;;; 6.2.3 explicitly permits (\22an implementation in which exact numbers are always\0A;;; integer\22).  Everything below is Scheme over the existing primitives; only what\0A;;; genuinely needs C (the flonum arm of the rounding family, classification, libm)\0A;;; is a `%`-op, which is what kept the staged-bootstrap cost proportional.\0A;;;\0A;;; The 6.2.3 exact-for-exact guarantee is honored throughout: abs, ceiling, floor,\0A;;; gcd, lcm, max, min, round, square, truncate and the division family all return\0A;;; exact results for exact arguments.  A result that leaves the fixnum range traps\0A;;; through the existing overflow diagnostic -- (abs FIXNUM_MIN) among them, whose\0A;;; magnitude is one past the range -- inherited from `+ - *`, not re-implemented.\0A\0A;;; Type predicates apply to ANY object and answer #f for a non-number (R7RS 6.2.6),\0A;;; unlike the arithmetic predicates below them, which require a number.\0A(define (complex? n) (number? n))\0A(define (exact-integer? n) (if (exact? n) (integer? n) #f))\0A;;; `rational?` is the finite reals: every exact integer, and a flonum that is\0A;;; neither an infinity nor a NaN.  %finite? is the runtime's isfinite, so there is\0A;;; one definition of finiteness shared with (scheme inexact)'s `finite?`.\0A(define (rational? n) (if (number? n) (%finite? n) #f))\0A\0A;;; Sign and parity require a number; `<` and `remainder` supply the trap, and\0A;;; remainder's integrality guard is what makes (odd? 7.5) an error rather than an\0A;;; answer.\0A(define (positive? n) (< 0 n))\0A(define (negative? n) (< n 0))\0A(define (even? n) (= 0 (remainder n 2)))\0A(define (odd? n) (if (= 0 (remainder n 2)) #f #t))\0A\0A(define (abs n) (if (< n 0) (- 0 n) n))\0A(define (square n) (* n n))\0A\0A;;; gcd/lcm: variadic, non-negative, exact for exact.  Identities are 0 and 1, so\0A;;; the no-argument cases fall out of the fold rather than being special-cased.\0A(define (%gcd2 a b) (if (= b 0) a (%gcd2 b (remainder a b))))\0A(define (%gcd-fold ns acc)\0A  (if (null? ns) acc (%gcd-fold (cdr ns) (%gcd2 (abs (car ns)) (abs acc)))))\0A(define (%lcm-fold ns acc)\0A  (if (null? ns)\0A      acc\0A      (let ([a (abs (car ns))])\0A        (if (= a 0) 0 (%lcm-fold (cdr ns) (quotient (* acc a) (%gcd2 acc a)))))))\0A(define (gcd . ns) (%gcd-fold ns 0))\0A(define (lcm . ns) (%lcm-fold ns 1))\0A\0A;;; expt.  An exact base with a non-negative exact integer exponent stays EXACT, by\0A;;; repeated squaring -- so (expt 2 60) is exact and (expt 2 61) traps on overflow\0A;;; rather than silently going inexact.  A negative exponent has no exact value\0A;;; here (no rationals), so it returns the inexact one, which is the same 6.2.3\0A;;; licence `/` already uses for a non-integral exact quotient.  Any inexact\0A;;; operand routes to %pow (libm).  (expt 0 0) is 1, per 6.2.6.\0A(define (%expt-exact b e acc)\0A  (if (= e 0)\0A      acc\0A      (%expt-exact (* b b) (quotient e 2) (if (odd? e) (* acc b) acc))))\0A(define (expt b e)\0A  (if (exact? e)\0A      (if (< e 0)\0A          (%pow b e)\0A          (if (exact? b) (%expt-exact b e 1) (%expt-exact b e 1.0)))\0A      (%pow b e)))\0A\0A;;; exact-integer-sqrt: Newton's method on exact integers, returning TWO values --\0A;;; the root and the remainder -- through the same `values` the rest of the library\0A;;; uses.  Stays exact end to end, which is the point of it existing alongside\0A;;; (scheme inexact)'s `sqrt`.\0A(define (%isqrt-loop n g)\0A  (let ([g2 (quotient (+ g (quotient n g)) 2)])\0A    (if (< g2 g) (%isqrt-loop n g2) g)))\0A(define (%isqrt n) (if (= n 0) 0 (%isqrt-loop n n)))\0A(define (exact-integer-sqrt n)\0A  (let ([s (%isqrt n)]) (values s (- n (* s s)))))\0A\0A;;; Rounding.  An exact integer is already rounded, so it is returned UNCHANGED --\0A;;; which is both the R7RS exactness rule and the reason a large-magnitude flonum\0A;;; never routes through the fixnum range: the inexact arm stays in double.\0A;;; `round` is round-half-to-EVEN (%flo-round is rint), so 2.5 -> 2.0 and 3.5 -> 4.0.\0A(define (floor n)    (if (exact? n) n (%flo-floor n)))\0A(define (ceiling n)  (if (exact? n) n (%flo-ceiling n)))\0A(define (truncate n) (if (exact? n) n (%flo-truncate n)))\0A(define (round n)    (if (exact? n) n (%flo-round n)))\0A\0A;;; The R7RS 6.2.6 division operators, over the truncating and flooring primitives\0A;;; that already exist -- so all six inherit their argument-domain rules (an\0A;;; integral flonum is accepted with contagion, anything else non-integer traps)\0A;;; and their division-by-zero trap, with no second implementation to keep in step.\0A;;; floor-quotient is derived rather than branched on signs: subtracting the\0A;;; flooring remainder makes the division exact, so the truncating quotient of the\0A;;; difference IS the flooring quotient.\0A(define (truncate-quotient n d) (quotient n d))\0A(define (truncate-remainder n d) (remainder n d))\0A(define (floor-remainder n d) (modulo n d))\0A(define (floor-quotient n d) (quotient (- n (modulo n d)) d))\0A(define (truncate/ n d) (values (quotient n d) (remainder n d)))\0A(define (floor/ n d) (values (floor-quotient n d) (modulo n d)))\0A\0A;;; numerator/denominator, restricted to integer-VALUED arguments: n/1 for an exact\0A;;; integer and n/1.0 for an integral flonum.  R7RS defines them over rationals,\0A;;; which Emit does not represent, and 6.2.3 sanctions restricting the domain -- a\0A;;; best-effort rational reconstruction of a double would be misleading, not useful.\0A(define (numerator n)\0A  (if (integer? n) n (error \22numerator: not an integer\22 n)))\0A(define (denominator n)\0A  (if (integer? n) (if (exact? n) 1 1.0) (error \22denominator: not an integer\22 n)))\0A\0A;;; The R7RS spellings of the exactness conversions.  The R5RS names remain, so\0A;;; both are available and neither is deprecated here.\0A(define (inexact n) (exact->inexact n))\0A(define (exact n) (inexact->exact n))\0A\0A;; THE unspecified value -- one distinguished immediate, distinct from #f and '() and\0A;; truthy (change: unspecified-value).  `(if #f #f)` is the two-armed form, so the parser\0A;; supplies the missing alternative as `(primcall %unspec)`; this needs no special case.\0A;; The GENERATOR is exposed so a program can declare \22no interesting result\22; there is\0A;; deliberately no `unspecified?` predicate to test for it (R7RS-WG1 ballot #49).  What\0A;; Emit returns here is not a promise -- portable programs must not rely on it.\0A(define (void) (if #f #f))\0A\0A;; construct a string from character arguments (via the list->string primitive).\0A(define (string . cs) (list->string cs))\0A\0A;;; --- string-append over a list (self-host-gap-sweep G8) --------------------\0A;;; HISTORICAL: this was the callee of the parser's eta for a bare `string-append`\0A;;; in value position.  That special case was retired in favour of the\0A;;; self-contained `str` fold over raw primcalls (see `*integrable*` in\0A;;; src/parse.ss), so nothing calls this now; it is private (issue #29) and kept\0A;;; only because it is harmless and the fold's shape is easier to read beside it.\0A;;; Written in the common subset -- each `(string-append a b)` here is 2-arg, i.e.\0A;;; native under Chez and the binary primcall under Emit -- so the prelude still\0A;;; loads and runs under Chez.\0A(define (%str-concat xs)\0A  (if (null? xs) \22\22 (string-append (car xs) (%str-concat (cdr xs)))))\0A\0A;;; --- character / string library (string-char-library) ---------------------\0A;;; char comparisons are n-ary and chained, reducing through char->integer and\0A;;; the numeric comparisons.  `op` is a lambda wrapper (primitives are not\0A;;; first-class, so we cannot pass = / < directly); chr-cmp recurses over the\0A;;; user-defined comparison chain.\0A(define (chr-cmp op a b rest)\0A  (if (op (char->integer a) (char->integer b))\0A      (if (null? rest) #t (chr-cmp op b (car rest) (cdr rest)))\0A      #f))\0A(define (char=?  a b . rest) (chr-cmp (lambda (x y) (=  x y)) a b rest))\0A(define (char<?  a b . rest) (chr-cmp (lambda (x y) (<  x y)) a b rest))\0A(define (char>?  a b . rest) (chr-cmp (lambda (x y) (>  x y)) a b rest))\0A(define (char<=? a b . rest) (chr-cmp (lambda (x y) (<= x y)) a b rest))\0A(define (char>=? a b . rest) (chr-cmp (lambda (x y) (>= x y)) a b rest))\0A\0A;; string->list: codepoint-indexed, built from the end so the list is in order.\0A(define (string->list s)\0A  (let loop ([i (- (string-length s) 1)] [acc (quote ())])\0A    (if (< i 0) acc (loop (- i 1) (cons (string-ref s i) acc)))))\0A\0A;;; --- number->string (base-10 signed integers) -----------------------------\0A;;; Inverse of the reader's integer parsing (rd-parse-int), so it round-trips.\0A;;; Digits are peeled from the NON-POSITIVE magnitude of n via quotient/remainder\0A;;; by 10: for m <= 0, (remainder m 10) is in -9..0 so (- 0 (remainder m 10)) is\0A;;; the 0..9 digit, and (quotient m 10) truncates toward zero.  Working on the\0A;;; negative side (never negating the whole value) means the full fixnum range is\0A;;; handled exactly, INCLUDING the most-negative fixnum -- whose magnitude has no\0A;;; positive fixnum representation, so a negate-first approach would overflow.\0A(define (ns-digits m acc)                ; m <= 0 -> chars of |m|, prepended to acc\0A  (ns-digits-radix m 10 acc))\0A;;; The same peel, in any supported radix (change: numeric-conformance).  Digits\0A;;; above 9 are lowercase, which is what the reader's rd-hex-digit accepts, so the\0A;;; radix forms round-trip too.\0A(define (%ns-digit-char d)\0A  (if (< d 10) (integer->char (+ 48 d)) (integer->char (+ 87 d))))   ; 87 + 10 = #\5Ca\0A(define (ns-digits-radix m r acc)        ; m <= 0 -> chars of |m| in radix r\0A  (let ([ch (%ns-digit-char (- 0 (remainder m r)))]\0A        [rest (quotient m r)])\0A    (if (= rest 0)\0A        (cons ch acc)\0A        (ns-digits-radix rest r (cons ch acc)))))\0A;;; Flonums route to the runtime formatter (%flonum->string: shortest round-\0A;;; trippable decimal, always with a '.').  `exact?` gates it -- exact? is true\0A;;; only for fixnums, so the integer path is unchanged; the flonum branch is\0A;;; never reached with a fixnum (and so is dead during the bootstrap regen, where\0A;;; %flonum->string is not yet a known primcall).  (change: inexact-numbers)\0A;;; The optional radix argument (change: numeric-conformance) takes 2, 8, 10, or 16\0A;;; for an exact integer.  An inexact number requires radix 10: R7RS 6.2.6 permits\0A;;; an error for the other radices, which is better than inventing a rendering the\0A;;; reader could not read back.\0A(define (%radix-ok? r)\0A  (if (= r 10) #t (if (= r 16) #t (if (= r 8) #t (= r 2)))))\0A(define (number->string n . rest)\0A  (let ([r (if (null? rest) 10 (car rest))])\0A    (if (%radix-ok? r)\0A        (if (exact? n)\0A            (cond\0A              [(= n 0) \220\22]\0A              [(< n 0) (list->string (cons #\5C- (ns-digits-radix n r (quote ()))))]\0A              [else    (list->string (ns-digits-radix (- 0 n) r (quote ())))])\0A            (if (= r 10)\0A                (%flonum->string n)\0A                (error \22number->string: radix must be 10 for an inexact number\22 r)))\0A        (error \22number->string: unsupported radix\22 r))))\0A\0A;;; string->number: the INVERSE, and deliberately built from the reader's own\0A;;; classifiers (rd-numeric?/rd-flonum?/rd-parse-int) rather than a second numeric\0A;;; grammar that could drift from the one the reader accepts.  Returns #f -- not an\0A;;; error -- for text that is not a number, per R7RS 6.2.6.  When the radix\0A;;; prefixes (#x/#b/#o/#e/#i) land in the reader, this inherits them for free.\0A(define (%digit-in-radix c r)            ; digit value, or #f if not a digit in r\0A  (let ([v (let ([k (char->integer c)])\0A             (cond\0A               [(and (< 47 k) (< k 58)) (- k 48)]      ; 0-9\0A               [(and (< 96 k) (< k 123)) (- k 87)]     ; a-z\0A               [(and (< 64 k) (< k 91)) (- k 55)]      ; A-Z\0A               [else 99]))])\0A    (if (< v r) v #f)))\0A(define (%radix-digits s i m r acc)      ; accumulate DOWNWARD (see rd-digits-neg)\0A  (if (< i m)\0A      (let ([d (%digit-in-radix (string-ref s i) r)])\0A        (if d (%radix-digits s (+ i 1) m r (- (* acc r) d)) #f))\0A      acc))\0A(define (%string->int s r)               ; signed integer in radix r, or #f\0A  (let ([m (string-length s)])\0A    (if (= m 0)\0A        #f\0A        (let ([c0 (char->integer (string-ref s 0))])\0A          (if (= c0 45)                                  ; leading '-'\0A              (if (< 1 m) (%radix-digits s 1 m r 0) #f)\0A              (let ([start (if (= c0 43) 1 0)])           ; optional leading '+'\0A                (if (< start m)\0A                    (let ([neg (%radix-digits s start m r 0)])\0A                      (if neg (- 0 neg) #f))\0A                    #f)))))))\0A;;; `rd-number` IS the reader's number grammar, prefixes and all (change:\0A;;; reader-lexical-conformance, design D3), so this shares one grammar with the reader\0A;;; instead of restating it: `#x1f` parses here because it parses there, and a prefix in\0A;;; the text beats the `radix` argument for the same reason it does in a source file.\0A;;; The ONE difference is the one R7RS 6.2.6 requires -- where the reader REPORTS a\0A;;; number it cannot represent (`1/2`, `#x1.8`), string->number answers #f.  rd-number\0A;;; says so with a symbol, and a number is never a symbol, so that is the whole test.\0A(define (string->number s . rest)\0A  (let ([r (if (null? rest) 10 (car rest))])\0A    (if (%radix-ok? r)\0A        (let ([v (rd-number s r)])\0A          (if (symbol? v) #f v))\0A        (error \22string->number: unsupported radix\22 r))))\0A\0A;;; --- exceptions: error objects, raise, guard (r7rs-exceptions-subset) ------\0A;;; R7RS `(error message irritant ...)` builds a CATCHABLE error object and raises\0A;;; it.  As a compatible superset we also accept a leading SYMBOL `who` (the\0A;;; compiler's internal call style, and how this prelude is written so it stays\0A;;; valid under the Chez bootstrap too), folding \22who: message\22 into the message.\0A;;; Uncaught, an error renders and aborts as before (REPL host survives; a\0A;;; standalone executable exits non-zero).  %error-abort builds the error object\0A;;; in the runtime (rt_error) and raises it through the guard escape stack.\0A(define (error a . rest)\0A  (if (string? a)\0A      (raise (%make-error-object a rest))            ; R7RS: (error message irritant ...)\0A      (raise (%make-error-object\0A               (string-append (symbol->string a) (string-append \22: \22 (car rest)))\0A               (cdr rest)))))                         ; superset: (error who message ...)\0A\0A;;; --- dynamic extent: winds, escape continuations, handlers (dynamic-extent) --\0A;;; Rung 3 of the call/cc staircase (openspec/explorations/continuations-and-control.md).\0A;;; THREE structures, each with one job (design D4):\0A;;;   escape frames  -- in the runtime; setjmp targets, each with a generation id\0A;;;   *winds*        -- here; active dynamic-wind (before . after) pairs, innermost first\0A;;;   *handlers*     -- here; the R7RS current-exception-handler chain\0A;;; `raise` CALLS the current handler (it does not transfer); `guard` is a handler\0A;;; that escapes.  So there is one transfer mechanism, not two.\0A(define *winds* (quote ()))\0A(define *handlers* (quote ()))\0A\0A;;; Pop entries off the wind list until it is the captured TARGET, running each\0A;;; `after`.  The entry is popped BEFORE its `after` runs, so a raise or escape from\0A;;; inside an `after` cannot re-enter it and unwinding cannot loop; the new transfer\0A;;; then unwinds the rest on its own way out.\0A(define (%unwind-to target)\0A  (if (eq? *winds* target)\0A      #t\0A      (if (null? *winds*)\0A          #t                                  ; target is not on this chain\0A          (let ((entry (car *winds*)))\0A            (set! *winds* (cdr *winds*))\0A            ((cdr entry))\0A            (%unwind-to target)))))\0A\0A;;; dynamic-wind: before, body, after -- with `after` on EVERY exit.  The normal\0A;;; path pops and runs it here; an escape or a raise runs it through %unwind-to.\0A(define (dynamic-wind before thunk after)\0A  (before)\0A  (set! *winds* (cons (cons before after) *winds*))\0A  (let ((r (thunk)))\0A    (set! *winds* (cdr *winds*))\0A    (after)\0A    r))\0A\0A;;; call/cc, restricted to ESCAPE continuations (design D1).  %run-guarded pushes a\0A;;; runtime escape frame and runs the thunk; %escape-frame reads that frame's id\0A;;; (innermost = ours, since nothing has been pushed since); %escape-to delivers a\0A;;; value to it.  %escape-to returns #f ONLY when no live frame carries the id --\0A;;; the capturing call has returned -- which is a diagnostic, not a jump into a dead\0A;;; frame.  Re-entrant continuations are rung 4 and are not supported.\0A(define (call-with-current-continuation f)\0A  (let ((saved-winds *winds*))\0A    (cdr (%run-guarded\0A          (lambda ()\0A            (let ((id (%escape-frame)))\0A              (f (lambda (v)\0A                   ;; Liveness FIRST.  Unwinding to a dead continuation's depth would\0A                   ;; run the `after` thunks -- including the one that pops the very\0A                   ;; handler meant to report this error -- for a transfer that cannot\0A                   ;; happen.  When live, %escape-to does not return.\0A                   (if (%escape-live? id)\0A                       (begin (%unwind-to saved-winds) (%escape-to id v))\0A                       #f)\0A                   (error 'call/cc\0A                          \22continuation invoked outside its extent\22)))))))))\0A\0A(define (call/cc f) (call-with-current-continuation f))\0A\0A;;; Install HANDLER for the dynamic extent of THUNK, returning the thunk's value.\0A;;; The push/pop rides dynamic-wind, so an escape out of the thunk restores the\0A;;; chain for free.  This IS R7RS 6.11's `with-exception-handler` -- same signature,\0A;;; same semantics -- and it is spelled that way rather than `%\E2\80\A6` because `guard`'s\0A;;; template calls it in the IMPORTER's scope, so the name is published either way\0A;;; (change: scheme-base-declared-surface, issue #29); publishing the R7RS spelling\0A;;; is a conformance gain instead of an internal leak.  `raise-continuable` is still\0A;;; absent: a handler that returns normally falls through to the unhandled path.\0A(define (with-exception-handler handler thunk)\0A  (let ((saved *handlers*))\0A    (dynamic-wind\0A      (lambda () (set! *handlers* (cons handler saved)))\0A      thunk\0A      (lambda () (set! *handlers* saved)))))\0A\0A;;; raise any object: call the current handler with the chain popped to the outer\0A;;; one, per R7RS.  A handler for `raise` must not return -- `guard`'s escapes -- so\0A;;; a normal return falls through to the unhandled path.  With no handler at all,\0A;;; %raise renders and aborts exactly as before.\0A(define (raise obj)\0A  (if (null? *handlers*)\0A      (%raise obj)\0A      (let ((h (car *handlers*)) (saved *handlers*))\0A        (set! *handlers* (cdr *handlers*))\0A        (h obj)\0A        (set! *handlers* saved)\0A        (%raise obj))))\0A\0A;;; R7RS error-object accessors over the runtime error-object representation.\0A(define (error-object? x) (%error-object? x))\0A(define (error-object-message x) (%error-object-message x))\0A(define (error-object-irritants x) (%error-object-irritants x))\0A\0A;;; guard: evaluate BODY; if it raises, bind the object to VAR and run the clauses\0A;;; as a `cond` in the guard's continuation.  No matching clause (and no else)\0A;;; re-raises outward.  This is R7RS's own shape (change: dynamic-extent, design\0A;;; D4): `guard` is not a mechanism of its own -- it installs a HANDLER that escapes\0A;;; to the guard's continuation, so the intervening dynamic-wind `after` thunks run\0A;;; on the ordinary escape path.\0A;;;\0A;;; DEVIATION (recorded): R7RS reraises a non-matching guard \22within the dynamic\0A;;; environment of the original call to raise\22.  That needs re-entering a\0A;;; continuation whose extent has ended (rung 4); here the reraise happens in the\0A;;; GUARD's dynamic environment, so `after` thunks between the raise point and the\0A;;; guard have already run and do not run again.\0A(define-syntax guard\0A  (syntax-rules ()\0A    ((_ (var clause ...) body ...)\0A     (let ((%gres\0A            (call-with-current-continuation\0A              (lambda (%gk)\0A                (with-exception-handler\0A                  (lambda (%gobj) (%gk (cons #t %gobj)))\0A                  (lambda () (cons #f (begin body ...))))))))\0A       (if (car %gres)\0A           (let ((var (cdr %gres))) (%guard-clauses var clause ...))\0A           (cdr %gres))))))\0A\0A(define-syntax %guard-clauses\0A  (syntax-rules (else =>)\0A    ((_ v) (raise v))                                              ; no clause matched\0A    ((_ v (else e ...)) (begin e ...))\0A    ((_ v (test => proc) rest ...) (let ((gt test)) (if gt (proc gt) (%guard-clauses v rest ...))))\0A    ((_ v (test) rest ...) (let ((gt test)) (if gt gt (%guard-clauses v rest ...))))\0A    ((_ v (test e ...) rest ...) (if test (begin e ...) (%guard-clauses v rest ...)))))\0A\0A;;; --- parameter objects (change: dynamic-extent, design D3) -----------------\0A;;; A parameter is a closure over a one-slot cell.  R7RS specifies the object as\0A;;; callable with ZERO arguments returning its value, which is what makes it\0A;;; substitutable for a plain accessor procedure at any call site.  The one- and\0A;;; two-argument forms are internal to `parameterize`: one argument converts and\0A;;; sets (a new binding), two restore a previously converted value unconverted.\0A(define (make-parameter init . conv)\0A  (let ((convert (if (null? conv) (lambda (x) x) (car conv)))\0A        (cell (%make-vector 1 0)))\0A    (%vector-set! cell 0 ((if (null? conv) (lambda (x) x) (car conv)) init))\0A    (lambda args\0A      (if (null? args)\0A          (%vector-ref cell 0)\0A          (if (null? (cdr args))\0A              (%vector-set! cell 0 (convert (car args)))\0A              (%vector-set! cell 0 (car args)))))))\0A\0A;;; parameterize rides dynamic-wind, so restoration on a normal exit, on an escape,\0A;;; and on a raise all come from one place (design D3).  Unsigiled and published as an\0A;;; EXTENSION (R7RS has no name for it): `parameterize`'s template calls it in the\0A;;; importer's scope, so it is exported either way (change:\0A;;; scheme-base-declared-surface, issue #29), and an honest 3-line procedure taking\0A;;; (params vals thunk) is better than a `%`-name that pretends to be private.\0A(define (with-parameters params vals thunk)\0A  (let ((olds (map (lambda (p) (p)) params)))\0A    (dynamic-wind\0A      (lambda () (for-each (lambda (p v) (p v)) params vals))\0A      thunk\0A      (lambda () (for-each (lambda (p v) (p v #f)) params olds)))))\0A\0A(define-syntax parameterize\0A  (syntax-rules ()\0A    ((_ ((p v) ...) body ...)\0A     (with-parameters (list p ...) (list v ...) (lambda () body ...)))))\0A\0A;;; --- vector constructors (vectors change) ---------------------------------\0A;;; make-vector/vector-ref/vector-set!/vector-length/vector? are primitives;\0A;;; the variadic constructor and list conversion are prelude Scheme over them.\0A(define (list->vector xs)\0A  (let ([v (make-vector (length xs) 0)])\0A    (let loop ([xs xs] [i 0])\0A      (if (null? xs)\0A          v\0A          (begin (vector-set! v i (car xs)) (loop (cdr xs) (+ i 1)))))))\0A(define (vector . xs) (list->vector xs))\0A\0A(define (list->bytevector bs)\0A  (let ([bv (make-bytevector (length bs) 0)])\0A    (let loop ([bs bs] [i 0])\0A      (if (null? bs)\0A          bv\0A          (begin (bytevector-u8-set! bv i (car bs)) (loop (cdr bs) (+ i 1)))))))\0A(define (bytevector . bs) (list->bytevector bs))\0A\0A;; --- multiple values (openspec multiple-values): values / call-with-values ---\0A;; A distinguished bundle carries 0 or >=2 values; exactly one value is returned\0A;; as itself (identity), so ordinary single-value code is untouched.  The bundle\0A;; is a disjoint HDR_MV wrapper (%list->mv) that only call-with-values consumes,\0A;; spreading it into the consumer via the existing `apply` -- so `(map ...)` and\0A;; `(apply consumer ...)` both work with no calling-convention change.\0A(define (values . vs)\0A  (if (and (pair? vs) (null? (cdr vs)))\0A      (car vs)                 ; exactly one value -> identity\0A      (%list->mv vs)))         ; zero or >=2 values -> a bundle carrying the list\0A(define (call-with-values producer consumer)\0A  (let ([r (producer)])\0A    (if (%mv? r)\0A        (apply consumer (%mv->list r))\0A        (consumer r))))\0A\0A;; --- hash tables (openspec hash-tables): SRFI-69 subset, equal?-keyed --------\0A;; Built on vectors + the %hash primitive.  A table is an opaque HDR_HASHTABLE\0A;; wrapper (%make-hash-table) around a mutable spine vector #(count buckets _);\0A;; `buckets` is a vector of association lists ((key . val) ...).  Pairs are\0A;; immutable here, so an existing key is updated by rebuilding its bucket alist\0A;; (drop the old entry, prepend the new one).  The table grows (rehashes into\0A;; ~2x buckets) once count/nbuckets exceeds the load factor, keeping lookup\0A;; amortized O(1).  %hash need only be CONSISTENT with equal? (the bucket scan\0A;; below is the source of truth), so collisions are merely slow, never wrong.\0A(define %ht-initial-buckets 8)\0A(define %ht-load-factor 3)\0A\0A(define (make-hash-table)\0A  (%make-hash-table (vector 0 (make-vector %ht-initial-buckets (quote ())) #f)))\0A(define (hash-table? x) (%hash-table? x))\0A\0A(define (%ht-count ht)        (vector-ref (%hash-table-spine ht) 0))\0A(define (%ht-buckets ht)      (vector-ref (%hash-table-spine ht) 1))\0A(define (%ht-set-count! ht n) (vector-set! (%hash-table-spine ht) 0 n))\0A(define (%ht-set-buckets! ht b) (vector-set! (%hash-table-spine ht) 1 b))\0A\0A;; %hash is non-negative and nbuckets positive, so remainder == modulo here.\0A(define (%ht-index key nbuckets) (remainder (%hash key) nbuckets))\0A\0A;; the (key . val) pair for an equal? key in an alist, or #f\0A(define (%ht-assoc key al)\0A  (if (null? al) #f\0A      (if (equal? key (car (car al))) (car al) (%ht-assoc key (cdr al)))))\0A;; the alist with the (first) equal? key removed\0A(define (%ht-remove key al)\0A  (if (null? al) (quote ())\0A      (if (equal? key (car (car al)))\0A          (cdr al)\0A          (cons (car al) (%ht-remove key (cdr al))))))\0A\0A(define (hash-table-ref/default ht key default)\0A  (let* ((bs (%ht-buckets ht))\0A         (p (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs))))))\0A    (if p (cdr p) default)))\0A\0A(define (hash-table-contains? ht key)\0A  (let ((bs (%ht-buckets ht)))\0A    (if (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs)))) #t #f)))\0A\0A(define (hash-table-ref ht key)\0A  (let* ((bs (%ht-buckets ht))\0A         (p (%ht-assoc key (vector-ref bs (%ht-index key (vector-length bs))))))\0A    (if p (cdr p) (error \22hash-table-ref: key not found\22 key))))\0A\0A(define (hash-table-set! ht key val)\0A  (let* ((bs (%ht-buckets ht))\0A         (n (vector-length bs))\0A         (i (%ht-index key n))\0A         (al (vector-ref bs i))\0A         (existed (%ht-assoc key al)))\0A    (vector-set! bs i (cons (cons key val) (if existed (%ht-remove key al) al)))\0A    (if existed\0A        #f\0A        (begin\0A          (%ht-set-count! ht (+ (%ht-count ht) 1))\0A          (if (> (%ht-count ht) (* %ht-load-factor n)) (%ht-grow! ht) #f)))))\0A\0A(define (hash-table-delete! ht key)\0A  (let* ((bs (%ht-buckets ht))\0A         (i (%ht-index key (vector-length bs)))\0A         (al (vector-ref bs i)))\0A    (if (%ht-assoc key al)\0A        (begin (vector-set! bs i (%ht-remove key al))\0A               (%ht-set-count! ht (- (%ht-count ht) 1)))\0A        #f)))\0A\0A;; reinsert every entry into a ~2x bucket vector, recomputing each index\0A(define (%ht-grow! ht)\0A  (let* ((old (%ht-buckets ht))\0A         (newn (* 2 (vector-length old)))\0A         (newb (make-vector newn (quote ()))))\0A    (let loop ((i 0))\0A      (if (< i (vector-length old))\0A          (begin\0A            (let bloop ((al (vector-ref old i)))\0A              (if (null? al) #f\0A                  (let* ((kv (car al)) (j (%ht-index (car kv) newn)))\0A                    (vector-set! newb j (cons kv (vector-ref newb j)))\0A                    (bloop (cdr al)))))\0A            (loop (+ i 1)))\0A          #f))\0A    (%ht-set-buckets! ht newb)))\0A\0A(define (hash-table-size ht) (%ht-count ht))\0A\0A(define (%ht-fold-buckets al acc)\0A  (if (null? al) acc\0A      (cons (cons (car (car al)) (cdr (car al))) (%ht-fold-buckets (cdr al) acc))))\0A(define (hash-table->alist ht)\0A  (let ((bs (%ht-buckets ht)))\0A    (let loop ((i 0) (acc (quote ())))\0A      (if (< i (vector-length bs))\0A          (loop (+ i 1) (%ht-fold-buckets (vector-ref bs i) acc))\0A          acc))))\0A(define (hash-table-keys ht) (map car (hash-table->alist ht)))\0A(define (hash-table-values ht) (map cdr (hash-table->alist ht)))\0A\0A;;; --- reader (scheme-reader): read-from-string source text -> datum --------\0A;;; Recursive descent over a string; the scan position is threaded functionally\0A;;; as (datum . next-index) pairs.  Characters are classified by codepoint\0A;;; (char->integer) because char literals are not interned (so eq? on them does\0A;;; not hold).  v1 reads integers, symbols, lists, #t/#f, #\5Cchar, \22strings\22\0A;;; (no escapes), 'quote and `/,/,@ quasiquote sugar, skipping whitespace and\0A;;; ; line comments.\0A\0A(define (rd-ws? c)                       ; space, tab, newline, return\0A  (let ([k (char->integer c)])\0A    (or (= k 32) (or (= k 9) (or (= k 10) (= k 13))))))\0A(define (rd-digit? c)\0A  (let ([k (char->integer c)]) (and (< 47 k) (< k 58))))   ; '0'..'9'\0A(define (rd-delim? c)                    ; ends a token: ws or ( ) [ ] \22 ;\0A  (let ([k (char->integer c)])\0A    (or (rd-ws? c)\0A        (or (= k 40) (or (= k 41) (or (= k 91) (or (= k 93)\0A        (or (= k 34) (= k 59)))))))))\0A\0A;;; --- how the reader reports (change: reader-lexical-conformance, design D2) --\0A;;; An rd-* procedure cannot RAISE.  The whole reader is homed in (emit internal),\0A;;; and design D10 of scheme-base-partition keeps `error`/`raise`/`*handlers*` out of\0A;;; the substrate -- duplicating the handler chain would split it, so a `guard` around\0A;;; a reader error would stop catching it.  Every rd-* procedure is therefore total:\0A;;; it returns an index or a (datum . index) pair, never a condition.\0A;;;\0A;;; A construct that cannot be completed or read travels outward as a NEGATIVE index.\0A;;; No valid position is negative, so the `(< i n)` test that already guards every scan\0A;;; rejects it, and the ENTRY POINTS -- read-from-string, read-all-from-string, and\0A;;; (scheme read)'s `read`, which live where `error` does -- turn it into an error.  A\0A;;; consumer that needs a different answer from the same signal gives one: the REPL's\0A;;; input-completeness probe maps it to \22incomplete -- keep typing\22.\0A;;;\0A;;; The sentinel CARRIES the position the construct opened at, so the message can name\0A;;; it (and can re-extract the offending token from the source text): position p encodes\0A;;; as -3 - p.  -1 and -2 stay unused here, which is what lets the probe keep its own\0A;;; fc-incomplete/fc-malformed codes in the same integer channel (src/repl-core.ss).\0A;;; A failing rd-* result is (REASON . sentinel) -- the pair shape every rd-* returns,\0A;;; with a symbol in place of the datum saying what went wrong.\0A(define (rd-fail-code p) (- -3 p))       ; opened at p -> the sentinel index\0A(define (rd-fail? i) (< i 0))\0A(define (rd-fail-pos i) (- (- 0 i) 3))   ; the sentinel index -> the position\0A(define (rd-fail why p) (cons why (rd-fail-code p)))\0A\0A(define (rd-skip-line s n i)             ; index just past the next newline (or n)\0A  (if (< i n)\0A      (if (= (char->integer (string-ref s i)) 10) (+ i 1) (rd-skip-line s n (+ i 1)))\0A      i))\0A;;; #| ... |# NESTS (R7RS 7.1.2): the first |# closes only the innermost open block, so\0A;;; this counts depth rather than scanning for the first close.  p is where the OUTERMOST\0A;;; #| opened, and is what an unterminated comment reports.\0A(define (rd-block-open? s n i)           ; \22#|\22 begins at i\0A  (and (= (char->integer (string-ref s i)) 35)\0A       (< (+ i 1) n)\0A       (= (char->integer (string-ref s (+ i 1))) 124)))\0A(define (rd-skip-block s n i d p)        ; inside a block comment at depth d\0A  (if (< (+ i 1) n)\0A      (let ([a (char->integer (string-ref s i))]\0A            [b (char->integer (string-ref s (+ i 1)))])\0A        (cond\0A          [(and (= a 124) (= b 35))                         ; |#  closes one level\0A           (if (= d 1) (+ i 2) (rd-skip-block s n (+ i 2) (- d 1) p))]\0A          [(and (= a 35) (= b 124))                         ; #|  opens another\0A           (rd-skip-block s n (+ i 2) (+ d 1) p)]\0A          [else (rd-skip-block s n (+ i 1) d p)]))\0A      (rd-fail-code p)))\0A;;; A block comment is WHITESPACE (design D1), so it is skipped here rather than\0A;;; dispatched as a datum -- which makes it work everywhere whitespace already works\0A;;; and gives the REPL probe the same answer for free, since the probe shares this\0A;;; helper.  (`#;` cannot live here: discarding a datum needs a full recursive read.)\0A(define (rd-skip-ws s n i)               ; next index that is not ws or a comment\0A  (if (and (<= 0 i) (< i n))\0A      (let ([c (string-ref s i)])\0A        (cond\0A          [(rd-ws? c) (rd-skip-ws s n (+ i 1))]\0A          [(= (char->integer c) 59) (rd-skip-ws s n (rd-skip-line s n (+ i 1)))]\0A          [(rd-block-open? s n i)\0A           (let ([j (rd-skip-block s n (+ i 2) 1 i)])\0A             (if (rd-fail? j) j (rd-skip-ws s n j)))]\0A          [else i]))\0A      i))\0A\0A(define (rd-token-end s n i)             ; first delimiter index >= i (or n)\0A  (if (< i n)\0A      (if (rd-delim? (string-ref s i)) i (rd-token-end s n (+ i 1)))\0A      i))\0A\0A(define (rd-all-digits? tok a m)\0A  (if (< a m) (if (rd-digit? (string-ref tok a)) (rd-all-digits? tok (+ a 1) m) #f) #t))\0A(define (rd-numeric? tok)                ; optional +/- then >=1 digits\0A  (let ([m (string-length tok)])\0A    (and (< 0 m)\0A         (let ([c0 (char->integer (string-ref tok 0))])\0A           (cond\0A             [(rd-digit? (string-ref tok 0)) (rd-all-digits? tok 0 m)]\0A             [(or (= c0 45) (= c0 43)) (and (< 1 m) (rd-all-digits? tok 1 m))]\0A             [else #f])))))\0A(define (rd-digits tok a m acc)\0A  (if (< a m)\0A      (rd-digits tok (+ a 1) m (+ (* acc 10) (- (char->integer (string-ref tok a)) 48)))\0A      acc))\0A;;; A negative literal accumulates DOWNWARD rather than being built positive and\0A;;; negated (change: fixnum-overflow-trap).  The fixnum range is asymmetric --\0A;;; -2^60 is representable but +2^60 is not -- so the old (- 0 (rd-digits ...))\0A;;; formed an out-of-range positive for the most negative fixnum and got the right\0A;;; answer only because it wrapped twice.  Now that overflow traps, that literal\0A;;; would be unreadable.  Accumulating negatively never leaves the range for any\0A;;; in-range literal, and an out-of-range one still traps in the same `*`/`-` the\0A;;; positive side traps in.  `ns-digits` (number->string) and `fixnum-word`\0A;;; (src/emit.ss) already avoid negating for exactly this reason.\0A(define (rd-digits-neg tok a m acc)\0A  (if (< a m)\0A      (rd-digits-neg tok (+ a 1) m (- (* acc 10) (- (char->integer (string-ref tok a)) 48)))\0A      acc))\0A(define (rd-parse-int tok)\0A  (let ([m (string-length tok)] [c0 (char->integer (string-ref tok 0))])\0A    (cond\0A      [(= c0 45) (rd-digits-neg tok 1 m 0)]\0A      [(= c0 43) (rd-digits tok 1 m 0)]\0A      [else (rd-digits tok 0 m 0)])))\0A\0A;;; --- inexact real (flonum) literal recognition (change: inexact-numbers) ----\0A;;; A flonum token is  [sign] ( digits [. digits] | . digits ) [exp]  with at\0A;;; least one digit AND at least one of a dot or an exponent (a pure-digit token\0A;;; is an integer, matched by rd-numeric?).  exp = (e|E) [sign] >=1 digits.  This\0A;;; only CLASSIFIES the token; the value parse is the runtime strtod (correctly\0A;;; rounded, so it round-trips with the flonum printer) via %string->flonum.\0A(define (rd-dotchar? c) (= (char->integer c) 46))                         ; the char .\0A(define (rd-exp-char? c) (let ([k (char->integer c)]) (or (= k 101) (= k 69))))  ; e E\0A(define (rd-sign-char? c) (let ([k (char->integer c)]) (or (= k 43) (= k 45))))  ; + -\0A(define (rd-scan-digits tok a m)         ; index just past a run of >=0 digits\0A  (if (and (< a m) (rd-digit? (string-ref tok a))) (rd-scan-digits tok (+ a 1) m) a))\0A(define (rd-flonum? tok)\0A  (let ([m (string-length tok)])\0A    (and (< 0 m)\0A      (let ([i0 (if (rd-sign-char? (string-ref tok 0)) 1 0)])\0A        (let ([i1 (rd-scan-digits tok i0 m)])            ; past integer digits\0A          (let ([i2 (if (and (< i1 m) (rd-dotchar? (string-ref tok i1))) (+ i1 1) i1)])\0A            (let ([had-dot (< i1 i2)])\0A              (let ([i3 (rd-scan-digits tok i2 m)])       ; past fraction digits\0A                (and (or (< i0 i1) (< i2 i3))             ; at least one digit\0A                     (let ([i4 (if (and (< i3 m) (rd-exp-char? (string-ref tok i3)))\0A                                   (let ([i5 (if (and (< (+ i3 1) m)\0A                                                      (rd-sign-char? (string-ref tok (+ i3 1))))\0A                                                 (+ i3 2) (+ i3 1))])\0A                                     (let ([i6 (rd-scan-digits tok i5 m)])\0A                                       (if (< i5 i6) i6 -1)))   ; exponent needs >=1 digit\0A                                   i3)])\0A                       (and (< -1 i4)                     ; valid (or no) exponent\0A                            (= i4 m)                      ; consumed the whole token\0A                            (or had-dot (< i3 i4)))))))))))))   ; a dot OR an exponent\0A\0A;;; The three non-finite tokens (change: numeric-conformance, design D8 / GitHub\0A;;; issue #25).  The PRINTER has always emitted these -- (/ 1.0 0.0) prints as\0A;;; +inf.0 -- but rd-flonum? requires at least one digit, so they fell through to\0A;;; string->symbol and a program could not read back its own output: write/read\0A;;; silently turned a number into an identifier.  They are exact literal strings, so\0A;;; recognizing them costs one comparison ahead of the classifier.  %string->flonum\0A;;; is strtod, which reads \22inf\22/\22nan\22 (and stops before the \22.0\22), so the VALUES\0A;;; come from the same converter as every other inexact literal rather than from\0A;;; arithmetic like (/ 1.0 0.0) that would depend on the host's division.\0A(define (rd-nonfinite tok)               ; the value, or #f if not one of the three\0A  (cond [(string=? tok \22+inf.0\22) (%string->flonum \22inf\22)]\0A        [(string=? tok \22-inf.0\22) (%string->flonum \22-inf\22)]\0A        [(string=? tok \22+nan.0\22) (%string->flonum \22nan\22)]\0A        [else #f]))\0A\0A;;; --- one numeric grammar, entered from two places (design D3) --------------\0A;;; R7RS 6.2.5 lets a number literal carry at most one RADIX prefix (#b #o #d #x) and\0A;;; at most one EXACTNESS prefix (#e #i), in either order and either case.  The scanner\0A;;; below peels them off and hands the body to the classifiers that already exist --\0A;;; rd-numeric?/rd-parse-int, rd-nonfinite, rd-flonum?/%string->flonum, %string->int --\0A;;; so no second numeric grammar appears.  Both entry points feed it: rd-atom/rd-hash\0A;;; for the reader and `string->number` for the procedure, which is what makes \22any\0A;;; token the reader accepts as a number is accepted there identically\22 true by\0A;;; construction rather than by review.\0A;;;\0A;;; rd-number answers the VALUE or one of three reason symbols, because the substrate\0A;;; cannot raise (see rd-fail above) and `string->number` must not raise at all -- R7RS\0A;;; 6.2.6 has it answer #f exactly where the reader reports:\0A;;;\0A;;;   rd-not-a-number  not numeric syntax -- the reader interns it as a symbol\0A;;;   rd-rational      n/m rational literal syntax, which Emit does not represent (D4)\0A;;;   rd-bad-number    prefixed, but the body does not fit the prefix (#x1.8, #b2, #foo)\0A(define (rd-radix-letter c)              ; #b #o #d #x -> the radix, else #f\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(or (= k 98) (= k 66)) 2]         ; b B\0A      [(or (= k 111) (= k 79)) 8]        ; o O\0A      [(or (= k 100) (= k 68)) 10]       ; d D\0A      [(or (= k 120) (= k 88)) 16]       ; x X\0A      [else #f])))\0A(define (rd-exactness-letter c)          ; #e -> 1 (exact), #i -> 2 (inexact), else #f\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(or (= k 101) (= k 69)) 1]        ; e E\0A      [(or (= k 105) (= k 73)) 2]        ; i I\0A      [else #f])))\0A;;; -> (RADIX EXACTNESS . BODY-INDEX), with #f for an absent prefix; or #f overall when\0A;;; a prefix is malformed or repeated (#x#x1, #q1, a token that is only \22#\22).\0A(define (rd-scan-prefixes t m i r x)\0A  (if (and (< i m) (= (char->integer (string-ref t i)) 35))\0A      (if (< (+ i 1) m)\0A          (let ([nr (rd-radix-letter (string-ref t (+ i 1)))])\0A            (if nr\0A                (if r #f (rd-scan-prefixes t m (+ i 2) nr x))\0A                (let ([nx (rd-exactness-letter (string-ref t (+ i 1)))])\0A                  (if nx\0A                      (if x #f (rd-scan-prefixes t m (+ i 2) r nx))\0A                      #f))))\0A          #f)\0A      (cons r (cons x i))))\0A(define (rd-radix-scan t m i r)          ; index past a run of >=0 radix-r digits\0A  (if (and (< i m) (%digit-in-radix (string-ref t i) r))\0A      (rd-radix-scan t m (+ i 1) r)\0A      i))\0A;;; Rational literal SYNTAX: [sign] digits / digits, spanning the WHOLE body.  Spanning\0A;;; the whole body -- and requiring a digit before the slash -- is what leaves ordinary\0A;;; symbols with slashes in them alone: `call/cc` has no radix-10 digit where it would\0A;;; need one.  Whether the VALUE is representable is deliberately not asked (design D4).\0A(define (rd-rational-body? t m i r)\0A  (let ([i0 (if (and (< i m) (rd-sign-char? (string-ref t i))) (+ i 1) i)])\0A    (let ([i1 (rd-radix-scan t m i0 r)])\0A      (and (< i0 i1)\0A           (< i1 m)\0A           (= (char->integer (string-ref t i1)) 47)                    ; /\0A           (let ([i2 (rd-radix-scan t m (+ i1 1) r)])\0A             (and (< (+ i1 1) i2) (= i2 m)))))))\0A;;; #i is total -- every value this reader produces has an inexact image.  #e is not: it\0A;;; is exact only where the value is integral, so `#e0.5` names an exact number Emit does\0A;;; not represent and is reported on the same grounds as `1/2` (design D4).\0A(define (rd-exactness-apply v x)         ; x: #f none, 1 exact, 2 inexact\0A  (cond\0A    [(not x) v]\0A    [(= x 2) (exact->inexact v)]\0A    [(exact? v) v]\0A    [(= v (%flo-truncate v)) (inexact->exact v)]\0A    [else (quote rd-rational)]))\0A(define (rd-body-number body r x)\0A  (if (= r 10)\0A      ;; radix 10 is the reader's own classifier chain.  The two cheap classifiers run\0A      ;; first and rd-nonfinite's three string comparisons last, so an ordinary integer\0A      ;; or decimal pays nothing for them; a non-finite token matches neither classifier\0A      ;; (rd-flonum? needs a digit), so the order is safe as well as cheaper.\0A      (cond\0A        [(rd-numeric? body) (rd-exactness-apply (rd-parse-int body) x)]\0A        [(rd-flonum? body) (rd-exactness-apply (%string->flonum body) x)]\0A        [else\0A         (let ([nf (rd-nonfinite body)])\0A           (cond\0A             [(not nf) (quote rd-not-a-number)]\0A             ;; #e+inf.0 names no exact number; #i+inf.0 and a bare +inf.0 are fine.\0A             [(and x (= x 1)) (quote rd-bad-number)]\0A             [else (rd-exactness-apply nf x)]))])\0A      ;; every other radix is integers only: a decimal point or an exponent is radix-10\0A      ;; syntax, so `#x1.8` is invalid number syntax rather than an identifier.\0A      (let ([v (%string->int body r)])\0A        (if v (rd-exactness-apply v x) (quote rd-not-a-number)))))\0A;;; The CLASSIFIERS run first and the rational-syntax scan only on their failure.  A token\0A;;; any classifier accepts holds no slash, so asking about rational syntax first cannot\0A;;; change the answer -- it only puts a redundant digit scan in front of every integer the\0A;;; compiler reads of its own source.  (Measured: the ordering is worth ~10% of reader\0A;;; time under the Chez-hosted host and is inside the noise on the self-hosted one, where\0A;;; per-call overhead dominates a short scan -- PERFORMANCE.md P5.  It is kept for the\0A;;; argument above rather than for the measurement.)\0A(define (rd-number t r0)                 ; token text (prefixes included) -> value/reason\0A  (let ([m (string-length t)])\0A    (if (and (< 0 m) (= (char->integer (string-ref t 0)) 35))\0A        ;; PREFIXED.  Only this path scans and allocates, and the token dispatch already\0A        ;; separated it out, so the ordinary token below pays nothing for it.\0A        (let ([p (rd-scan-prefixes t m 0 #f #f)])\0A          (if (not p)\0A              (quote rd-bad-number)\0A              (let ([r (if (car p) (car p) r0)] [x (cadr p)] [b (cddr p)])\0A                (let ([v (rd-body-number (substring t b m) r x)])\0A                  (if (eq? v (quote rd-not-a-number))\0A                      ;; a token that CARRIED a prefix and no classifier took is either\0A                      ;; rational syntax or simply broken; either way it is reported,\0A                      ;; never interned.\0A                      (if (rd-rational-body? t m b r)\0A                          (quote rd-rational)\0A                          (quote rd-bad-number))\0A                      v)))))\0A        (let ([v (rd-body-number t r0 #f)])\0A          (if (eq? v (quote rd-not-a-number))\0A              (if (rd-rational-body? t m 0 r0) (quote rd-rational) v)\0A              v)))))\0A(define (rd-number-reason? v)\0A  (or (eq? v (quote rd-rational)) (eq? v (quote rd-bad-number))))\0A\0A;;; --- case folding, during tokenization (change: reader-token-path, design D1) ---\0A;;; `include-ci` folds symbol case.  It used to do that by walking the forms the reader\0A;;; had already RETURNED (library-include-declarations design D6), which cannot be right:\0A;;; by then `|MixedCase|` and `MixedCase` are the same interned symbol, so the fold hit\0A;;; both and R7RS 7.1.1 -- the characters between the bars are the name, literally -- was\0A;;; violated on every bar-quoted identifier (GitHub issue #61).\0A;;;\0A;;; So the fold moved HERE, where the bars are still visible.  The mechanism is entirely\0A;;; negative space: the CI flag is threaded down the descent to rd-atom and is not passed\0A;;; to `rd-bar`, so a bar-quoted name has nothing to fold it.  It is applied on rd-atom's\0A;;; SYMBOL arm only, after the token has been classified, so a fold can never reach the\0A;;; text a number is parsed from.\0A;;;\0A;;; ASCII only: the substrate carries no Unicode case tables (there is no char-downcase\0A;;; in this file).  The Chez driver's door folds with Chez's own `case-sensitive`, which\0A;;; DOES fold Unicode, so the two hosts agree on ASCII and diverge above it -- a recorded\0A;;; limit (design D4), pinned by an ASCII fixture rather than by construction.\0A(define (rd-fold-char c)                 ; ASCII A-Z -> a-z, everything else unchanged\0A  (let ([k (char->integer c)])\0A    (if (and (< 64 k) (< k 91)) (integer->char (+ k 32)) c)))\0A(define (rd-fold-token tok)\0A  (let ([m (string-length tok)])\0A    (let loop ([i 0] [acc (quote ())])\0A      (if (= i m)\0A          (list->string (reverse acc))\0A          (loop (+ i 1) (cons (rd-fold-char (string-ref tok i)) acc))))))\0A\0A(define (rd-atom s n i ci)               ; token -> number, interned symbol, or a report\0A  (let ([j (rd-token-end s n i)])\0A    (if (= i j)\0A        ;; An EMPTY token: the character here is a delimiter no datum arm claimed.  It\0A        ;; used to intern the empty symbol and return i unchanged, which spun rd-list\0A        ;; forever; reporting it is what makes `#;` before a closing paren terminate.\0A        (rd-fail (quote rd-unexpected) i)\0A        (let ([tok (substring s i j)])\0A          (let ([v (rd-number tok 10)])\0A            (cond\0A              [(eq? v (quote rd-not-a-number))\0A               (cons (string->symbol (if ci (rd-fold-token tok) tok)) j)]\0A              [(rd-number-reason? v) (rd-fail v i)]\0A              [else (cons v j)]))))))\0A\0A;;; The token a sentinel position points at, so a report can name what it read.\0A(define (rd-token-at s n p)\0A  (if (and (<= 0 p) (< p n)) (substring s p (rd-token-end s n (+ p 1))) \22\22))\0A\0A(define (rd-hex-digit c)                 ; hex char -> value (0 for non-hex)\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(and (< 47 k) (< k 58)) (- k 48)]      ; 0-9\0A      [(and (< 96 k) (< k 103)) (- k 87)]     ; a-f\0A      [(and (< 64 k) (< k 71)) (- k 55)]      ; A-F\0A      [else 0])))\0A(define (rd-hex s n i acc)               ; \5CxHH...; -> (codepoint . index-past-;)\0A  (if (< i n)\0A      (if (= (char->integer (string-ref s i)) 59)     ; ;\0A          (cons acc (+ i 1))\0A          (rd-hex s n (+ i 1) (+ (* acc 16) (rd-hex-digit (string-ref s i)))))\0A      (cons acc i)))\0A(define (rd-str-esc c)                   ; escape letter -> the character it denotes\0A  (let ([k (char->integer c)])\0A    (cond\0A      [(= k 110) (integer->char 10)]     ; \5Cn\0A      [(= k 116) (integer->char 9)]      ; \5Ct\0A      [(= k 114) (integer->char 13)]     ; \5Cr\0A      [else c])))                        ; \5C\5C \5C\22 and any other: the char itself\0A(define (rd-string s n i)                ; i just past opening \22; decodes escapes\0A  (let loop ([i i] [acc (quote ())])\0A    (if (< i n)\0A        (let* ([c (string-ref s i)] [k (char->integer c)])\0A          (cond\0A            [(= k 34) (cons (list->string (reverse acc)) (+ i 1))]        ; closing \22\0A            [(= k 92)                                                     ; backslash escape\0A             (let ([e (string-ref s (+ i 1))])\0A               (if (= (char->integer e) 120)                             ; \5CxHH;\0A                   (let ([hx (rd-hex s n (+ i 2) 0)])\0A                     (loop (cdr hx) (cons (integer->char (car hx)) acc)))\0A                   (loop (+ i 2) (cons (rd-str-esc e) acc))))]            ; \5Cn \5Ct \5Cr \5C\5C \5C\22\0A            [else (loop (+ i 1) (cons c acc))]))\0A        (cons (list->string (reverse acc)) i))))\0A\0A(define (rd-hash s n i ci)               ; i just past #\0A  (if (<= n i)\0A      (rd-fail (quote rd-eof) (- i 1))                     ; a lone trailing #\0A      (let ([k (char->integer (string-ref s i))])\0A        (cond\0A          [(= k 116) (cons #t (+ i 1))]                        ; #t\0A          [(= k 102) (cons #f (+ i 1))]                        ; #f\0A          [(= k 92) (rd-char s n i)]                           ; #\5C<char> or #\5C<name>\0A          ;; ci travels INTO a vector literal: a symbol inside #( ... ) is a symbol the\0A          ;; read produces, and the old shape-walking fold missed it (design D3).\0A          [(= k 40) (let ([r (rd-list s n (+ i 1) (quote ()) ci)])  ; #( ... ) -> vector\0A                      (if (rd-fail? (cdr r)) r (cons (list->vector (car r)) (cdr r))))]\0A          ;; #; -- DISCARD the next datum and read the one after it (design D1).  It\0A          ;; cannot be skipped as whitespace: throwing a datum away needs a full\0A          ;; recursive read, which rd-skip-ws neither does nor is allowed to fail at.\0A          ;; Stacking (#;#;a b c -> c) falls out of the recursion.\0A          [(= k 59)\0A           (let ([r (rd-datum s n (rd-skip-ws s n (+ i 1)) ci)])\0A             (if (rd-fail? (cdr r)) r (rd-datum s n (rd-skip-ws s n (cdr r)) ci)))]\0A          [(and (= k 117)                                        ; #u8( ... ) -> bytevector\0A                (< (+ i 2) n)\0A                (= (char->integer (string-ref s (+ i 1))) 56)    ; 8\0A                (= (char->integer (string-ref s (+ i 2))) 40))   ; (\0A           (let ([r (rd-list s n (+ i 3) (quote ()) ci)])\0A             (if (rd-fail? (cdr r)) r (cons (list->bytevector (car r)) (cdr r))))]\0A          ;; Everything else that begins with # is a PREFIXED NUMBER or nothing at all.\0A          ;; This arm used to fall through to string->symbol, which is what produced\0A          ;; `unbound variable x1f` for #x1f and `unbound variable |` for a block\0A          ;; comment (issues #25, #59); a # token that is not a recognized datum is now\0A          ;; reported, naming itself.\0A          [else (let ([j (rd-token-end s n i)])\0A                  (let ([v (rd-number (substring s (- i 1) j) 10)])\0A                    (if (rd-number-reason? v) (rd-fail v (- i 1)) (cons v j))))]))))\0A\0A(define (rd-char-name tok)               ; multi-char #\5C name -> character\0A  (cond\0A    [(string=? tok \22space\22)   (integer->char 32)]\0A    [(string=? tok \22newline\22) (integer->char 10)]\0A    [(string=? tok \22tab\22)     (integer->char 9)]\0A    [(string=? tok \22return\22)  (integer->char 13)]\0A    [(string=? tok \22nul\22)     (integer->char 0)]\0A    [(string=? tok \22null\22)    (integer->char 0)]\0A    [(string=? tok \22delete\22)  (integer->char 127)]\0A    [(string=? tok \22altmode\22) (integer->char 27)]\0A    [(string=? tok \22esc\22)     (integer->char 27)]\0A    [else (string-ref tok 0)]))          ; unknown name: first char (undefined per spec)\0A(define (rd-char s n i)                  ; i at '\5C' of #\5C ; content at i+1\0A  (let* ([cs (+ i 1)]\0A         [end (rd-token-end s n (+ cs 1))]   ; force the first content char in\0A         [tok (substring s cs end)])\0A    (if (= (string-length tok) 1)\0A        (cons (string-ref s cs) end)         ; single-character literal\0A        (cons (rd-char-name tok) end))))     ; named character\0A\0A;;; R7RS 7.1.1 bar-quoted identifier: | opens a name that runs to the matching |, with\0A;;; the \5C| and \5CxHH; escapes the standard gives it.  The result is an ORDINARY interned\0A;;; symbol -- R7RS says there is no distinct type, so (eq? '|foo| 'foo) is #t -- which\0A;;; makes this a new LEXEME, not a new value.  ( `|` is deliberately NOT added to\0A;;; rd-delim?: only a LEADING bar opens one, so a symbol like `a|b` still reads whole.)\0A(define (rd-bar s n i p)                 ; i just past the opening |, which was at p\0A  (let loop ([i i] [acc (quote ())])\0A    (if (< i n)\0A        (let ([c (string-ref s i)])\0A          (let ([k (char->integer c)])\0A            (cond\0A              [(= k 124) (cons (string->symbol (list->string (reverse acc))) (+ i 1))]\0A              [(and (= k 92) (< (+ i 1) n))                       ; backslash escape\0A               (let ([e (string-ref s (+ i 1))])\0A                 (if (= (char->integer e) 120)                    ; \5CxHH;\0A                     (let ([hx (rd-hex s n (+ i 2) 0)])\0A                       (loop (cdr hx) (cons (integer->char (car hx)) acc)))\0A                     (loop (+ i 2) (cons (rd-str-esc e) acc))))]  ; \5C| \5C\5C and the rest\0A              [else (loop (+ i 1) (cons c acc))])))\0A        (rd-fail (quote rd-bar) p))))\0A\0A(define (rd-quote s n i ci)              ; 'x -> (quote x)\0A  (let ([r (rd-datum s n (rd-skip-ws s n i) ci)])\0A    (if (rd-fail? (cdr r)) r (cons (list (quote quote) (car r)) (cdr r)))))\0A\0A(define (rd-quasi s n i ci)              ; `x -> (quasiquote x)\0A  (let ([r (rd-datum s n (rd-skip-ws s n i) ci)])\0A    (if (rd-fail? (cdr r)) r (cons (list (quote quasiquote) (car r)) (cdr r)))))\0A\0A(define (rd-unquote s n i ci)            ; ,x -> (unquote x); ,@x -> (unquote-splicing x)\0A  (if (and (< i n) (= (char->integer (string-ref s i)) 64))     ; @  -> splicing\0A      (let ([r (rd-datum s n (rd-skip-ws s n (+ i 1)) ci)])\0A        (if (rd-fail? (cdr r))\0A            r\0A            (cons (list (quote unquote-splicing) (car r)) (cdr r))))\0A      (let ([r (rd-datum s n (rd-skip-ws s n i) ci)])\0A        (if (rd-fail? (cdr r)) r (cons (list (quote unquote) (car r)) (cdr r))))))\0A\0A(define (rd-dot? s n j)                  ; a standalone `.` token at j (dotted-pair marker)\0A  (and (= (char->integer (string-ref s j)) 46)      ; .\0A       (= (rd-token-end s n (+ j 1)) (+ j 1))))      ; next char is a delimiter -> lone .\0A(define (rd-append-reverse acc tail)     ; (reverse acc) terminated by tail (improper list)\0A  (if (null? acc) tail (rd-append-reverse (cdr acc) (cons (car acc) tail))))\0A(define (rd-datum-comment? s n i)        ; \22#;\22 begins at i\0A  (and (= (char->integer (string-ref s i)) 35)\0A       (< (+ i 1) n)\0A       (= (char->integer (string-ref s (+ i 1))) 59)))\0A(define (rd-list s n i acc ci)           ; i after (; read until ) (supports . tail)\0A  (let ([j (rd-skip-ws s n i)])\0A    (cond\0A      [(rd-fail? j) (cons (quote rd-block-comment) j)]\0A      [(< j n)\0A       (cond\0A         [(let ([c (char->integer (string-ref s j))]) (or (= c 41) (= c 93)))\0A          (cons (reverse acc) (+ j 1))]                                            ; ) or ]\0A         ;; #; between elements -- including immediately before the closing paren,\0A         ;; where there is no following element for rd-datum's arm to return.\0A         [(rd-datum-comment? s n j)\0A          (let ([r (rd-datum s n (rd-skip-ws s n (+ j 2)) ci)])\0A            (if (rd-fail? (cdr r)) r (rd-list s n (cdr r) acc ci)))]\0A         [(rd-dot? s n j)                                                          ; . tail\0A          (let ([r (rd-datum s n (rd-skip-ws s n (+ j 1)) ci)])\0A            (if (rd-fail? (cdr r))\0A                r\0A                (let ([j2 (rd-skip-ws s n (cdr r))])\0A                  (if (rd-fail? j2)\0A                      (cons (quote rd-block-comment) j2)\0A                      (cons (rd-append-reverse acc (car r)) (+ j2 1))))))]          ; past )\0A         [else (let ([r (rd-datum s n j ci)])\0A                 (if (rd-fail? (cdr r)) r (rd-list s n (cdr r) (cons (car r) acc) ci)))])]\0A      [else (cons (reverse acc) j)])))\0A\0A(define (rd-datum s n i ci)              ; i at a non-ws char -> (datum . next)\0A  (if (and (<= 0 i) (< i n))\0A      (let ([k (char->integer (string-ref s i))])\0A        (cond\0A          [(= k 40) (rd-list s n (+ i 1) (quote ()) ci)]       ; (\0A          [(= k 91) (rd-list s n (+ i 1) (quote ()) ci)]       ; [ (brackets = parens)\0A          [(= k 39) (rd-quote s n (+ i 1) ci)]                 ; '\0A          [(= k 96) (rd-quasi s n (+ i 1) ci)]                 ; `\0A          [(= k 44) (rd-unquote s n (+ i 1) ci)]               ; ,\0A          [(= k 34) (rd-string s n (+ i 1))]                   ; \22\0A          [(= k 35) (rd-hash s n (+ i 1) ci)]                  ; #\0A          ;; NOT given ci: R7RS 7.1.1 makes the characters between the bars the symbol's\0A          ;; name literally, so a bar-quoted identifier is never folded (issue #61).\0A          [(= k 124) (rd-bar s n (+ i 1) i)]                   ; |bar quoted identifier|\0A          [(or (= k 41) (= k 93)) (rd-fail (quote rd-unexpected) i)]   ; a close with no open\0A          [else (rd-atom s n i ci)]))\0A      ;; A sentinel travelling outward (an unterminated block comment upstream), or a\0A      ;; datum the input ended before -- `#;` with nothing after it, say.  Neither is\0A      ;; raised here (design D2); the entry point reports.\0A      (if (< i 0) (cons (quote rd-block-comment) i) (rd-fail (quote rd-eof) i))))\0A\0A;;; --- where the reader's reports become errors (design D2) -------------------\0A;;; The lexeme layer answers a sentinel because it cannot raise; here `error` is in\0A;;; scope, so here is where the sentinel is turned into a diagnostic.  The position it\0A;;; carries is what lets the message name both WHERE and, by re-reading the token at\0A;;; that position, WHAT.  (`read` in (scheme read) needs this too and cannot import a\0A;;; private name, so it keeps its own copy -- the arrangement %check-input-port already\0A;;; has, for the same reason: this is the reader code that raises.)\0A(define (rd-report s n r)\0A  (let ([why (car r)] [p (rd-fail-pos (cdr r))])\0A    (cond\0A      [(eq? why (quote rd-block-comment))\0A       (error (quote read) \22unterminated block comment #| opened at index\22 p)]\0A      [(eq? why (quote rd-bar))\0A       (error (quote read) \22unterminated |identifier| opened at index\22 p)]\0A      [(eq? why (quote rd-eof))\0A       (error (quote read) \22end of input where a datum was expected, at index\22 p)]\0A      [(eq? why (quote rd-unexpected))\0A       (error (quote read) \22no datum here, at index\22 p)]\0A      [(eq? why (quote rd-rational))\0A       (error (quote read)\0A              (string-append \22rational literal syntax is not supported -- Emit has no \22\0A                             \22exact rationals; write 0.5, or (/ 1 2)\22)\0A              (rd-token-at s n p))]\0A      [else (error (quote read) \22unrecognized syntax\22 (rd-token-at s n p))])))\0A\0A(define (read-from-string s)\0A  (let ([n (string-length s)])\0A    (let ([r (rd-datum s n (rd-skip-ws s n 0) #f)])\0A      (if (rd-fail? (cdr r)) (rd-report s n r) (car r)))))\0A\0A;;; --- whole-program read (stdin-source-reader) -----------------------------\0A;;; Loop the single-datum reader across the whole source: skip inter-form\0A;;; whitespace/; comments, read a datum, continue from the next position, and\0A;;; stop at end of input.  Returns the top-level forms in source order (the empty\0A;;; list for empty or whitespace/comment-only input).  This is what a self-hosted\0A;;; core uses to turn its input text into the form list it compiles.\0A;;; TWO entry points over ONE worker, rather than one entry point with an optional\0A;;; argument (change: reader-token-path, design D1/D2).  An optional argument would cost\0A;;; every call site its cross-unit direct call (PERFORMANCE.md P9), and the ordinary read\0A;;; is the compiler's own hot path -- making every read pay for the rare folding one is\0A;;; backwards.  `-ci` is R7RS's spelling for case-insensitivity (string-ci=?, char-ci=?,\0A;;; and `include-ci`, which is what this exists for).\0A(define (read-all-from-string s) (rd-all s #f))\0A(define (read-all-from-string-ci s) (rd-all s #t))\0A\0A(define (rd-all s ci)\0A  (let ([n (string-length s)])\0A    (let loop ([i (rd-skip-ws s n 0)] [acc (quote ())])\0A      (cond\0A        ;; NOT end of input: an unterminated block comment here used to make every form\0A        ;; after the opening delimiter vanish with no diagnostic (issue #59).\0A        [(rd-fail? i) (rd-report s n (cons (quote rd-block-comment) i))]\0A        [(< i n)\0A         (let ([r (rd-datum s n i ci)])\0A           (if (rd-fail? (cdr r))\0A               (rd-report s n r)\0A               (loop (rd-skip-ws s n (cdr r)) (cons (car r) acc))))]\0A        [else (reverse acc)]))))\0A\0A;;; --- ports (change: scheme-io-library, design D1/D2) -----------------------\0A;;; A port is a RECORD over the existing record layer, so `port?` is\0A;;; `%record-of-type?` and a port is an ordinary first-class value -- no new heap\0A;;; header code, no printer/GC/equality teaching (design D1).\0A;;;\0A;;; FIELD LAYOUT.  Field 0 is a CONTRACT SHARED WITH THE RUNTIME: the\0A;;; port-directed output primitives (%display-port and friends) are handed the\0A;;; port record and read slot 0 as their handle, so the two-argument output forms\0A;;; stay bare primcalls with no Scheme wrapper on the path.  If this layout moves,\0A;;; `port_arg_stream` in src/runtime/runtime.c moves with it.\0A;;;\0A;;;   0 handle    OUTPUT: fixnum handle into the runtime's FILE * table\0A;;;                       (0 = stdout, 1 = stderr, 2+ = opened by this program)\0A;;;               INPUT:  #f -- so a port-directed WRITE to an input port finds no\0A;;;                       fixnum in slot 0 and reports an error instead of writing\0A;;;   1 input?    #t input, #f output\0A;;;   2 buf       INPUT: the whole source text, slurped (D2); #f = not yet slurped\0A;;;               (the stdin port only -- see %port-buf), OUTPUT: #f\0A;;;   3 pos       INPUT: cursor, a byte index into buf; OUTPUT: unused\0A;;;   4 string?   #t for a string port (get-output-string is legal on it)\0A;;;   5 closed?   #t once closed\0A;;; The port type descriptor is made ON FIRST USE, not at load time.  Two reasons,\0A;;; both load-bearing: this file is also `load`ed into the Chez bootstrap host by\0A;;; the reader unit tests, where a `%`-primitive is unbound until Emit compiles it\0A;;; -- so no top-level INITIALIZER here may call one (every other `%`-use in this\0A;;; file is likewise inside a procedure body) -- and a program that never mentions\0A;;; a port then runs no port initialization at all.\0A(define %port-rtd-cell #f)\0A(define (%port-rtd)\0A  (if %port-rtd-cell\0A      %port-rtd-cell\0A      (begin (set! %port-rtd-cell (%make-record-type \22port\22))\0A             %port-rtd-cell)))\0A\0A(define (%make-port handle input? buf pos string? closed?)\0A  (%make-record (%port-rtd) (list handle input? buf pos string? closed?)))\0A\0A(define (port? p) (%record-of-type? p (%port-rtd)))\0A(define (input-port? p) (and (port? p) (%record-ref p 1)))\0A(define (output-port? p) (and (port? p) (not (%record-ref p 1))))\0A;;; Every port this implementation makes is textual; binary ports are out of scope\0A;;; (design non-goal), so textual-port? is port? until they exist.\0A(define (textual-port? p) (port? p))\0A(define (port-closed? p) (%record-ref p 5))\0A(define (input-port-open? p) (and (input-port? p) (not (%record-ref p 5))))\0A(define (output-port-open? p) (and (output-port? p) (not (%record-ref p 5))))\0A\0A;;; Guard every operation behind \22is this the right kind of live port?\22, so a\0A;;; wrong-type or use-after-close argument becomes a catchable R7RS error naming\0A;;; the operation rather than a wrong tag walk (spec: an operation on a closed port\0A;;; reports an error).\0A(define (%check-input-port p who)\0A  (if (not (input-port? p))\0A      (error who \22not an input port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A(define (%check-output-port p who)\0A  (if (not (output-port? p))\0A      (error who \22not an output port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A\0A;;; The source text of an input port, slurped on first use.  Every port EXCEPT the\0A;;; stdin one arrives with its text already in hand (open-input-file slurps at open,\0A;;; open-input-string is handed it).  current-input-port must NOT slurp when it is\0A;;; created -- that would block every program at startup on a stdin nobody reads --\0A;;; so it starts with #f here and pulls the stream in on the first actual read.\0A(define (%port-buf p)\0A  (let ((b (%record-ref p 2)))\0A    (if b\0A        b\0A        (let ((s (%read-all-stdin)))\0A          (%record-set! p 2 s)\0A          s))))\0A\0A;;; --- input ports ----------------------------------------------------------\0A;;; open-input-file SLURPS (design D2), which is precisely what makes a file port\0A;;; and a string port the same object: both are a string plus a cursor, so every\0A;;; input operation below is pure Scheme over data already in hand and `read` is\0A;;; the reader this file already defines. The cost -- a source larger than memory\0A;;; cannot be read, and input written after the open is not seen -- is documented\0A;;; in the spec and docs/PRIMITIVES.md, not just here.\0A(define (open-input-string s) (%make-port #f #t s 0 #t #f))\0A(define (open-input-file path)\0A  (let ((s (%read-file path)))\0A    (if s\0A        (%make-port #f #t s 0 #f #f)\0A        (error 'open-input-file \22cannot open file for input\22 path))))\0A\0A(define (%port-at-eof? p) (>= (%record-ref p 3) (string-length (%port-buf p))))\0A\0A(define (read-char p)\0A  (%check-input-port p 'read-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let ((i (%record-ref p 3)))\0A        (%record-set! p 3 (+ i 1))\0A        (string-ref (%port-buf p) i))))\0A\0A(define (peek-char p)\0A  (%check-input-port p 'peek-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (string-ref (%port-buf p) (%record-ref p 3))))\0A\0A;;; read-line: up to but NOT including the next line feed, which is consumed; a\0A;;; final line with no terminator is returned as-is.\0A(define (read-line p)\0A  (%check-input-port p 'read-line)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s)))\0A        (let loop ((i (%record-ref p 3)))\0A          (if (>= i n)\0A              (let ((start (%record-ref p 3)))          ; unterminated final line\0A                (%record-set! p 3 n)\0A                (substring s start n))\0A              (if (char=? (string-ref s i) #\5Cnewline)\0A                  (let ((start (%record-ref p 3)))\0A                    (%record-set! p 3 (+ i 1))          ; consume the line feed\0A                    (substring s start i))\0A                  (loop (+ i 1))))))))\0A\0A;;; read-string: up to k characters, short ONLY at end of input.\0A(define (read-string k p)\0A  (%check-input-port p 'read-string)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s))\0A             (start (%record-ref p 3))\0A             (end (if (> (+ start k) n) n (+ start k))))\0A        (%record-set! p 3 end)\0A        (substring s start end))))\0A\0A;;; read: ONE datum at the cursor, leaving the port positioned after it.  This is\0A;;; a cursor discipline over the reader that already exists, NOT a second reader --\0A;;; rd-datum returns (datum . next-index), which is exactly one `read` step, and\0A;;; rd-skip-ws is what makes leading whitespace and ; comments disappear.  Sharing\0A;;; one reader means a user-visible `read` and the compiler's own front end accept\0A;;; the same external representations by construction.\0A(define (read p)\0A  (%check-input-port p 'read)\0A  (let* ((s (%port-buf p))\0A         (n (string-length s))\0A         (i (rd-skip-ws s n (%record-ref p 3))))\0A    (cond\0A      ((rd-fail? i) (rd-report s n (cons 'rd-block-comment i)))\0A      ((>= i n) (%record-set! p 3 n) (eof-object))\0A      ;; No folding over a port: `include-ci` is the only folding consumer and it reads\0A      ;; whole source text, not a port (design D3).\0A      (else (let ((r (rd-datum s n i #f)))\0A              (if (rd-fail? (cdr r))\0A                  (rd-report s n r)\0A                  (begin (%record-set! p 3 (cdr r)) (car r))))))))\0A\0A;;; --- output ports ---------------------------------------------------------\0A;;; An output port streams through to its runtime handle on every operation (D2);\0A;;; a string port is a handle too (an in-memory stream in the runtime), so ONE\0A;;; printer serves both and nothing accumulates in Scheme.\0A(define (open-output-file path)\0A  (let ((h (%port-open-output-file path)))\0A    (if h\0A        (%make-port h #f #f 0 #f #f)\0A        (error 'open-output-file \22cannot open file for output\22 path))))\0A\0A(define (open-output-string)\0A  (let ((h (%port-open-output-string)))\0A    (if h\0A        (%make-port h #f #f 0 #t #f)\0A        (error 'open-output-string \22cannot open an output string port\22))))\0A\0A;;; get-output-string does NOT require the port to be open: write-then-close-then-\0A;;; collect is the natural idiom, and closing a string port finalizes its buffer\0A;;; rather than discarding it.  This reads accumulated state instead of reading FROM\0A;;; or writing TO the port, so it is not the \22operation on a closed port\22 the spec\0A;;; requires to fail.\0A(define (get-output-string p)\0A  (if (not (output-port? p))\0A      (error 'get-output-string \22not an output port\22 p)\0A      (if (not (%record-ref p 4))\0A          (error 'get-output-string \22not a string port\22 p)\0A          (%port-get-output-string (%record-ref p 0)))))\0A\0A(define (flush-output-port p)\0A  (%check-output-port p 'flush-output-port)\0A  (%port-flush (%record-ref p 0)))\0A\0A;;; close-port: flush, then close, for either direction.  Closing an\0A;;; already-closed port is permitted and does nothing (R7RS).  The runtime refuses\0A;;; to close the reserved stdout/stderr handles, so closing (current-output-port)\0A;;; cannot take the process's stdout with it.\0A(define (close-port p)\0A  (if (not (port? p))\0A      (error 'close-port \22not a port\22 p)\0A      (if (%record-ref p 5)\0A          (if #f #f)                                  ; already closed: no effect\0A          (begin\0A            (if (not (%record-ref p 1)) (%port-close (%record-ref p 0)))\0A            (%record-set! p 5 #t)\0A            (if #f #f)))))\0A(define (close-input-port p)\0A  (if (input-port? p) (close-port p) (error 'close-input-port \22not an input port\22 p)))\0A(define (close-output-port p)\0A  (if (output-port? p) (close-port p) (error 'close-output-port \22not an output port\22 p)))\0A\0A;;; --- the current ports, as parameter objects ------------------------------\0A;;; R7RS makes these PARAMETER objects so that with-output-to-file can rebind them\0A;;; for a dynamic extent.  That became possible when `dynamic-extent` shipped\0A;;; make-parameter / parameterize / dynamic-wind, which is why this change was\0A;;; sequenced after it (design D4, superseded).  A parameter is callable with zero\0A;;; arguments, so `(current-output-port)` reads identically to the plain accessor\0A;;; the earlier design would have shipped.\0A;;;\0A;;; The two reserved handles (0 stdout, 1 stderr) need no runtime table slot, so\0A;;; these three cost one record each and no file descriptor.  The stdin port's text\0A;;; is pulled in on first read, never here (see %port-buf).\0A;;; These three are hand-written rather than `make-parameter` calls for two\0A;;; reasons.  First, their initial port must be built LAZILY (see %port-rtd above),\0A;;; so there is no value to hand `make-parameter` at load time.  Second,\0A;;; current-output-port has to reach the RUNTIME as well as Scheme: `(display x)`\0A;;; with no port compiles to a bare primcall whose destination is a runtime cell\0A;;; (rt_current_out in src/runtime/runtime.c), which is how a por