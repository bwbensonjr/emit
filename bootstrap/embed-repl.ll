)\0A\0A;;; A multi-character #\5C name -> the character it denotes, or #f when the name is not one\0A;;; this reader knows.  #f rather than a fallback character: the old `(string-ref tok 0)`\0A;;; -- \22unknown name: first char\22 -- is what silently turned #\5Calarm into #\5Ca and made a\0A;;; missing name indistinguishable from a correct one in the value produced, which is why\0A;;; thirteen suite forms were wrong with nothing to point at (issue #74, design D1).\0A;;; The R7RS 6.6 names come first; the four after them are recorded EXTENSIONS, kept because\0A;;; they already read (and, for `page`, because Chez accepts it in source this repo compiles\0A;;; -- a name Emit refused would be a two-host divergence, design D8).\0A(define (rd-char-name tok)\0A  (cond\0A    [(string=? tok \22alarm\22)     (integer->char 7)]\0A    [(string=? tok \22backspace\22) (integer->char 8)]\0A    [(string=? tok \22delete\22)    (integer->char 127)]\0A    [(string=? tok \22escape\22)    (integer->char 27)]\0A    [(string=? tok \22newline\22)   (integer->char 10)]\0A    [(string=? tok \22null\22)      (integer->char 0)]\0A    [(string=? tok \22return\22)    (integer->char 13)]\0A    [(string=? tok \22space\22)     (integer->char 32)]\0A    [(string=? tok \22tab\22)       (integer->char 9)]\0A    [(string=? tok \22nul\22)       (integer->char 0)]      ; extension\0A    [(string=? tok \22altmode\22)   (integer->char 27)]     ; extension\0A    [(string=? tok \22esc\22)       (integer->char 27)]     ; extension\0A    [(string=? tok \22page\22)      (integer->char 12)]     ; extension\0A    [else #f]))\0A\0A;;; #\5Cx<hex digits> (R7RS 6.6) -> the codepoint, or #f when TOK is not that shape and is\0A;;; therefore a character NAME.  Bare `#\5Cx` never reaches here -- rd-char takes the\0A;;; single-character path first -- so the letter x keeps its meaning (design D2).\0A(define (rd-char-hex tok)\0A  (if (= (char->integer (string-ref tok 0)) 120)        ; x\0A      (let ([len (string-length tok)])\0A        (let loop ([i 1] [acc 0])\0A          (if (< i len)\0A              (let ([c (string-ref tok i)])\0A                (if (rd-hex-digit? c)\0A                    (loop (+ i 1) (+ (* acc 16) (rd-hex-digit c)))\0A                    #f))                                ; not hex: a name, not a codepoint\0A              acc)))\0A      #f))\0A\0A(define (rd-char s n i st)               ; i at '\5C' of #\5C ; content at i+1\0A  (let* ([cs (+ i 1)]\0A         [end (rd-token-end s n (+ cs 1))]   ; force the first content char in\0A         [tok (substring s cs end)])\0A    (if (= (string-length tok) 1)\0A        (cons (string-ref s cs) end)         ; single-character literal\0A        (let* ([name (if (rd-fold? st) (rd-fold-token tok) tok)]\0A               [hx (rd-char-hex name)])\0A          (if hx\0A              (cons (integer->char hx) end)  ; #\5CxHH\0A              ;; `(- i 1)` is the `#`, so the report names the whole `#\5Cname` token.\0A              (let ([c (rd-char-name name)])\0A                (if c\0A                    (cons c end)             ; named character\0A                    (rd-fail (quote rd-char-name) (- i 1)))))))))\0A\0A;;; R7RS 7.1.1 bar-quoted identifier: | opens a name that runs to the matching |, with\0A;;; the \5C| and \5CxHH; escapes the standard gives it.  The result is an ORDINARY interned\0A;;; symbol -- R7RS says there is no distinct type, so (eq? '|foo| 'foo) is #t -- which\0A;;; makes this a new LEXEME, not a new value.  ( `|` is deliberately NOT added to\0A;;; rd-delim?: only a LEADING bar opens one, so a symbol like `a|b` still reads whole.)\0A(define (rd-bar s n i p)                 ; i just past the opening |, which was at p\0A  (let loop ([i i] [acc (quote ())])\0A    (if (< i n)\0A        (let ([c (string-ref s i)])\0A          (let ([k (char->integer c)])\0A            (cond\0A              [(= k 124) (cons (string->symbol (list->string (reverse acc))) (+ i 1))]\0A              [(and (= k 92) (< (+ i 1) n))                       ; backslash escape\0A               (let ([e (string-ref s (+ i 1))])\0A                 (if (= (char->integer e) 120)                    ; \5CxHH;\0A                     (let ([hx (rd-hex s n (+ i 2) 0)])\0A                       (loop (cdr hx) (cons (integer->char (car hx)) acc)))\0A                     (loop (+ i 2) (cons (rd-str-esc e) acc))))]  ; \5C| \5C\5C and the rest\0A              [else (loop (+ i 1) (cons c acc))])))\0A        (rd-fail (quote rd-bar) p))))\0A\0A(define (rd-quote s n i st)              ; 'x -> (quote x)\0A  (let ([r (rd-datum s n (rd-skip-ws s n i st) st)])\0A    (if (rd-fail? (cdr r)) r (cons (list (quote quote) (car r)) (cdr r)))))\0A\0A(define (rd-quasi s n i st)              ; `x -> (quasiquote x)\0A  (let ([r (rd-datum s n (rd-skip-ws s n i st) st)])\0A    (if (rd-fail? (cdr r)) r (cons (list (quote quasiquote) (car r)) (cdr r)))))\0A\0A(define (rd-unquote s n i st)            ; ,x -> (unquote x); ,@x -> (unquote-splicing x)\0A  (if (and (< i n) (= (char->integer (string-ref s i)) 64))     ; @  -> splicing\0A      (let ([r (rd-datum s n (rd-skip-ws s n (+ i 1) st) st)])\0A        (if (rd-fail? (cdr r))\0A            r\0A            (cons (list (quote unquote-splicing) (car r)) (cdr r))))\0A      (let ([r (rd-datum s n (rd-skip-ws s n i st) st)])\0A        (if (rd-fail? (cdr r)) r (cons (list (quote unquote) (car r)) (cdr r))))))\0A\0A(define (rd-dot? s n j)                  ; a standalone `.` token at j (dotted-pair marker)\0A  (and (= (char->integer (string-ref s j)) 46)      ; .\0A       (= (rd-token-end s n (+ j 1)) (+ j 1))))      ; next char is a delimiter -> lone .\0A(define (rd-append-reverse acc tail)     ; (reverse acc) terminated by tail (improper list)\0A  (if (null? acc) tail (rd-append-reverse (cdr acc) (cons (car acc) tail))))\0A(define (rd-datum-comment? s n i)        ; \22#;\22 begins at i\0A  (and (= (char->integer (string-ref s i)) 35)\0A       (< (+ i 1) n)\0A       (= (char->integer (string-ref s (+ i 1))) 59)))\0A;; `open` is the index of the construct's FIRST character -- the `(` or `[`, and for a vector\0A;; or bytevector the `#`, so the report can name `#(` / `#u8(` rather than a bare paren.\0A;;\0A;; It travels DOWN rather than being attached by the caller on the way out, because rd-list\0A;; recurses per element: the INNER unterminated construct is the one whose delimiter is\0A;; missing, and a position attached on the way out would be overwritten by every enclosing\0A;; list (change: reader-input-termination, design D1).\0A;;\0A;; NOTE the divergence from `fc-list` (src/repl-core.ss), which answers `fc-incomplete` for\0A;; the same text.  That is deliberate and directional, not a duplication to be unified: a\0A;; host reading a stream can supply another line, a source file cannot.  Unifying the two\0A;; would destroy multi-line entry at the prompt.\0A(define (rd-list s n i acc st open)      ; i after (; read until ) (supports . tail)\0A  (let ([j (rd-skip-ws s n i st)])\0A    (cond\0A      [(rd-fail? j) (cons (quote rd-block-comment) j)]\0A      [(< j n)\0A       (cond\0A         [(let ([c (char->integer (string-ref s j))]) (or (= c 41) (= c 93)))\0A          (cons (reverse acc) (+ j 1))]                                            ; ) or ]\0A         ;; #; between elements -- including immediately before the closing paren,\0A         ;; where there is no following element for rd-datum's arm to return.\0A         [(rd-datum-comment? s n j)\0A          (let* ([child (rd-state-child st)]\0A                 [r (rd-finish child\0A                               (rd-datum s n (rd-skip-ws s n (+ j 2) child) child))])\0A            (if (rd-fail? (cdr r)) r (rd-list s n (cdr r) acc st open)))]\0A         [(rd-dot? s n j)                                                          ; . tail\0A          (let ([r (rd-datum s n (rd-skip-ws s n (+ j 1) st) st)])\0A            (if (rd-fail? (cdr r))\0A                r\0A                (let ([j2 (rd-skip-ws s n (cdr r) st)])\0A                  (cond\0A                    [(rd-fail? j2) (cons (quote rd-block-comment) j2)]\0A                    ;; the close paren this arm steps past must actually BE there\0A                    [(<= n j2) (rd-fail (quote rd-unterminated-list) open)]\0A                    [else (cons (rd-append-reverse acc (car r)) (+ j2 1))]))))]     ; past )\0A         [else (let ([r (rd-datum s n j st)])\0A                 (if (rd-fail? (cdr r))\0A                     r\0A                     (rd-list s n (cdr r) (cons (car r) acc) st open)))])]\0A      ;; NOT end of input: closing the list here fabricates a datum the source does not\0A      ;; contain, so a truncated file compiled as though complete (issue #66).\0A      [else (rd-fail (quote rd-unterminated-list) open)])))\0A\0A(define (rd-datum s n i st)              ; i at a non-ws char -> (datum . next)\0A  (if (and (<= 0 i) (< i n))\0A      (let ([k (char->integer (string-ref s i))])\0A        (cond\0A          [(= k 40) (rd-list s n (+ i 1) (quote ()) st i)]     ; (\0A          [(= k 91) (rd-list s n (+ i 1) (quote ()) st i)]     ; [ (brackets = parens)\0A          [(= k 39) (rd-quote s n (+ i 1) st)]                 ; '\0A          [(= k 96) (rd-quasi s n (+ i 1) st)]                 ; `\0A          [(= k 44) (rd-unquote s n (+ i 1) st)]               ; ,\0A          [(= k 34) (rd-string s n (+ i 1) i)]                 ; \22\0A          [(= k 35) (rd-hash s n (+ i 1) st)]                  ; #\0A          ;; NOT given ci: R7RS 7.1.1 makes the characters between the bars the symbol's\0A          ;; name literally, so a bar-quoted identifier is never folded (issue #61).\0A          [(= k 124) (rd-bar s n (+ i 1) i)]                   ; |bar quoted identifier|\0A          [(or (= k 41) (= k 93)) (rd-fail (quote rd-unexpected) i)]   ; a close with no open\0A          [else (rd-atom s n i st)]))\0A      ;; A sentinel travelling outward (an unterminated block comment upstream), or a\0A      ;; datum the input ended before -- `#;` with nothing after it, say.  Neither is\0A      ;; raised here (design D2); the entry point reports.\0A      (if (< i 0) (cons (quote rd-block-comment) i) (rd-fail (quote rd-eof) i))))\0A\0A;;; --- where the reader's reports become errors (design D2) -------------------\0A;;; The lexeme layer answers a sentinel because it cannot raise; here `error` is in\0A;;; scope, so here is where the sentinel is turned into a diagnostic.  The position it\0A;;; carries is what lets the message name both WHERE and, by re-reading the token at\0A;;; that position, WHAT.  (`read` in (scheme read) needs this too and cannot import a\0A;;; private name, so it keeps its own copy -- the arrangement %check-input-port already\0A;;; has, for the same reason: this is the reader code that raises.)\0A(define (rd-report s n r)\0A  (let ([why (car r)] [p (rd-fail-pos (cdr r))])\0A    (cond\0A      [(eq? why (quote rd-block-comment))\0A       (%read-error (quote read) \22unterminated block comment #| opened at index\22 p)]\0A      [(eq? why (quote rd-bar))\0A       (%read-error (quote read) \22unterminated |identifier| opened at index\22 p)]\0A      ;; ONE reason covers (, [, #( and #u8(: the source at p still says which delimiter it\0A      ;; was, so the message names the construct the author actually opened without four\0A      ;; reasons carrying identical handling.  Decoded INLINE rather than through a helper\0A      ;; because rd-report is duplicated into (scheme read) -- a helper would have to join\0A      ;; *reader-report-shared-with-read* (src/prelude-surface.scm) to travel with it.\0A      [(eq? why (quote rd-unterminated-list))\0A       (%read-error (quote read)\0A              (string-append\0A               \22unterminated \22\0A               (let ([k (char->integer (string-ref s p))])\0A                 (cond\0A                   [(= k 91) \22list [\22]\0A                   [(and (= k 35) (< (+ p 1) n)\0A                         (= (char->integer (string-ref s (+ p 1))) 117))   ; #u8(\0A                    \22bytevector #u8(\22]\0A                   [(= k 35) \22vector #(\22]\0A                   [else \22list (\22]))\0A               \22 opened at index\22)\0A              p)]\0A      [(eq? why (quote rd-unterminated-string))\0A       (%read-error (quote read) \22unterminated string \5C\22 opened at index\22 p)]\0A      ;; The name is NAMED.  This arm exists because the alternative -- answering the first\0A      ;; character of the name -- made #\5Calarm read as #\5Ca with nothing to notice (design D1).\0A      [(eq? why (quote rd-char-name))\0A       (%read-error (quote read) \22unknown character name\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-hash-token))\0A       (%read-error (quote read) \22not a boolean; write #t, #true, #f or #false\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-duplicate))\0A       (%read-error (quote read) \22duplicate datum label\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-unresolved))\0A       (%read-error (quote read) \22datum label reference has no earlier definition\22\0A                    (rd-token-at s n p))]\0A      [(eq? why (quote rd-label-self))\0A       (%read-error (quote read) \22datum label cannot be defined as only its own reference\22\0A                    (rd-token-at s n p))]\0A      [(eq? why (quote rd-label))\0A       (%read-error (quote read) \22malformed datum label\22 (rd-token-at s n p))]\0A      [(eq? why (quote rd-eof))\0A       (%read-error (quote read) \22end of input where a datum was expected, at index\22 p)]\0A      [(eq? why (quote rd-unexpected))\0A       (%read-error (quote read) \22no datum here, at index\22 p)]\0A      [(eq? why (quote rd-rational))\0A       (%read-error (quote read)\0A              (string-append \22rational literal syntax is not supported -- Emit has no \22\0A                             \22exact rationals; write 0.5, or (/ 1 2)\22)\0A              (rd-token-at s n p))]\0A      [else (%read-error (quote read) \22unrecognized syntax\22 (rd-token-at s n p))])))\0A\0A(define (read-from-string s)\0A  (let ([n (string-length s)] [st (rd-state #f)])\0A    (let ([r (rd-finish st (rd-datum s n (rd-skip-ws s n 0 st) st))])\0A      (if (rd-fail? (cdr r)) (rd-report s n r) (car r)))))\0A\0A;;; --- whole-program read (stdin-source-reader) -----------------------------\0A;;; Loop the single-datum reader across the whole source: skip inter-form\0A;;; whitespace/; comments, read a datum, continue from the next position, and\0A;;; stop at end of input.  Returns the top-level forms in source order (the empty\0A;;; list for empty or whitespace/comment-only input).  This is what a self-hosted\0A;;; core uses to turn its input text into the form list it compiles.\0A;;; TWO entry points over ONE worker, rather than one entry point with an optional\0A;;; argument (change: reader-token-path, design D1/D2).  P9 originally made an optional\0A;;; argument cost every call site its cross-unit direct call; change\0A;;; cross-unit-variadic-direct-calls removed that call-shape cost, but the variadic\0A;;; prologue would still build an empty rest list on every ordinary read.  This is the\0A;;; compiler's own hot path, so making it pay for the rare folding read is backwards.\0A;;; `-ci` is R7RS's spelling for case-insensitivity (string-ci=?, char-ci=?, and\0A;;; `include-ci`, which is what this exists for).\0A(define (read-all-from-string s) (rd-all s #f))\0A(define (read-all-from-string-ci s) (rd-all s #t))\0A\0A(define (rd-all s ci)\0A  (let ([n (string-length s)] [base (rd-state ci)])\0A    (let loop ([i (rd-skip-ws s n 0 base)] [acc (quote ())])\0A      (cond\0A        ;; NOT end of input: an unterminated block comment here used to make every form\0A        ;; after the opening delimiter vanish with no diagnostic (issue #59).\0A        [(rd-fail? i) (rd-report s n (cons (quote rd-block-comment) i))]\0A        [(< i n)\0A         (let* ([st (rd-state-child base)]\0A                [r (rd-finish st (rd-datum s n i st))])\0A           (if (rd-fail? (cdr r))\0A               (rd-report s n r)\0A               (loop (rd-skip-ws s n (cdr r) base) (cons (car r) acc))))]\0A        [else (reverse acc)]))))\0A\0A;;; --- ports (change: scheme-io-library, design D1/D2) -----------------------\0A;;; A port is a RECORD over the existing record layer, so `port?` is\0A;;; `%record-of-type?` and a port is an ordinary first-class value -- no new heap\0A;;; header code, no printer/GC/equality teaching (design D1).\0A;;;\0A;;; FIELD LAYOUT.  Field 0 is a CONTRACT SHARED WITH THE RUNTIME: the\0A;;; port-directed output primitives (%display-port and friends) are handed the\0A;;; port record and read slot 0 as their handle, so the two-argument output forms\0A;;; stay bare primcalls with no Scheme wrapper on the path.  If this layout moves,\0A;;; `port_arg_stream` in src/runtime/runtime.c moves with it.\0A;;;\0A;;;   0 handle    OUTPUT: fixnum handle into the runtime's FILE * table\0A;;;                       (0 = stdout, 1 = stderr, 2+ = opened by this program)\0A;;;               INPUT:  #f -- so a port-directed WRITE to an input port finds no\0A;;;                       fixnum in slot 0 and reports an error instead of writing\0A;;;   1 input?    #t input, #f output\0A;;;   2 buf       INPUT: the whole source text, slurped (D2); #f = not yet slurped\0A;;;               (the stdin port only -- see %port-buf), OUTPUT: #f\0A;;;   3 pos       INPUT: cursor, a byte index into buf; OUTPUT: unused\0A;;;   4 string?   #t for a string port (get-output-string is legal on it)\0A;;;   5 closed?   #t once closed\0A;;;   6 fold-cell INPUT: mutable one-element vector holding the persistent\0A;;;                       #!fold-case mode; OUTPUT: unused\0A;;; The port type descriptor is made ON FIRST USE, not at load time.  Two reasons,\0A;;; both load-bearing: this file is also `load`ed into the Chez bootstrap host by\0A;;; the reader unit tests, where a `%`-primitive is unbound until Emit compiles it\0A;;; -- so no top-level INITIALIZER here may call one (every other `%`-use in this\0A;;; file is likewise inside a procedure body) -- and a program that never mentions\0A;;; a port then runs no port initialization at all.\0A(define %port-rtd-cell #f)\0A(define (%port-rtd)\0A  (if %port-rtd-cell\0A      %port-rtd-cell\0A      (begin (set! %port-rtd-cell (%make-record-type \22port\22))\0A             %port-rtd-cell)))\0A\0A(define (%make-port handle input? buf pos string? closed?)\0A  (%make-record (%port-rtd)\0A                (list handle input? buf pos string? closed?\0A                      (list->vector (list #f)))))\0A\0A(define (port? p) (%record-of-type? p (%port-rtd)))\0A(define (input-port? p) (and (port? p) (%record-ref p 1)))\0A(define (output-port? p) (and (port? p) (not (%record-ref p 1))))\0A;;; Every port this implementation makes is textual; binary ports are out of scope\0A;;; (design non-goal), so textual-port? is port? until they exist.\0A(define (textual-port? p) (port? p))\0A(define (port-closed? p) (%record-ref p 5))\0A(define (input-port-open? p) (and (input-port? p) (not (%record-ref p 5))))\0A(define (output-port-open? p) (and (output-port? p) (not (%record-ref p 5))))\0A\0A;;; Guard every operation behind \22is this the right kind of live port?\22, so a\0A;;; wrong-type or use-after-close argument becomes a catchable R7RS error naming\0A;;; the operation rather than a wrong tag walk (spec: an operation on a closed port\0A;;; reports an error).\0A(define (%check-input-port p who)\0A  (if (not (input-port? p))\0A      (error who \22not an input port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A(define (%check-output-port p who)\0A  (if (not (output-port? p))\0A      (error who \22not an output port\22 p)\0A      (if (%record-ref p 5) (error who \22port is closed\22 p) p)))\0A\0A;;; The source text of an input port, slurped on first use.  Every port EXCEPT the\0A;;; stdin one arrives with its text already in hand (open-input-file slurps at open,\0A;;; open-input-string is handed it).  current-input-port must NOT slurp when it is\0A;;; created -- that would block every program at startup on a stdin nobody reads --\0A;;; so it starts with #f here and pulls the stream in on the first actual read.\0A(define (%port-buf p)\0A  (let ((b (%record-ref p 2)))\0A    (if b\0A        b\0A        (let ((s (%read-all-stdin)))\0A          (%record-set! p 2 s)\0A          s))))\0A\0A;;; --- input ports ----------------------------------------------------------\0A;;; open-input-file SLURPS (design D2), which is precisely what makes a file port\0A;;; and a string port the same object: both are a string plus a cursor, so every\0A;;; input operation below is pure Scheme over data already in hand and `read` is\0A;;; the reader this file already defines. The cost -- a source larger than memory\0A;;; cannot be read, and input written after the open is not seen -- is documented\0A;;; in the spec and docs/PRIMITIVES.md, not just here.\0A(define (open-input-string s) (%make-port #f #t s 0 #t #f))\0A(define (open-input-file path)\0A  (let ((s (%read-file path)))\0A    (if s\0A        (%make-port #f #t s 0 #f #f)\0A        (%file-error 'open-input-file \22cannot open file for input\22 path))))\0A\0A(define (%port-at-eof? p) (>= (%record-ref p 3) (string-length (%port-buf p))))\0A\0A(define (read-char p)\0A  (%check-input-port p 'read-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let ((i (%record-ref p 3)))\0A        (%record-set! p 3 (+ i 1))\0A        (string-ref (%port-buf p) i))))\0A\0A(define (peek-char p)\0A  (%check-input-port p 'peek-char)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (string-ref (%port-buf p) (%record-ref p 3))))\0A\0A;;; read-line: up to but NOT including the next line feed, which is consumed; a\0A;;; final line with no terminator is returned as-is.\0A(define (read-line p)\0A  (%check-input-port p 'read-line)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s)))\0A        (let loop ((i (%record-ref p 3)))\0A          (if (>= i n)\0A              (let ((start (%record-ref p 3)))          ; unterminated final line\0A                (%record-set! p 3 n)\0A                (substring s start n))\0A              (if (char=? (string-ref s i) #\5Cnewline)\0A                  (let ((start (%record-ref p 3)))\0A                    (%record-set! p 3 (+ i 1))          ; consume the line feed\0A                    (substring s start i))\0A                  (loop (+ i 1))))))))\0A\0A;;; read-string: up to k characters, short ONLY at end of input.\0A(define (read-string k p)\0A  (%check-input-port p 'read-string)\0A  (if (%port-at-eof? p)\0A      (eof-object)\0A      (let* ((s (%port-buf p))\0A             (n (string-length s))\0A             (start (%record-ref p 3))\0A             (end (if (> (+ start k) n) n (+ start k))))\0A        (%record-set! p 3 end)\0A        (substring s start end))))\0A\0A;;; read: ONE datum at the cursor, leaving the port positioned after it.  This is\0A;;; a cursor discipline over the reader that already exists, NOT a second reader --\0A;;; rd-datum returns (datum . next-index), which is exactly one `read` step, and\0A;;; rd-skip-ws is what makes leading whitespace and ; comments disappear.  Sharing\0A;;; one reader means a user-visible `read` and the compiler's own front end accept\0A;;; the same external representations by construction.\0A(define (read p)\0A  (%check-input-port p 'read)\0A  (let* ((s (%port-buf p))\0A         (n (string-length s))\0A         (st (rd-state-from-cell (%record-ref p 6)))\0A         (i (rd-skip-ws s n (%record-ref p 3) st)))\0A    (cond\0A      ((rd-fail? i) (rd-report s n (cons 'rd-block-comment i)))\0A      ((>= i n) (%record-set! p 3 n) (eof-object))\0A      (else (let ((r (rd-finish st (rd-datum s n i st))))\0A              (if (rd-fail? (cdr r))\0A                  (rd-report s n r)\0A                  (begin (%record-set! p 3 (cdr r)) (car r))))))))\0A\0A;;; --- output ports ---------------------------------------------------------\0A;;; An output port streams through to its runtime handle on every operation (D2);\0A;;; a string port is a handle too (an in-memory stream in the runtime), so ONE\0A;;; printer serves both and nothing accumulates in Scheme.\0A(define (open-output-file path)\0A  (let ((h (%port-open-output-file path)))\0A    (if h\0A        (%make-port h #f #f 0 #f #f)\0A        (%file-error 'open-output-file \22cannot open file for output\22 path))))\0A\0A(define (open-output-string)\0A  (let ((h (%port-open-output-string)))\0A    (if h\0A        (%make-port h #f #f 0 #t #f)\0A        (error 'open-output-string \22cannot open an output string port\22))))\0A\0A;;; get-output-string does NOT require the port to be open: write-then-close-then-\0A;;; collect is the natural idiom, and closing a string port finalizes its buffer\0A;;; rather than discarding it.  This reads accumulated state instead of reading FROM\0A;;; or writing TO the port, so it is not the \22operation on a closed port\22 the spec\0A;;; requires to fail.\0A(define (get-output-string p)\0A  (if (not (output-port? p))\0A      (error 'get-output-string \22not an output port\22 p)\0A      (if (not (%record-ref p 4))\0A          (error 'get-output-string \22not a string port\22 p)\0A          (%port-get-output-string (%record-ref p 0)))))\0A\0A(define (flush-output-port p)\0A  (%check-output-port p 'flush-output-port)\0A  (%port-flush (%record-ref p 0)))\0A\0A;;; close-port: flush, then close, for either direction.  Closing an\0A;;; already-closed port is permitted and does nothing (R7RS).  The runtime refuses\0A;;; to close the reserved stdout/stderr handles, so closing (current-output-port)\0A;;; cannot take the process's stdout with it.\0A(define (close-port p)\0A  (if (not (port? p))\0A      (error 'close-port \22not a port\22 p)\0A      (if (%record-ref p 5)\0A          (if #f #f)                                  ; already closed: no effect\0A          (begin\0A            (if (not (%record-ref p 1)) (%port-close (%record-ref p 0)))\0A            (%record-set! p 5 #t)\0A            (if #f #f)))))\0A(define (close-input-port p)\0A  (if (input-port? p) (close-port p) (error 'close-input-port \22not an input port\22 p)))\0A(define (close-output-port p)\0A  (if (output-port? p) (close-port p) (error 'close-output-port \22not an output port\22 p)))\0A\0A;;; --- the current ports, as parameter objects ------------------------------\0A;;; R7RS makes these PARAMETER objects so that with-output-to-file can rebind them\0A;;; for a dynamic extent.  That became possible when `dynamic-extent` shipped\0A;;; make-parameter / parameterize / dynamic-wind, which is why this change was\0A;;; sequenced after it (design D4, superseded).  A parameter is callable with zero\0A;;; arguments, so `(current-output-port)` reads identically to the plain accessor\0A;;; the earlier design would have shipped.\0A;;;\0A;;; The two reserved handles (0 stdout, 1 stderr) need no runtime table slot, so\0A;;; these three cost one record each and no file descriptor.  The stdin port's text\0A;;; is pulled in on first read, never here (see %port-buf).\0A;;; These three are hand-written rather than `make-parameter` calls for two\0A;;; reasons.  First, their initial port must be built LAZILY (see %port-rtd above),\0A;;; so there is no value to hand `make-parameter` at load time.  Second,\0A;;; current-output-port has to reach the RUNTIME as well as Scheme: `(display x)`\0A;;; with no port compiles to a bare primcall whose destination is a runtime cell\0A;;; (rt_current_out in src/runtime/runtime.c), which is how a port-less display\0A;;; follows `with-output-to-file` while its emitted code stays byte-identical.\0A;;; Every set must push the new port's handle into that cell -- INCLUDING the\0A;;; restore leg, which arrives as the two-argument form `(p v #f)` that a\0A;;; make-parameter converter would never see.\0A;;;\0A;;; The protocol is make-parameter's exactly -- zero arguments reads, one or two\0A;;; set -- so `parameterize` drives these, and a call site cannot tell them from\0A;;; plain accessor procedures.\0A(define %stdout-port #f)\0A(define %stderr-port #f)\0A(define %stdin-port  #f)\0A\0A(define (current-output-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stdout-port)\0A            (begin (set! %stdout-port (%make-port 0 #f #f 0 #f #f))\0A                   (%set-current-output! 0)))\0A        %stdout-port)\0A      (let ((p (car args)))\0A        (set! %stdout-port p)\0A        (%set-current-output! (%record-ref p 0))\0A        (if #f #f))))\0A\0A(define (current-error-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stderr-port) (set! %stderr-port (%make-port 1 #f #f 0 #f #f)))\0A        %stderr-port)\0A      (begin (set! %stderr-port (car args)) (if #f #f))))\0A\0A;;; The stdin port's TEXT is pulled in on the first read, never here (see\0A;;; %port-buf) -- slurping at startup would block every program on a stdin nobody\0A;;; reads.\0A(define (current-input-port . args)\0A  (if (null? args)\0A      (begin\0A        (if (not %stdin-port) (set! %stdin-port (%make-port #f #t #f 0 #f #f)))\0A        %stdin-port)\0A      (begin (set! %stdin-port (car args)) (if #f #f))))\0A\0A;;; call-with-port: hand the port to PROC and close it on EVERY exit -- a normal\0A;;; return, an escape via a continuation, or a raise.  dynamic-wind is what makes\0A;;; the escaping cases work; a version that just closed after the call would leak\0A;;; the port exactly when it matters most.\0A(define (call-with-port p proc)\0A  (dynamic-wind\0A    (lambda () (if #f #f))\0A    (lambda () (proc p))\0A    (lambda () (close-port p))))\0A\0A;;; with-output-to-file / with-input-from-file: rebind the corresponding parameter\0A;;; for the dynamic extent of THUNK, then close the port and restore the parameter.\0A;;; Both ride dynamic-wind for the same reason call-with-port does.\0A(define (with-output-to-file path thunk)\0A  (let ((p (open-output-file path))\0A        (saved (current-output-port)))\0A    (dynamic-wind\0A      (lambda () (current-output-port p))\0A      thunk\0A      (lambda () (current-output-port saved #f) (close-port p)))))\0A\0A(define (with-input-from-file path thunk)\0A  (let ((p (open-input-file path))\0A        (saved (current-input-port)))\0A    (dynamic-wind\0A      (lambda () (current-input-port p))\0A      thunk\0A      (lambda () (current-input-port saved #f) (close-port p)))))\0A\0A(define (call-with-output-file path proc)\0A  (call-with-port (open-output-file path) proc))\0A(define (call-with-input-file path proc)\0A  (call-with-port (open-input-file path) proc))\0A\0A;;; --- the file operations that are not port constructors (change:\0A;;; catchable-errors-with-kinds, design D8).  R7RS puts both in (scheme file), and they\0A;;; ship together because delete-file's only interesting failure is the one\0A;;; file-exists? answers.\0A;;;\0A;;; file-exists? NEVER raises: the absence of the file IS its answer, so a missing path\0A;;; is #f and not a condition.  delete-file is the other way round -- it raises a FILE\0A;;; error when it cannot remove the path, which is what lets a program tell it from an\0A;;; unrelated failure caught by the same `guard`.\0A(define (file-exists? path) (%file-exists? path))\0A(define (delete-file path)\0A  (if (%delete-file path)\0A      (if #f #f)\0A      (%file-error 'delete-file \22cannot delete file\22 path)))\0A\00"
