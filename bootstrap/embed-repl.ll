o close the reserved stdout/stderr handles, so closing (current-output-port)\0A;;; cannot take the process's stdout with it.\0A(define (close-port p)\0A  (if (not (port? p))\0A      (error 'close-port \22not a port\22 p)\0A      (if (%record-ref p 5)\0A          (if #f #f)                                  ; already closed: no effect\0A          (begin\0A            (if (not (%record-ref p 1)) (%port-close (%record-ref p 0)))\0A            (%record-set! p 5 #t)\0A            (if #f #f)))))\0A(define (close-input-port p)\0A  (if (input-port? p) (close-port p) (error 'close-input-port \22not an input port\22 p)))\0A(define (close-output-port p)\0A  (if (output-port? p) (close-port p) (error 'close-output-port \22not an output port\22 p)))\0A\0A;;; --- the current ports, as parameter objects ------------------------------\0A;;; R7RS makes these PARAMETER objects so that with-output-to-file can rebind them\0A;;; for a dynamic extent.  That became possible when `dynamic-extent` shipped\0A;;; make-parameter / parameterize / dynamic-wind, which is why this change was\0A;;; sequenced after it (design D4, superseded).  A parameter is callable with zero\0A;;; arguments, so `(current-output-port)` reads identically to the plain accessor\0A;;; the earlier design would have shipped.\0A;;;\0A;;; The two reserved handles (0 stdout, 1 stderr) need no runtime table slot, so\0A;;; these three cost one record each and no file descriptor.  The stdin port's text\0A;;; is pulled in on first read, never here (see %port-buf).\0A;;; These three are hand-written rather than `make-parameter` calls for two\0A;;; reasons.  First, their initial port must be built LAZILY (see %port-rtd above),\0A;;; so there is no value to hand `make-parameter` at load time.  Second,\0A;;; current-output-port has to reach the RUNTIME as well as Scheme: `(display x)`\0A;;; with no port compiles to a bare primcall whose destination is a runtime cell\0A;;; (rt_current_out in src/runtime/runtime.c), which is how a por