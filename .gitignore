*~
.DS_Store

# Local, machine-specific Claude Code settings (the shared .claude/ — skills,
# commands, settings.json — is committed; only per-machine local files are ignored)
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.md
CLAUDE.local.md

# build artifacts
*.bc
*.o
/build/


# `test/r7rs-suite-tests.sh --discover` writes a DRAFT exclusion manifest beside the real
# one. It is generated scratch: it duplicates exclusions.tsv's keys but carries the raw
# untagged errors instead of the curated reasons, so the two disagree by design, and every
# discovery run rewrites it.
test/r7rs/exclusions.tsv.draft
# Python validation tools use no installed dependencies.
__pycache__/
*.pyc

# `make install TOOLCHAIN_PIN=1` writes share/emit/package/toolchain.env; tools/llvm-env.sh
# reads ../package/toolchain.env beside itself, so a stray copy in a checkout must never be
# committed (it would pin every developer build).
/package/
