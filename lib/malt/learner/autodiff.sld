(define-library (malt learner autodiff)
  (import (scheme base) (malt learner tensors))
  (export
    dual dual? primal backprop scalar? gradient gradient1 gradient-of map* prim1 prim2)
  (begin
    (define (map* f y)
      (cond
        ((scalar? y) (f y))
        ((list? y) (map (lambda (x) (map* f x)) y))
        ((tensor-object? y) (tmap (lambda (x) (map* f x)) y))
        ((vector? y) (vector-map (lambda (x) (map* f x)) y))
        (else (error "map*: expected scalar, list, vector, or tensor" y))))
    (define (accumulate y table)
      (cond
        ((scalar? y) ((backprop y) y 1.0 table))
        ((list? y) (for-each (lambda (x) (accumulate x table)) y) table)
        ((or (tensor-object? y) (vector? y))
          (let loop ((i (- (tlen y) 1)))
            (if (< i 0) table (begin (accumulate (tref y i) table) (loop (- i 1))))))
        (else (error "gradient: expected scalar or structured output" y))))
    (define (gradient-once y wrt)
      (let ((table (make-eq-hash-table)))
        (accumulate y table)
        (map* (lambda (d) (hash-table-ref/default table d 0.0)) wrt)))
    (define (gradient f theta)
      (let ((wrt (map* dual* theta))) (gradient-once (f wrt) wrt)))
    (define (gradient1 f)
      (lambda xs (let ((wrt (map* dual* xs))) (gradient-once (apply f wrt) wrt))))
    (define gradient-of gradient)
    (define (prim1 primal-fn gradient-fn)
      (lambda (da)
        (let ((ra (primal da)))
          (dual (primal-fn ra)
                (lambda (d z table) ((backprop da) da (gradient-fn ra z) table))))))
    (define (prim2 primal-fn gradient-fn)
      (lambda (da db)
        (let ((ra (primal da)) (rb (primal db)))
          (dual (primal-fn ra rb)
                (lambda (d z table)
                  (call-with-values (lambda () (gradient-fn ra rb z))
                                    (lambda (ga gb)
                                      (let ((next ((backprop da) da ga table)))
                                        ((backprop db) db gb next)))))))))))
