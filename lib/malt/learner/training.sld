;;; Training utilities ported from Malt malted/A-core.rkt through O-init.rkt.
;;; See ../LICENSE and ../PROVENANCE.md.
(define-library (malt learner training)
  (import
    (scheme base)
    (malt learner tensors)
    (only (malt learner autodiff) gradient-of)
    (prefix (malt learner operations) m:)
    (malt learner hyperparameters)
    (malt learner random)
    (malt learner recording))
  (export
    dot-product-2-1 dot-product line quad linear-1-1 linear plane softmax relu k-relu
    recu corr k-recu signal-avg model accuracy l2-loss cross-entropy-loss kl-loss block
    block-fn block-ls stack-blocks revise gradient-descent naked-gradient-descent
    velocity-gradient-descent rms-gradient-descent adam-gradient-descent smooth epsilon
    zeroes samples sampling-obj)
  (begin
    (define (dot-product weights values) (m:sum (m:* weights values)))
    (define (dot-product-2-1 weights values) (m:sum (m:*-2-1 weights values)))
    (define (line xs) (lambda (theta) (m:+ (m:* (ref theta 0) xs) (ref theta 1))))
    (define (quad xs)
      (lambda (theta)
        (m:+ (m:* (ref theta 0) (m:sqr xs))
             (m:+ (m:* (ref theta 1) xs) (ref theta 2)))))
    (define (linear-1-1 values)
      (lambda (theta) (m:+ (dot-product (ref theta 0) values) (ref theta 1))))
    (define (linear values)
      (lambda (theta) (m:+ (dot-product-2-1 (ref theta 0) values) (ref theta 1))))
    (define plane linear-1-1)
    (define (softmax values)
      (lambda (theta)
        (let* ((shifted (m:- values (m:max values))) (exponentials (m:exp shifted)))
          (m:/ exponentials (m:sum exponentials)))))
    (define (signal-avg values)
      (lambda (theta)
        (m:/ (m:sum-cols values) (list-ref (shape values) (- (rank values) 2)))))
    (define (l2-loss target)
      (lambda (xs ys)
        (lambda (theta) (record 'loss (m:sum (m:sqr (m:- ys ((target xs) theta))))))))
    (define (cross-entropy-loss target)
      (lambda (xs ys)
        (lambda (theta)
          (let ((predicted ((target xs) theta)) (classes (car (reverse (shape ys)))))
            (record 'loss (m:* -1 (m:/ (dot-product ys (m:log predicted)) classes)))))))
    (define (kl-loss target)
      (lambda (xs ys)
        (lambda (theta)
          (let ((predicted ((target xs) theta)))
            (record 'loss (m:sum (m:* predicted (m:log (m:/ predicted ys)))))))))
    (define (revise function count theta)
      (if (not (and (exact-integer? count) (>= count 0)))
          (error "revise: expected a nonnegative revision count" count))
      (let loop ((remaining count) (theta theta))
        (if (= remaining 0) theta (loop (- remaining 1) (function theta)))))
    (define (gradient-descent inflate deflate update)
      (lambda (objective theta)
        (map deflate
             (revise (lambda (state)
                       (map update state (gradient-of objective (map deflate state))))
                     (hyper-value 'revs revs)
                     (map inflate theta)))))
    (define (identity value) value)
    (define zeroes m:zeroes-primal)
    (define epsilon 1.0e-8)
    (define (smooth decay average sample)
      (m:+-primal (m:*-primal decay average) (m:*-primal (- 1.0 decay) sample)))
    (define naked-gradient-descent
      (gradient-descent
        identity
        identity
        (lambda (parameter gradient)
          (m:--primal parameter (m:*-primal (hyper-value 'alpha alpha) gradient)))))
    (define velocity-gradient-descent
      (gradient-descent
        (lambda (parameter) (list parameter (zeroes parameter)))
        car
        (lambda (state gradient)
          (let ((velocity (m:--primal (m:*-primal (hyper-value 'mu mu) (cadr state))
                                      (m:*-primal (hyper-value 'alpha alpha)
                                                  gradient))))
            (list (m:+-primal (car state) velocity) velocity)))))
    (define rms-gradient-descent
      (gradient-descent
        (lambda (parameter) (list parameter (zeroes parameter)))
        car
        (lambda (state gradient)
          (let* ((average (smooth (hyper-value 'beta beta)
                                  (cadr state)
                                  (m:sqr-primal gradient)))
                 (rate (m:/-primal (hyper-value 'alpha alpha)
                                   (m:+-primal (m:sqrt-primal average) 1.0e-7))))
            (list (m:--primal (car state) (m:*-primal rate gradient)) average)))))
    (define adam-gradient-descent
      (gradient-descent
        (lambda (parameter)
          (let ((zero (zeroes parameter))) (list parameter zero zero)))
        car
        (lambda (state gradient)
          (let* ((average (smooth (hyper-value 'beta beta)
                                  (car (cddr state))
                                  (m:sqr-primal gradient)))
                 (rate (m:/-primal (hyper-value 'alpha alpha)
                                   (m:+-primal (m:sqrt-primal average) epsilon)))
                 (velocity (smooth (hyper-value 'mu mu) (cadr state) gradient)))
            (list (m:--primal (car state) (m:*-primal rate velocity))
                  velocity
                  average)))))
    (define samples sample-indices)
    (define (sampling-obj expectant xs ys)
      (let ((population (car (shape xs))))
        (lambda (theta)
          (let ((batch (samples population (hyper-value 'batch-size batch-size))))
            ((expectant (trefs xs batch) (trefs ys batch)) theta)))))
    (define (relu values) (lambda (theta) (m:rectify ((linear values) theta))))
    (define (k-relu depth)
      (lambda (values)
        (lambda (theta)
          (let loop ((remaining depth) (values values) (theta theta))
            (if (= remaining 0)
                values
                (loop (- remaining 1) ((relu values) theta) (refr theta 2)))))))
    (define (model target theta) (lambda (values) ((target values) theta)))
    (define (accuracy predictor xs ys)
      (primal (m:/ (m:sum (m:=-1 (m:argmax (predictor xs)) (m:argmax ys))) (tlen ys))))
    (define (corr values)
      (lambda (theta) (m:+ (m:correlate (ref theta 0) values) (ref theta 1))))
    (define (recu values) (lambda (theta) (m:rectify ((corr values) theta))))
    (define (k-recu depth)
      (lambda (values)
        (lambda (theta)
          (let loop ((remaining depth) (values values) (theta theta))
            (if (= remaining 0)
                values
                (loop (- remaining 1) ((recu values) theta) (refr theta 2)))))))
    (define (block function shapes) (list function shapes))
    (define block-fn car)
    (define block-ls cadr)
    (define (stack2 first second)
      (block (lambda (values)
               (lambda (theta)
                 (((block-fn second) (((block-fn first) values) theta))
                   (refr theta (length (block-ls first))))))
             (append (block-ls first) (block-ls second))))
    (define (stack-blocks blocks)
      (if (null? blocks) (error "stack-blocks: expected at least one block"))
      (let loop ((result (car blocks)) (rest (cdr blocks)))
        (if (null? rest) result (loop (stack2 result (car rest)) (cdr rest)))))))
