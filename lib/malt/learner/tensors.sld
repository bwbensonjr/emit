;; Adapted from Malt, copyright 2021 Anurag Mendhekar and Daniel P. Friedman.
;; MIT license; see ../LICENSE. Vector-backed tensor objects and scalar backward closures.
(define-library (malt learner tensors)
  (import (scheme base) (emit write) (malt learner formatting))
  (export
    dual dual? dual* primal backprop scalar? end-of-chain len ref refr tref tlen tmap
    list->tensor tensor->vector tensor tensor-object? build-tensor tensor? rank shape
    reshape trefs ext1 ext2 ext1-primal ext2-primal build-vector size-of)
  (begin
    (define-record-type malt-dual (dual r k) dual? (r dual-primal) (k dual-backprop))
    (define-record-type malt-tensor (make-tensor data) tensor-object?
      (data tensor-data))
    (define (primal x) (if (dual? x) (dual-primal x) x))
    (define (backprop x) (if (dual? x) (dual-backprop x) end-of-chain))
    (define (scalar? x) (or (number? x) (and (dual? x) (number? (primal x)))))
    (define (end-of-chain d z table)
      (hash-table-set! table d (+ z (hash-table-ref/default table d 0.0)))
      table)
    (define (dual* x) (dual (primal x) end-of-chain))
    (define len length)
    (define (ref xs i) (list-ref xs (primal i)))
    (define (refr xs i) (list-tail xs (primal i)))
    (define (tensor-storage t) (if (tensor-object? t) (tensor-data t) t))
    (define (tref t i) (vector-ref (tensor-storage t) (primal i)))
    (define (tlen t) (vector-length (tensor-storage t)))
    (define (tmap f . tensors)
      (make-tensor (apply vector-map f (map tensor-storage tensors))))
    (define (list->tensor xs) (make-tensor (list->vector xs)))
    (define (tensor->vector t)
      (if (or (tensor-object? t) (vector? t))
          (vector-map (lambda (x) x) (tensor-storage t))
          (error "tensor->vector: expected a nonscalar tensor" t)))
    (define (tensor? x) (or (scalar? x) (tensor-object? x) (vector? x)))
    (define (build-vector n f)
      (let ((v (make-vector n)))
        (let loop ((i 0))
          (if (= i n) (make-tensor v) (begin (vector-set! v i (f i)) (loop (+ i 1)))))))
    (define (write-tensor t port mode recur)
      (let ((limit (max-tensor-print-length)))
        (if (not (and (exact-integer? limit) (>= limit 0)))
            (error "tensor printer: expected a nonnegative integer limit" limit)
            (begin
              (display "(tensor" port)
              (let loop ((i 0))
                (cond
                  ((= i (tlen t)) (display ")" port))
                  ((and (> limit 0) (= i limit)) (display " ...)" port))
                  (else (display " " port) (recur (tref t i)) (loop (+ i 1)))))))))
    (set-record-type-writer! (dual 0 #f)
                             (lambda (d port mode recur) (recur (primal d))))
    (set-record-type-writer! (make-tensor '#()) write-tensor)
    ;; Validate all children, not merely the first branch of a raw vector.
    (define (shape t)
      (cond
        ((scalar? t) '())
        ((and (or (tensor-object? t) (vector? t)) (> (tlen t) 0))
          (let ((child (shape (tref t 0))))
            (let loop ((i 1))
              (if (= i (tlen t))
                  (cons i child)
                  (if (equal? child (shape (tref t i)))
                      (loop (+ i 1))
                      (error "shape: inconsistent tensor dimensions" t))))))
        (else (error "shape: expected a scalar or nonempty rectangular tensor" t))))
    (define (rank t) (length (shape t)))
    (define (tensor . xs)
      (if (null? xs)
          (error "tensor: tensors cannot be empty")
          (let ((v (list->tensor xs))) (shape v) v)))
    (define (check-shape s)
      (if (not (list? s))
          (error "build-tensor: expected a shape list" s)
          (for-each
            (lambda (n)
              (if (not (and (exact-integer? n) (> n 0)))
                  (error "build-tensor: dimensions must be positive exact integers" s)))
            s)))
    (define (build-tensor s f)
      (check-shape s)
      (let build ((dims s) (indices '()))
        (if (null? dims)
            (f (reverse indices))
            (build-vector (car dims)
                          (lambda (i) (build (cdr dims) (cons i indices)))))))
    (define (size-of s)
      (let loop ((s s) (n 1)) (if (null? s) n (loop (cdr s) (* n (car s))))))
    (define (reshape s t)
      (check-shape s)
      (if (not (= (size-of s) (size-of (shape t))))
          (error "reshape: incompatible element counts" s (shape t))
          (let ((leaves '()))
            (let collect ((t t))
              (if (scalar? t)
                  (set! leaves (cons t leaves))
                  (let loop ((i (- (tlen t) 1)))
                    (if (>= i 0) (begin (collect (tref t i)) (loop (- i 1)))))))
            (build-tensor
              s
              (lambda (idx)
                (let ((leaf (car leaves))) (set! leaves (cdr leaves)) leaf))))))
    (define (trefs t indices)
      (build-vector (length indices) (lambda (i) (tref t (list-ref indices i)))))
    ;; Internal rank traversal assumes the public boundary checked shape once.
    (define (rank-raw t) (if (scalar? t) 0 (+ 1 (rank-raw (tref t 0)))))
    (define (extend1 f n t)
      (if (= n (rank-raw t)) (f t) (tmap (lambda (x) (extend1 f n x)) t)))
    (define (ext1 f n)
      (lambda (t)
        (let ((r (rank t)))
          (if (or (not (exact-integer? n)) (< n 0) (< r n))
              (error "ext1: invalid base rank" n r)
              (extend1 f n t)))))
    (define (extend2 f n t m u)
      (let ((rt (rank-raw t)) (ru (rank-raw u)))
        (cond
          ((and (= n rt) (= m ru)) (f t u))
          ((= n rt) (tmap (lambda (x) (extend2 f n t m x)) u))
          ((= m ru) (tmap (lambda (x) (extend2 f n x m u)) t))
          ((= (tlen t) (tlen u)) (tmap (lambda (x y) (extend2 f n x m y)) t u))
          ((> rt ru) (tmap (lambda (x) (extend2 f n x m u)) t))
          ((> ru rt) (tmap (lambda (x) (extend2 f n t m x)) u))
          (else (error "ext2: incompatible tensor shapes" (shape t) (shape u))))))
    (define (ext2 f n m)
      (lambda (t u)
        (let ((rt (rank t)) (ru (rank u)))
          (if (or (not (exact-integer? n))
                  (not (exact-integer? m))
                  (< n 0)
                  (< m 0)
                  (< rt n)
                  (< ru m))
              (error "ext2: invalid base ranks" n m rt ru)
              (extend2 f n t m u)))))
    (define ext1-primal ext1)
    (define ext2-primal ext2)))
