;; Mathematical spellings remain ordinary library bindings on every execution path.
(import (except (scheme base) + - * / abs max expt)
        (scheme write)
        (malt learner)
        (prefix (malt learner) m:)
        (rename (only (malt learner) λ ∇) (λ fn) (∇ derivative))
        (notation aliases))

(define checks 0)
(define (check actual expected)
  (unless (equal? actual expected)
    (error "Malt notation mismatch" checks actual expected))
  (set! checks (+-primal checks 1)))

(check (eq? ρ primal) #t)
(check (eq? κ backprop) #t)
(check (eq? ∇ gradient) #t)
(check (eq? ∇¹ gradient1) #t)
(define-syntax diagnostic-binding?
  (syntax-rules (check-primal-gradient)
    ((_ check-primal-gradient) #t)
    ((_ other) #f)))
(check (diagnostic-binding? check-ρ-∇) #t)
(check-ρ-∇ (* 2.0 3.0) 6.0 '(3.0 2.0))
(check (eq? ext1-ρ ext1-primal) #t)
(check (eq? ext2-ρ ext2-primal) #t)
(check (eq? +-ρ +-primal) #t)
(check (eq? --ρ --primal) #t)
(check (eq? *-ρ *-primal) #t)
(check (eq? /-ρ /-primal) #t)
(check (eq? exp-ρ exp-primal) #t)
(check (eq? log-ρ log-primal) #t)
(check (eq? expt-ρ expt-primal) #t)
(check (eq? sqrt-ρ sqrt-primal) #t)
(check (eq? sqr-ρ sqr-primal) #t)
(check (eq? zeroes-ρ zeroes-primal) #t)
(check (eq? sum-ρ sum-primal) #t)
(check (eq? abs-ρ abs-primal) #t)
(check (eq? *-2-1-ρ *-2-1-primal) #t)
(check (eq? argmax-ρ argmax-primal) #t)
(check (eq? max-ρ max-primal) #t)
(check (eq? sum-cols-ρ sum-cols-primal) #t)
(check (eq? correlate-ρ correlate-primal) #t)
(check (eq? rectify-ρ rectify-primal) #t)
(check (eq? flatten-ρ flatten-primal) #t)
(check (eq? concat-ρ concat-primal) #t)

(check ((λ (x) x) 7) 7)
(check ((λ args args) 1 2) '(1 2))
(check ((λ (x . xs) xs) 1 2 3) '(2 3))
(check ((λ () 7)) 7)
(check (let ((x 5)) ((λ (y) (+-primal x y)) 2)) 7)
(check (let ((λ (lambda (x) x))) (λ 7)) 7)
(check ((m:λ (x) (let ((y x)) y)) 7) 7)
(check ((fn (x) x) 7) 7)
(check ((function (x) x) 7) 7)
(define-syntax lambda-binding?
  (syntax-rules (lambda)
    ((_ lambda) #t)
    ((_ other) #f)))
(check (lambda-binding? λ) #t)
(check (lambda-binding? m:λ) #t)
(check (lambda-binding? fn) #t)
(check (lambda-binding? function) #t)
(check (let ((λ 7)) (lambda-binding? λ)) #f)
(check (∇ (λ (x) (* x x)) 3.0) 6.0)
(check (m:∇ (m:λ (x) (m:* x x)) 3.0) 6.0)
(check (derivative (fn (x) (* x x)) 3.0) 6.0)
(check ((∇¹ *) 2.0 3.0) '(3.0 2.0))
(check (ρ (* 2.0 3.0)) 6.0)
(check (sum-ρ (tensor 1 2 3)) 6.0)
(check (equal? '(λ ρ κ ∇ ∇¹) '(λ ρ κ ∇ ∇¹)) #t)
(write (list 'malt-notation checks))
(newline)
