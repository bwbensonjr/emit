#lang racket/base
;; Independent fixed-input fixtures for Malt learner 92a3e63.
(require racket/list racket/path racket/vector)
(define source (or (getenv "MALT_SOURCE")
                   (error 'fixtures "set MALT_SOURCE to the pinned Malt checkout")))
(define (binding relative name)
  (parameterize ((current-output-port (current-error-port)))
    (dynamic-require (build-path source relative) name)))
(define (core name) (binding "learner.rkt" name))
(define (train name) (binding "malted.rkt" name))
(define primal (core (string->symbol "\u03c1")))
(define (plain value)
  (cond ((list? value) (map plain value))
        ((vector? value)
         (let ((real (primal value)))
           (if (eq? real value) (vector-map plain value) (plain real))))
        (else value)))
(define tensor (core 'tensor))
(define add (core '+))
(define subtract (core '-))
(define multiply (core '*))
(define square (core 'sqr))
(define gradient (core 'gradient-of))
(define (setting name value)
  ((train (string->symbol (string-append "set-" (symbol->string name) "!"))) value))
(for-each (lambda (p) (setting (car p) (cadr p)))
          '((alpha 0.01) (revs 1) (mu 0.9) (beta 0.999) (batch-size 4)))
(define objective (lambda (theta) (square (subtract 30 (car theta)))))
(define fixed-gradient (lambda (theta) (multiply 3.0 (car theta))))
(define results
  (append
    (list
      (list 'shape ((core 'shape) (tensor (tensor 1 2 3) (tensor 4 5 6))))
      (list 'extend (add 10 (tensor 1 2 3)))
      (list 'gradient-shared (gradient (lambda (x) (add (multiply x x) x)) 3.0))
      (list 'gradient-distinct
            (gradient (lambda (theta) (add (car theta) (multiply 2 (cadr theta))))
                      '(3.0 3.0)))
      (list 'matrix-vector ((core '*-2-1) (tensor (tensor 1 2) (tensor 3 4))
                                          (tensor 5 6)))
      (list 'line (((train 'line) (tensor 1 2 3)) '(2.0 1.0)))
      (list 'quad (((train 'quad) 2.0) '(3.0 2.0 1.0)))
      (list 'linear (((train 'linear) (tensor 2.0 3.0))
                     (list (tensor (tensor 1.0 2.0) (tensor 3.0 4.0))
                           (tensor 1.0 2.0))))
      (list 'l2 ((((train 'l2-loss) (train 'line)) (tensor 1.0 2.0)
                                                            (tensor 2.0 4.0))
                 '(1.0 0.0))))
    (apply append
      (for/list ((name '(naked-gradient-descent velocity-gradient-descent
                       rms-gradient-descent adam-gradient-descent)))
        (for/list ((count '(1 3)))
          (setting 'revs count)
          (list (string->symbol (format "~a-~a" name count))
                ((train name) fixed-gradient '(5.0))))))
    (begin
      (setting 'revs 500)
      (list (list 'quadratic ((train 'naked-gradient-descent) objective '(3.0)))))))
(write (map (lambda (entry) (list (car entry) (plain (cadr entry)))) results))
(newline)
