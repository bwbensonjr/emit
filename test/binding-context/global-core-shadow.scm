(import (prefix (scheme base) b:))
(b:define (if x y z) (b:+ x y z))
(b:define (begin x) (b:+ x 1))
(b:define (quote x) (b:+ x 2))
(b:define (lambda x) (b:+ x 3))
(b:define (apply x) (b:+ x 4))
(b:define (let x) (b:+ x 5))
(b:define (set! x) (b:+ x 6))
(b:define (define-record-type x) (b:+ x 7))
(b:define (define x) (b:+ x 8))
(b:list (if 1 2 3) (begin 1) (quote 1) (lambda 1) (apply 1)
        (let 1) (set! 1) (define-record-type 1) (define 1))
