(import (scheme base) (scheme write) (scheme read) (srfi 27))
(define checks 0)
(define (check name expected actual)
  (if (not (equal? expected actual))
      (error name "SRFI 27 assertion mismatch" expected actual))
  (set! checks (+ checks 1)))
(define (check-true name value) (check name #t (if value #t #f)))
(define (raises? thunk) (guard (ex (else #t)) (thunk) #f))
(define (state s) (cdr (cdr (random-source-state-ref s))))
