(for-each
  (lambda (row)
    (let* ((s (make-random-source)) (pair (list-ref row 0))
           (ri (random-source-make-integers s))
           (rr (random-source-make-reals s)))
      (random-source-pseudo-randomize! s (car pair) (car (cdr pair)))
      (check 'seed-state (list-ref row 1) (state s))
      (let* ((snapshot (random-source-state-ref s))
             (ints (map ri (list-ref row 2)))
             (reals (list (rr) (rr) (rr)))
             (final (random-source-state-ref s)))
        (check 'integers (list-ref row 3) ints)
        (check 'reals (list-ref row 4) reals)
        (check 'final-state (list-ref row 5) (state s))
        (random-source-state-set! s snapshot)
        (check 'integer-replay ints (map ri (list-ref row 2)))
        (check 'real-replay reals (list (rr) (rr) (rr)))
        (check 'mixed-replay final (random-source-state-ref s)))))
  known-answers)

(let* ((a (make-random-source)) (b (make-random-source))
       (ai (random-source-make-integers a))
       (ai2 (random-source-make-integers a))
       (bi (random-source-make-integers b)))
  (check-true 'source-predicate (random-source? a))
  (for-each (lambda (x) (check 'source-predicate-negative #f (random-source? x)))
    (list 0 '#(1 2 3) (lambda () #f) #f))
  (check 'initial-identity (random-source-state-ref a) (random-source-state-ref b))
  (check 'shared-first (bi 100) (ai 100))
  (check 'shared-second (bi 100) (ai2 100))
  (let ((before (random-source-state-ref a)))
    (bi 100)
    (check 'independent-source before (random-source-state-ref a)))
  (let* ((snapshot (random-source-state-ref a))
         (port (open-output-string)))
    (write snapshot port)
    (let* ((text (get-output-string port))
           (decoded (read (open-input-string text)))
           (expected (ai 10000)))
      (random-source-state-set! a decoded)
      (check 'readable-replay expected (ai 10000)))
    (random-source-state-set! a snapshot)
    (let ((before (random-source-state-ref a)))
      (set-car! (cdr (cdr snapshot)) 17)
      (check 'restore-no-alias before (random-source-state-ref a)))))

(let* ((s (make-random-source)) (ri (random-source-make-integers s))
       (before (random-source-state-ref s)))
  (for-each
    (lambda (n)
      (check-true 'invalid-bound (raises? (lambda () (ri n))))
      (check 'invalid-bound-state before (random-source-state-ref s)))
    (list 0 -1 1.0 3.5 'bad #f))
  (for-each
    (lambda (pair)
      (check-true 'invalid-seed
        (raises? (lambda () (random-source-pseudo-randomize! s (car pair) (car (cdr pair))))))
      (check 'invalid-seed-state before (random-source-state-ref s)))
    '((-1 0) (0 -1) (1.0 0) (0 nope)))
  (for-each
    (lambda (datum)
      (check-true 'invalid-snapshot (raises? (lambda () (random-source-state-set! s datum))))
      (check 'invalid-snapshot-state before (random-source-state-ref s)))
    (list #f '(emit-srfi-27 mrg32k3a-v2 1 1 1 1 1 1)
      '(emit-srfi-27 mrg32k3a-v1 0 0 0 1 1 1)
      '(emit-srfi-27 mrg32k3a-v1 1 1 1 0 0 0)
      '(emit-srfi-27 mrg32k3a-v1 4294967087 1 1 1 1 1)
      '(emit-srfi-27 mrg32k3a-v1 1 1 1 1 1 4294944443)
      '(emit-srfi-27 mrg32k3a-v1 1 1 1 1.0 1 1)
      '(emit-srfi-27 mrg32k3a-v1 -1 1 1 1 1 1)
      '(emit-srfi-27 mrg32k3a-v1 1 1 1 1 1 1 1)))
  (for-each
    (lambda (unit)
      (check-true 'invalid-unit (raises? (lambda () (random-source-make-reals s unit))))
      (check 'invalid-unit-state before (random-source-state-ref s)))
    (list 0 0.0 1.0 -0.1 1e-17 'bad (/ 0.0 0.0) (/ 1.0 0.0)))
  (check-true 'unit-extra-argument (raises? (lambda () (random-source-make-reals s 0.1 0.2)))))

(for-each
  (lambda (call)
    (check-true 'invalid-source (raises? call)))
  (list (lambda () (random-source-state-ref '#()))
        (lambda () (random-source-state-set! #f '()))
        (lambda () (random-source-pseudo-randomize! 1 0 0))
        (lambda () (random-source-randomize! "bad"))
        (lambda () (random-source-make-integers 'bad))
        (lambda () (random-source-make-reals #f))))

;; The initial raw output 3682515679 exceeds the 30-bit chunk cutoff
;; 3221225472. The next raw output is 1235431594, yielding 411810531.
(let* ((s (make-random-source)) (ri (random-source-make-integers s)))
  (check 'chunk-rejection 411810531 (ri 1073741824))
  (check 'chunk-rejection-state
    '(1724298998 340793741 1062452522 488867404 953245149 2854655037)
    (state s)))
;; Bound three uses two bits; candidate three is rejected before one.
(let* ((s (make-random-source)) (ri (random-source-make-integers s)))
  (check 'candidate-rejection 1 (ri 3)))

(let ((s (make-random-source)))
  (for-each
    (lambda (bound)
      (let ((ri (random-source-make-integers s)))
        (let loop ((i 0))
          (if (< i 200)
              (let ((x (ri bound)))
                (check-true 'integer-range (and (exact? x) (<= 0 x) (< x bound)))
                (loop (+ i 1)))))))
    '(1 3 10 4294967297 1152921504606846975))
  (for-each
    (lambda (rr)
      (let loop ((i 0))
        (if (< i 200)
            (let ((x (rr)))
              (check-true 'real-range (and (inexact? x) (< 0.0 x 1.0)))
              (loop (+ i 1))))))
    (list (random-source-make-reals s)
          (random-source-make-reals s 0.5)
          (random-source-make-reals s 1.1102230246251565e-16)))
  (let ((before (random-source-state-ref default-random-source)))
    (random-source-randomize! s)
    (check-true 'randomized-source (random-source? s))
    (check 'randomize-isolation before (random-source-state-ref default-random-source))))

(list 'srfi-27-complete checks)
