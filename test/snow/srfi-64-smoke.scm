;;; Compile and exercise the SRFI 64 port independently of its default reporter.
(import (scheme base) (scheme write) (srfi 64))

(define runner (test-runner-null))
(define (run-counts thunk)
  (let ((r (test-runner-null)))
    (test-with-runner r (thunk))
    (list (test-runner-pass-count r) (test-runner-fail-count r)
          (test-runner-xpass-count r) (test-runner-xfail-count r)
          (test-runner-skip-count r))))
(test-runner-current runner)
(test-begin "emit-srfi-64")
(test-equal 3 (+ 1 2))
(test-approximate 1.0 1.125 0.125)
(test-error (error "intentional"))
(test-error (test-read-eval-string "(+ 1 2)"))
(test-equal '(1 1 0 0 0)
  (run-counts (lambda ()
    (test-approximate 1.0 1.125 0.125)
    (test-approximate 1.0 1.25 0.125))))
(test-equal '(1 1 0 0 0)
  (run-counts (lambda ()
    (test-approximate 7 7 0)
    (test-approximate 7 8 0))))
(test-equal '(0 0 1 1 1)
  (run-counts (lambda ()
    (test-skip 1)
    (test-assert (error "skipped expression must not run"))
    (test-expect-fail 2)
    (test-assert #f)
    (test-assert #t))))
(test-equal "test-read-eval-string: string evaluation unsupported; missing (scheme eval)"
  (guard (e (else (error-object-message e)))
    (test-read-eval-string "(+ 1 2)")))
(test-end "emit-srfi-64")
(write (list (test-runner-pass-count runner)
             (test-runner-fail-count runner)))
(newline)
