;; Learner tensor/AD acceptance, derived from Malt's learner tests at 92a3e63.
;; Additional numeric checks use independent analytic/finite-difference answers.
(import (scheme base) (scheme inexact)
        (malt learner tensors) (malt learner autodiff)
        (malt learner diagnostics)
        (prefix (malt learner operations) m:))

(define checks 0)
(define (check actual expected)
  (guard (e (else
              (write (list 'failed-check (+ checks 1) (map* primal actual) expected)
                     (current-error-port))
              (newline (current-error-port))
              (raise e)))
    (parameterize ((tolerance 1e-9)) (check-dual-equal? actual expected)))
  (set! checks (+ checks 1)))
(define (fails thunk)
  (guard (e (else #t)) (thunk) #f))
(define (total x)
  (cond ((scalar? x) (primal x))
        ((vector? x)
         (let loop ((i 0) (sum 0.0))
           (if (= i (vector-length x)) sum
               (loop (+ i 1) (+ sum (total (vector-ref x i)))))))
        ((null? x) 0.0)
        (else (+ (total (car x)) (total (cdr x))))))
(define (numerical f x)
  (let ((h 1e-5))
    (/ (- (total (f (+ x h))) (total (f (- x h)))) (* 2.0 h))))
(define (finite-check f x)
  (parameterize ((tolerance 1e-6))
    (check-dual-equal? (gradient f x) (numerical f x)))
  (set! checks (+ checks 1)))

(check (scalar? 3) #t)
(check (dual? '#()) #f)
(check (tensor? (vector 'ordinary)) #t)
(check (list->tensor '((1 2) (3 4))) '#((1 2) (3 4)))
(check (shape (tensor (tensor 1 2 3) (tensor 4 5 6))) '(2 3))
(check (rank 4.0) 0)
(check (build-tensor '() (lambda (idx) (if (null? idx) 17 99))) 17)
(check (build-tensor '(2 2) (lambda (idx) (+ (* 10 (car idx)) (car (cdr idx))))) '#(#(0 1) #(10 11)))
(check (fails (lambda () (tensor))) #t)
(check (fails (lambda () (tensor 1 'bad))) #t)
(check (fails (lambda () (tensor (vector 1 2) (vector 3)))) #t)
(check (fails (lambda () (shape (vector (vector 1) (vector 2 3))))) #t)
(check (fails (lambda () (build-tensor '(0) (lambda (idx) 0)))) #t)
(check (fails (lambda () (build-tensor '(-1) (lambda (idx) 0)))) #t)
(check (fails (lambda () (build-tensor '(2.0) (lambda (idx) 0)))) #t)
(check (reshape '(3 2) '#(#(1 2 3) #(4 5 6))) '#(#(1 2) #(3 4) #(5 6)))
(check (reshape '() '#(7)) 7)
(check (fails (lambda () (reshape '(2 2) '#(1 2 3)))) #t)
(check (trefs '#(10 20 30) '(2 0 2)) '#(30 10 30))
(let ((node (dual* 3.0)))
  (check (eq? node (tref (reshape '(1) node) 0)) #t))
(check (map* primal (m:+ 10 '#(1 2 3))) '#(11 12 13))
(check (fails (lambda () (m:+ '#(1) '#(1 2 3)))) #t)
(check (fails (lambda () ((ext1 (lambda (x) x) 2) '#(1 2)))) #t)
(check ((ext2 + 0 0) '#(#(1 2) #(3 4)) '#(10 20)) '#(#(11 12) #(23 24)))
(check (gradient (lambda (x) (m:+ (m:* x x) x)) 3.0) 7.0)
(check ((gradient1 (lambda (x y) (m:+ x (m:* 2 y)))) 3.0 3.0) '(1.0 2.0))
(check (gradient (lambda (xs) (m:* (car xs) (car xs))) '(3.0 7.0)) '(6.0 0.0))
(check (gradient (lambda (x) (list (m:* x x) (vector (m:* x x)))) 3.0) 12.0)
(check (gradient (lambda (x) (m:+ x (gradient (lambda (y) (m:* y y)) 4.0))) 3.0) 1.0)
(check (gradient (lambda (x) (m:* x x)) 3.0) 6.0)
(check (gradient (lambda (x) (m:* x x)) 3.0) 6.0)
(check (gradient (lambda (x) (m:sum (reshape '(2 2) x))) '#(1 2 3 4)) '#(1.0 1.0 1.0 1.0))
(check (gradient (prim1 (lambda (x) (* x x)) (lambda (x z) (* 2 x z))) 3.0) 6.0)
(check ((gradient1 (prim2 + (lambda (a b z) (values z z)))) 2.0 3.0) '(1.0 1.0))
(for-each (lambda (f) (finite-check f 1.7))
  (list m:sqr m:exp m:log m:sqrt m:abs
        (lambda (x) (m:/ 2.0 x))
        (lambda (x) (m:expt x 2.3))
        (lambda (x) (m:sum (m:* '#(2.0 3.0 4.0) x)))
        (lambda (x) (m:sum (m:*-2-1 '#(#(1.0 2.0) #(3.0 4.0)) (m:* '#(2.0 3.0) x))))))
(check (map* primal (m:sum '#(#(1 2) #(3 4)))) '#(3 7))
(check (map* primal (m:sum-cols '#(#(1 2) #(3 4)))) '#(4 6))
(check (map* primal (m:*-2-1 '#(#(1 2) #(3 4)) '#(2 3))) '#(#(2 6) #(6 12)))
(check (gradient m:rectify 0.0) 1.0)
(check (gradient m:rectify -1.0) 0.0)
(check (gradient m:abs 0.0) 1.0)
(check (m:argmax '#(5 5)) 1)
(check (gradient m:max '#(5.0 5.0)) '#(0.0 1.0))
(check (gradient m:argmax '#(5.0 5.0)) '#(0.0 0.0))
(check (m:flatten '#(#(1 2) #(3 4))) '#(1 2 3 4))
(check (m:concat '#(#(1 2) #(3 4)) '#(5 6 7)) '#(#(1 2 5 6 7) #(3 4 5 6 7)))
(check ((m:concat-n 2) '#(#(1 2) #(3 4)) '#(#(5 6))) '#(#(1 2) #(3 4) #(5 6)))
(check (fails (lambda () ((m:concat-n 2) '#(#(1 2)) '#(#(1 2 3))))) #t)
(check (m:=-0-0 (dual* 3) 3) #t)
(check (m:>-0-0 (dual* 3) 2) #t)
(check (m:>=-0-0 3 3) #t)
(check (m:<-0-0 2 3) #t)
(check (m:<=-0-0 3 3) #t)
(check (m:=-1 '#(1 2) '#(1 3)) '#(1.0 0.0))
(check (m:!=-1 '#(1 2) '#(1 3)) '#(0.0 1.0))
(check (m:<-1 '#(1 4) '#(2 3)) '#(1.0 0.0))
(check (m:>-1 '#(1 4) '#(2 3)) '#(0.0 1.0))
(check (m:<=-1 '#(1 4) '#(1 3)) '#(1.0 0.0))
(check (m:>=-1 '#(1 4) '#(1 5)) '#(1.0 0.0))
(define signal '#(#(1.0) #(2.0) #(3.0)))
(define bank '#(#(#(1.0) #(2.0) #(3.0))))
(check (map* primal (m:correlate bank signal)) '#(#(8.0) #(14.0) #(8.0)))
(check ((gradient1 m:correlate) bank signal)
       '(#(#(#(3.0) #(6.0) #(5.0))) #(#(3.0) #(6.0) #(5.0))))
(finite-check (lambda (x) (m:correlate bank (m:* signal x))) 1.7)
(check (m:correlate-primal bank signal) '#(#(8.0) #(14.0) #(8.0)))
(check (m:+-primal '#(1 2) 3) '#(4 5))
(check (m:--primal '#(1 2) 3) '#(-2 -1))
(check (m:*-primal '#(1 2) 3) '#(3 6))
(check (m:/-primal '#(2 4) 2) '#(1 2))
(check (m:exp-primal 0) 1.0)
(check (m:log-primal 1) 0.0)
(check (m:expt-primal '#(2 3) 2) '#(4 9))
(check (m:sqrt-primal '#(4 9)) '#(2.0 3.0))
(check (m:sqr-primal '#(2 3)) '#(4 9))
(check (m:zeroes-primal '#(2 3)) '#(0.0 0.0))
(check (m:sum-primal '#(2 3)) 5.0)
(check (m:sum-cols-primal '#(#(1 2) #(3 4))) '#(4 6))
(check (m:abs-primal '#(-2 3)) '#(2 3))
(check (m:*-2-1-primal '#(#(1 2) #(3 4)) '#(2 3)) '#(#(2 4) #(9 12)))
(check (m:argmax-primal '#(2 3)) 1)
(check (m:max-primal '#(2 3)) 3)
(check (m:rectify-primal '#(-2 3)) '#(0.0 3))
(check (m:flatten-primal '#(#(1 2) #(3 4))) '#(1 2 3 4))
(check (m:concat-primal '#(1 2) '#(3)) '#(1 2 3))
(check (make-printable '#(1 2 3) 2) '(tensor 1 2 ...))
(check (make-printable '#(#(1 2) #(3 4)) 0) '(tensor (tensor 1 2) (tensor 3 4)))
(check (fails (lambda () (check-dual-equal? 1 2))) #t)
(check-primal-gradient (m:* 2.0 3.0) 6.0 '(3.0 2.0))
(set! checks (+ checks 1))
(let ((p (open-output-string)))
  (trace-print '#(1 2) p)
  (check (get-output-string p) "(tensor 1 2)\n"))
(write (list 'malt-core-complete checks))
(newline)
