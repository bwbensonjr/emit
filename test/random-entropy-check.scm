(import (scheme base))
(define entropy (%random-entropy 24))
(unless (and (bytevector? entropy) (= (bytevector-length entropy) 24))
  (error "host entropy provider did not return 24 bytes"))
(unless (and (not (%random-entropy 0))
             (not (%random-entropy -1))
             (not (%random-entropy 257)))
  (error "invalid entropy request was accepted"))
(unless (guard (condition (else #t)) (%random-entropy "bad") #f)
  (error "invalid entropy type was accepted"))
(display "entropy runtime: 3 checks passed\n")
