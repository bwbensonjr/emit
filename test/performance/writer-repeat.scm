;;; End-to-end Scheme closure/adapter control. Build first; time execution only.
(import (scheme base) (scheme write) (scheme file) (scheme process-context) (emit write))
(define-record-type <parcel> (parcel child) parcel? (child parcel-child))
(set-record-type-writer! (parcel 0)
  (lambda (object port mode recur)
    (display "<" port)
    (recur (parcel-child object))
    (display ">" port)))
(define arguments (cdr (command-line)))
(define iterations
  (if (pair? arguments) (string->number (car arguments)) 100000))
(define kind
  (if (and (pair? arguments) (pair? (cdr arguments))) (cadr arguments) "flat"))
(if (not (and (integer? iterations) (> iterations 0)))
    (error "writer-repeat: expected positive iteration count"))
(if (not (or (equal? kind "flat") (equal? kind "nested")))
    (error "writer-repeat: expected flat or nested"))
(define value
  (if (equal? kind "flat") (parcel 42) (parcel (parcel (parcel 42)))))
(define oracle (if (equal? kind "flat") "<42>" "<<<42>>>"))
(define check-port (open-output-string))
(write value check-port)
(if (not (equal? (get-output-string check-port) oracle))
    (error "writer-repeat: output oracle mismatch"))
(define destination (open-output-file "/dev/null"))
(let loop ((left iterations))
  (if (> left 0)
      (begin (write value destination) (loop (- left 1)))))
(close-output-port destination)
(display "writer-repeat-complete")
(newline)
