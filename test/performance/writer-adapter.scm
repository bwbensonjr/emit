;;; Actual Scheme adapter and borrowed-port control; construction precedes writes.
(import (scheme base) (scheme write) (emit write))
(define-record-type <parcel> (parcel child) parcel? (child parcel-child))
(set-record-type-writer! (parcel 0)
  (lambda (object port mode recur)
    (display "<" port)
    (recur (parcel-child object))
    (display ">" port)))
(define flat (parcel '(1 2 3 4)))
(define nested (parcel (parcel 42)))
(define out (open-output-string))
(write flat out)
(write nested out)
(if (not (equal? (get-output-string out) "<(1 2 3 4)><<42>>"))
    (error "writer adapter fixture: wrong explicit output"))
(list 'adapter flat nested)
